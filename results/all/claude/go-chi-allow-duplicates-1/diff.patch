 }
+
+// addMethodAllowed records m for the 405 Allow header unless already recorded.
+func (x *Context) addMethodAllowed(m methodTyp) {
+	for _, have := range x.methodsAllowed {
+		if have == m {
+			return
+		}
+	}
+	x.methodsAllowed = append(x.methodsAllowed, m)
+}
