@@ -124,6 +127,61 @@ class Requirement:
         if self.marker:
             yield f"; {self.marker}"
 
+    def __replace__(
+        self,
+        *,
+        name: str = _UNSET,
+        url: str | None = _UNSET,
+        extras: Iterable[str] = _UNSET,
+        specifier: SpecifierSet = _UNSET,
+        marker: Marker | None = _UNSET,
+    ) -> Self:
+        """
+        __replace__(*, name=..., url=..., extras=..., specifier=..., marker=...)
+
+        Return a new requirement with parts replaced.
+
+        The result is validated and normalized as if its string form had been
+        parsed. The ``specifier`` is copied, keeping its ``prereleases``
+        settings, so nothing is shared with the original or the argument.
+
+        >>> r = Requirement('requests[security]>=2.0')
+        >>> r.__replace__(name="flask")
+        <Requirement('flask[security]>=2.0')>
+
+        :param str name:
+        :param str | None url:
+        :param Iterable[str] extras:
+        :param SpecifierSet specifier:
+        :param Marker | None marker:
+        :raises InvalidRequirement: If the resulting requirement is not valid,
+            or a value would be read back as something different.
+
+        .. versionadded:: 26.4
+        """
+        candidate = Requirement.__new__(Requirement)
+        candidate.name = self.name if name is _UNSET else name
+        candidate.url = (self.url if url is _UNSET else url) or None
+        candidate.extras = set(self.extras if extras is _UNSET else extras)
+        new_specifier = self.specifier if specifier is _UNSET else specifier
+        candidate.specifier = new_specifier
+        candidate.marker = self.marker if marker is _UNSET else marker
+
+        result = self.__class__("".join(candidate._iter_parts(candidate.name)))
+        if (
+            result.name != candidate.name
+            or result.url != candidate.url
+            or result.extras != candidate.extras
+        ):
+            raise InvalidRequirement(
+                f"Replacement values do not round-trip: {str(result)!r}"
+            )
+        result.specifier = SpecifierSet(
+            [Specifier(str(s), s._prereleases) for s in new_specifier._specs],
+            new_specifier._prereleases,
+        )
+        return result
+
     def __getstate__(self) -> tuple[str, bool | None]:
