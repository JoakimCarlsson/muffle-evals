+    def can_end(self) -> bool:
+        """Whether the tokens fed so far form a complete parse. Doesn't change the state."""
+        states = self.parse_conf.states
+        end_state = self.parse_conf.end_state
+        state_stack = self.state_stack
+        depth = len(state_stack)
+        pushed: List[StateT] = []
+        while True:
+            try:
+                _action, rule = states[pushed[-1] if pushed else state_stack[depth - 1]]['$END']
+            except KeyError:
+                return False
+            size = len(rule.expansion)
+            from_pushed = min(size, len(pushed))
+            if from_pushed:
+                del pushed[-from_pushed:]
+            depth -= size - from_pushed
+            _action, new_state = states[pushed[-1] if pushed else state_stack[depth - 1]][rule.origin.name]
+            if new_state == end_state:
+                return True
+            pushed.append(new_state)
