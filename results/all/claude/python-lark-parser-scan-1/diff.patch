+    def scan(self, text: TextOrSlice, start: Optional[str]=None) -> 'Iterator[ScanMatch[_Return_T]]':
+        """Find grammar matches inside the text, like a regexp search.
+
+        Yields non-overlapping matches in order. Each match is the longest prefix that parses,
+        from the earliest position where one starts. Text that doesn't parse is skipped.
+        A match is never empty, and never starts or ends with an ignored terminal.
+
+        Lexer callbacks and the transformer may be called for text that doesn't end up matching.
+        A lexer callback may raise ValueError to reject a token.
+
+        Parameters:
+            text (str, bytes or TextSlice): Text to scan. With a TextSlice, only the slice is scanned,
+                and positions are relative to the whole text.
+            start (str, optional): Required if Lark was given multiple possible start symbols.
+
+        Returns:
+            An iterator of ``ScanMatch(range, value)``, where value is what ``parse()`` returns for the match.
+
+        :raises ConfigurationError: (when called) If not parser='lalr', or with postlex or a custom lexer.
+        """
+        if self.options.parser != 'lalr':
+            raise ConfigurationError("scan() only works with parser='lalr'")
+        if self.options.postlex is not None:
+            raise ConfigurationError("scan() doesn't support postlex")
+        if isinstance(self.options.lexer, type):
+            raise ConfigurationError("scan() doesn't support a custom lexer")
+        return self.parser.scan(text, start=start)
+
 
 ###}
