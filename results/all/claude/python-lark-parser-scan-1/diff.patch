+class TestScan(unittest.TestCase):
+    GRAMMAR = r"""
+        start: expr+
+        expr: "(" (NAME | expr)* ")"
+        NAME: /[a-z]+/
+        %ignore " "
+    """
+
+    def test_ranges(self):
+        for lexer in ('contextual', 'basic'):
+            p = Lark(self.GRAMMAR, parser='lalr', lexer=lexer)
+            self.assertEqual([m.range for m in p.scan('(a)(b) || (c)(d(e)')], [(0, 6), (10, 13), (15, 18)])
+
+    def test_value_equals_parse(self):
+        p = Lark(self.GRAMMAR, parser='lalr', propagate_positions=True, keep_all_tokens=True, maybe_placeholders=True)
+        m ,= p.scan("xx\n (a b)  zz")
+        self.assertEqual(m.range, (4, 9))
+        self.assertEqual(m.value, p.parse("(a b)"))
+        self.assertEqual((m.value.meta.line, m.value.meta.column, m.value.meta.end_pos), (2, 2, 9))
+        self.assertEqual(ScanMatch((1, 3), Tree('expr', [])), ScanMatch((1, 3), Tree('expr', [])))
+
+    def test_slice_and_bytes(self):
+        p = Lark(self.GRAMMAR, parser='lalr')
+        self.assertEqual([m.range for m in p.scan(TextSlice("(a)(b)(c)", 3, 9))], [(3, 9)])
+        pb = Lark(self.GRAMMAR, parser='lalr', use_bytes=True)
+        self.assertEqual([m.range for m in pb.scan(b"(a)(b)")], [(0, 6)])
+
+    def test_nullable_and_ignore(self):
