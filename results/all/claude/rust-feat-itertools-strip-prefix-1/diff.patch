 }
+
+#[test]
+fn strip_prefix_matches_str() {
+    for (s, p) in [("hello", "he"), ("hello", ""), ("he", "hello"), ("hello", "hx")] {
+        let got = s.chars().strip_prefix(p.chars()).map(|i| i.collect::<String>());
+        assert_eq!(got.ok().as_deref(), s.strip_prefix(p));
+    }
+}
