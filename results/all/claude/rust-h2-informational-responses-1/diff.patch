+    pub fn poll_informational(
+        &mut self,
+        cx: &mut Context<'_>,
+    ) -> Poll<Option<Result<Response<()>, crate::Error>>> {
+        self.inner
+            .poll_informational(cx)
+            .map(|o| o.map(|r| r.map_err(Into::into)))
+    }
