+    /// Queue an informational HEADERS frame without changing the stream state
+    pub fn send_informational<B>(
+        &mut self,
+        frame: frame::Headers,
+        buffer: &mut Buffer<Frame<B>>,
+        stream: &mut store::Ptr,
+        task: &mut Option<Waker>,
+    ) -> Result<(), UserError> {
+        if !frame.is_informational() || frame.is_end_stream() {
+            return Err(UserError::InvalidInformationalStatusCode);
+        }
+
+        Self::check_headers(frame.fields())?;
+
+        if stream.state.is_send_closed() || stream.state.is_send_streaming() {
+            return Err(UserError::UnexpectedFrameType);
+        }
+
+        self.prioritize
+            .queue_frame(frame.into(), buffer, stream, task);
+
+        Ok(())
+    }
