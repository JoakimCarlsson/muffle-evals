+  // Defaults apply only after aliases resolve, so an aliased CLI value wins
+  for (const [key, value] of Object.entries(defaults)) {
+    if ((out as any)[key] === undefined) {
+      (out as any)[key] = value;
     }
   }
+  propagateAliases();
 
