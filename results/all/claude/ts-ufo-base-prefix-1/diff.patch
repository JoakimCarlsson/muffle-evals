+/**
+ * Checks that input equals base or continues it at a path, query or hash boundary.
+ */
+function isUnderBase(input: string, base: string) {
+  return (
+    input.startsWith(base) && (!input[base.length] || "/?#".includes(input[base.length]))
+  );
