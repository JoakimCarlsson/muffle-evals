+  return visit(schema, {
+    object: (s) => util.partial(ZodMiniOptional, s, undefined),
+    union: (s: core.$ZodUnion) =>
+      "discriminator" in s._zod.def ? union(s._zod.def.options as core.$ZodType[]) : s,
+  }) as any;
+}
