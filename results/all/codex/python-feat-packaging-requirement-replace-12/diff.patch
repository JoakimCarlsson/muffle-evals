diff --git a/CHANGELOG.rst b/CHANGELOG.rst
index e9bb15a..9854f0b 100644
--- a/CHANGELOG.rst
+++ b/CHANGELOG.rst
@@ -4,6 +4,11 @@ Changelog
 *unreleased*
 ~~~~~~~~~~~~
 
+Features:
+
+* Add ``Requirement.__replace__`` to create validated copies with selected
+  fields changed, including support for ``copy.replace`` on Python 3.13+.
+
 Removals:
 
 * Drop support for EOL Python 3.9. (:pull:`1263`)
diff --git a/docs/requirements.rst b/docs/requirements.rst
index fede671..de6eba4 100644
--- a/docs/requirements.rst
+++ b/docs/requirements.rst
@@ -60,6 +60,17 @@ Usage
     >>> requirements2 = {Requirement("pip"), Requirement("packaging")}
     >>> requirements1 == requirements2
     True
+    >>> # Create a new requirement with selected fields changed:
+    >>> req.__replace__(name="other", extras={"test"})
+    <Requirement('other[test]<3,>=2; python_version > "2.0"')>
+
+``Requirement.__replace__`` accepts the keyword arguments ``name``, ``url``,
+``extras``, ``specifier`` and ``marker``. Unspecified fields are preserved;
+the original requirement is unchanged. Values are validated and normalized
+as when parsing a requirement. Invalid values raise ``InvalidRequirement``;
+unknown keywords raise ``TypeError``. Specifier sets and their specifiers are
+copied, preserving prerelease settings. Subclasses retain their type and run
+their initializer. On Python 3.13 and later, :func:`copy.replace` can also be used.
 
 .. versionchanged:: 23.2
 
diff --git a/src/packaging/requirements.py b/src/packaging/requirements.py
index 124de66..3b14b8e 100644
--- a/src/packaging/requirements.py
+++ b/src/packaging/requirements.py
@@ -3,17 +3,21 @@
 # for complete details.
 from __future__ import annotations
 
-from typing import TYPE_CHECKING
+from typing import TYPE_CHECKING, Any
 
 from ._parser import parse_requirement as _parse_requirement
 from ._tokenizer import ParserSyntaxError
 from .markers import Marker, _normalize_extra_values
-from .specifiers import InvalidSpecifier, SpecifierSet
+from .specifiers import InvalidSpecifier, Specifier, SpecifierSet
 from .utils import canonicalize_name
 
 if TYPE_CHECKING:
     from collections.abc import Iterator
 
+    from typing_extensions import Self
+
+_UNSET: Any = object()
+
 __all__ = [
     "InvalidRequirement",
     "Requirement",
@@ -106,6 +110,65 @@ class Requirement:
             self.marker = Marker.__new__(Marker)
             self.marker._markers = _normalize_extra_values(parsed.marker)
 
+    def __replace__(
+        self,
+        *,
+        name: str = _UNSET,
+        url: str | None = _UNSET,
+        extras: set[str] = _UNSET,
+        specifier: SpecifierSet = _UNSET,
+        marker: Marker | None = _UNSET,
+    ) -> Self:
+        """Return a new requirement with the given fields replaced.
+
+        Unspecified fields are preserved. Values are validated and normalized
+        by parsing; invalid values raise :exc:`InvalidRequirement`.
+        Specifiers are copied, including their prerelease settings.
+
+        Supports :func:`copy.replace` on Python 3.13 and later, or can be
+        called directly on older Python versions.
+
+        .. versionadded:: 26.4
+        """
+        candidate = Requirement.__new__(Requirement)
+        candidate.name = self.name if name is _UNSET else name
+        candidate.url = self.url if url is _UNSET else url
+        candidate.extras = self.extras if extras is _UNSET else extras
+        candidate.specifier = self.specifier if specifier is _UNSET else specifier
+        candidate.marker = self.marker if marker is _UNSET else marker
+        if not all(
+            (
+                isinstance(candidate.name, str),
+                candidate.url is None or isinstance(candidate.url, str),
+                isinstance(candidate.extras, set),
+                isinstance(candidate.specifier, SpecifierSet),
+                candidate.marker is None or isinstance(candidate.marker, Marker),
+            )
+        ) or not all(isinstance(extra, str) for extra in candidate.extras):
+            raise InvalidRequirement("Invalid replacement field type")
+
+        candidate.specifier = SpecifierSet(
+            (
+                Specifier(str(spec), prereleases=spec._prereleases)
+                for spec in candidate.specifier
+            ),
+            prereleases=candidate.specifier._prereleases,
+        )
+        parsed = Requirement(str(candidate))
+        if (
+            parsed.name != candidate.name
+            or parsed.url != candidate.url
+            or parsed.extras != candidate.extras
+            or str(parsed.specifier) != str(candidate.specifier)
+            or parsed.marker
+            != (Marker(str(candidate.marker)) if candidate.marker is not None else None)
+        ):
+            raise InvalidRequirement("Replacement fields do not round-trip")
+
+        result = self.__class__(str(parsed))
+        result.specifier = candidate.specifier
+        return result
+
     def _iter_parts(self, name: str) -> Iterator[str]:
         yield name
 
diff --git a/tests/test_requirements.py b/tests/test_requirements.py
