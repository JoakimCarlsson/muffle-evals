diff --git a/tests/test_requirements.py b/tests/test_requirements.py
index ad78c2b..93bdee5 100644
--- a/tests/test_requirements.py
+++ b/tests/test_requirements.py
@@ -4,7 +4,9 @@
 
 from __future__ import annotations
 
+import copy
 import pickle
+import sys
 
 import pytest
 
@@ -1085,3 +1087,78 @@ def test_pickle_requirement_25_0_format_loads() -> None:
     assert str(r.specifier) == ">=2.0"
     assert r.marker is None
     assert r == Requirement("requests>=2.0")
+
+
+@pytest.mark.parametrize("prereleases", [None, False, True])
+@pytest.mark.parametrize("replace_specifier", [False, True])
+def test_replace(prereleases: bool | None, replace_specifier: bool) -> None:
+    class CustomRequirement(Requirement):
+        def __init__(self, requirement_string: str) -> None:
+            super().__init__(requirement_string)
+            self.initialized = True
+
+    original = CustomRequirement('requests[security]>=2.0; python_version >= "3"')
+    specifier = SpecifierSet(">=3.0,!=4.0", prereleases=prereleases)
+    for index, spec in enumerate(specifier):
+        spec.prereleases = bool(index)
+    if not replace_specifier:
+        original.specifier = specifier
+    changes = {"specifier": specifier} if replace_specifier else {}
+    result = original.__replace__(**changes)
+    assert isinstance(result, CustomRequirement)
+    assert result.initialized
+    assert result is not original
+    assert result.specifier is not specifier
+    assert result.specifier._prereleases is prereleases
+    for old, new in zip(specifier, result.specifier, strict=True):
+        assert old is not new
+        assert str(old) == str(new)
+        assert old._prereleases is new._prereleases
+        new.prereleases = not old.prereleases
+        assert old.prereleases != new.prereleases
+    assert result.extras is not original.extras
+    assert result.marker is not original.marker
+    assert original.__replace__() == original
+    assert str(original.__replace__(name="flask")).startswith("flask[security]")
+    assert original.name == "requests"
+    assert original.__replace__(extras=set(), marker=None).extras == set()
+    assert original.__replace__(marker=None).marker is None
+    url = original.__replace__(specifier=SpecifierSet(), url="https://example.com")
+    assert url.url == "https://example.com"
+    assert url.__replace__(url=None).url is None
+    normalized = original.__replace__(marker=Marker('extra == "Foo_Bar"'))
+    assert str(normalized.marker) == 'extra == "foo-bar"'
+    assert Requirement(str(normalized)) == normalized
+    if sys.version_info >= (3, 13):
+        assert copy.replace(original, name="flask") == original.__replace__(
+            name="flask"
+        )
+
+
+@pytest.mark.parametrize(
+    "changes",
+    [
+        {"name": "not a name!"},
+        {"name": "foo[bar]"},
+        {"name": "foo ", "extras": set()},
+        {"extras": {"a,b"}},
+        {"extras": {""}},
+        {"url": ""},
+        {"url": "https://example.com ; os_name == 'posix'"},
+        {"url": "https://example.com", "specifier": SpecifierSet(">=1")},
+        {"name": None},
+        {"extras": {1}},
+        {"specifier": ">=1"},
+        {"marker": "os_name == 'posix'"},
+    ],
+)
+def test_replace_invalid(changes: dict[str, object]) -> None:
+    with pytest.raises(InvalidRequirement):
+        Requirement("foo").__replace__(**changes)
+
+
+def test_replace_arguments() -> None:
+    with pytest.raises(TypeError):
+        Requirement("foo").__replace__(unknown="bar")
+    with pytest.raises(TypeError):
+        Requirement("foo").__replace__("bar")  # type: ignore[call-arg]
