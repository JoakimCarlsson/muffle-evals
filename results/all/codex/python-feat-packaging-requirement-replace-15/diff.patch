 # for complete details.
 from __future__ import annotations
 
-from typing import TYPE_CHECKING
+from typing import TYPE_CHECKING, Any
 
 from ._parser import parse_requirement as _parse_requirement
 from ._tokenizer import ParserSyntaxError
 from .markers import Marker, _normalize_extra_values
-from .specifiers import InvalidSpecifier, SpecifierSet
+from .specifiers import InvalidSpecifier, Specifier, SpecifierSet
 from .utils import canonicalize_name
 
 if TYPE_CHECKING:
     from collections.abc import Iterator
 
+    from typing_extensions import Self
+
+_UNSET: Any = object()
+
 __all__ = [
     "InvalidRequirement",
     "Requirement",
@@ -106,6 +110,65 @@ class Requirement:
             self.marker = Marker.__new__(Marker)
             self.marker._markers = _normalize_extra_values(parsed.marker)
 
+    def __replace__(
+        self,
+        *,
+        name: str = _UNSET,
+        url: str | None = _UNSET,
+        extras: set[str] = _UNSET,
+        specifier: SpecifierSet = _UNSET,
+        marker: Marker | None = _UNSET,
+    ) -> Self:
+        """Return a new requirement with the given fields replaced.
+
+        Unspecified fields are kept. Values are validated and normalized as
+        when parsing a requirement string. Invalid values, including values
+        that would change other fields when parsed, raise InvalidRequirement.
+        Specifiers are copied, preserving their prerelease settings.
+
+        Supports :func:`copy.replace` on Python 3.13 and later.
+
+        .. versionadded:: 26.4
+        """
+        candidate = Requirement.__new__(Requirement)
+        candidate.name = self.name if name is _UNSET else name
+        candidate.url = self.url if url is _UNSET else url
+        candidate.extras = self.extras if extras is _UNSET else extras
+        candidate.specifier = self.specifier if specifier is _UNSET else specifier
+        candidate.marker = self.marker if marker is _UNSET else marker
+        if not all(
+            (
+                isinstance(candidate.name, str),
+                candidate.url is None or isinstance(candidate.url, str),
+                isinstance(candidate.extras, set),
+                isinstance(candidate.specifier, SpecifierSet),
+                candidate.marker is None or isinstance(candidate.marker, Marker),
+            )
+        ):
+            raise InvalidRequirement("Invalid replacement field type")
+        if not all(isinstance(extra, str) for extra in candidate.extras):
+            raise InvalidRequirement("Invalid replacement field type")
+
+        copied_specs = tuple(
+            Specifier(str(s), prereleases=s._prereleases) for s in candidate.specifier
+        )
+        prereleases = candidate.specifier._prereleases
+        candidate.specifier = SpecifierSet(copied_specs, prereleases=prereleases)
+        requirement_string = str(candidate)
+        parsed = Requirement(requirement_string)
+        if (
+            parsed.name != candidate.name
+            or parsed.url != candidate.url
+            or parsed.extras != candidate.extras
+            or parsed.specifier != candidate.specifier
+            or parsed.marker != candidate.marker
+        ):
+            raise InvalidRequirement("Replacement fields do not round-trip")
+
+        result = self.__class__(requirement_string)
+        result.specifier = SpecifierSet(copied_specs, prereleases=prereleases)
+        return result
+
     def _iter_parts(self, name: str) -> Iterator[str]:
         yield name
 
diff --git a/tests/test_requirements.py b/tests/test_requirements.py
index ad78c2b..8e040f5 100644
--- a/tests/test_requirements.py
+++ b/tests/test_requirements.py
@@ -4,7 +4,9 @@
 
 from __future__ import annotations
 
+import copy
 import pickle
+from typing import Any
 
 import pytest
 
@@ -1085,3 +1087,107 @@ def test_pickle_requirement_25_0_format_loads() -> None:
     assert str(r.specifier) == ">=2.0"
     assert r.marker is None
     assert r == Requirement("requests>=2.0")
+
+
+@pytest.mark.parametrize(
+    "changes",
+    [
+        {},
+        {"name": "flask2"},
+        {"extras": {"Foo_Bar", "test2"}},
+        {"specifier": SpecifierSet(">=3.0")},
+        {"marker": Marker('extra == "Foo_Bar"')},
+        {"marker": None, "extras": set()},
+        {"url": "https://example.com/a;v=2", "specifier": SpecifierSet()},
+    ],
+)
+def test_replace(changes: dict[str, Any]) -> None:
+    original = Requirement('requests[security]>=2.0; python_version >= "3"')
+    before = str(original)
+    result = original.__replace__(**changes)
+    assert result is not original
+    assert str(original) == before
+    assert result == Requirement(str(result))
+    for field in ("name", "url", "extras", "specifier", "marker"):
+        assert getattr(result, field) == changes.get(field, getattr(original, field))
+    assert result.extras is not original.extras
+    assert result.marker is not original.marker or result.marker is None
+    if hasattr(copy, "replace"):
+        assert copy.replace(original, **changes) == result
+
+
+@pytest.mark.parametrize(
+    "changes",
+    [
+        {"name": "not a name!"},
+        {"name": "foo[bar]"},
+        {"name": "foo>=3"},
+        {"name": " foo"},
+        {"extras": {"a,b"}},
+        {"extras": {""}},
+        {"url": ""},
+        {"url": "https://example.com ; os_name == 'posix'"},
+        {"url": "https://example.com"},
+        {"name": None},
+        {"extras": {1}},
+        {"specifier": ">=3"},
+        {"marker": "os_name == 'posix'"},
+    ],
+)
+def test_replace_invalid(changes: dict[str, Any]) -> None:
+    with pytest.raises(InvalidRequirement):
+        Requirement("requests>=2").__replace__(**changes)
+
+
+def test_replace_arguments() -> None:
+    req = Requirement("requests")
+    with pytest.raises(TypeError):
+        req.__replace__(unknown="foo")  # type: ignore[call-arg]
+    with pytest.raises(TypeError):
+        req.__replace__("foo")  # type: ignore[call-arg]
+
+
+@pytest.mark.parametrize("prereleases", [None, False, True])
+@pytest.mark.parametrize("replace_specifier", [False, True])
+def test_replace_specifier_copy(
+    prereleases: bool | None, replace_specifier: bool
+) -> None:
+    req = Requirement("requests>=2,!=3,<=4")
+    specifier = SpecifierSet(">=2,!=3,<=4", prereleases=prereleases)
+    for spec, setting in zip(specifier, (None, False, True), strict=True):
+        spec.prereleases = setting
+    if replace_specifier:
+        result = req.__replace__(specifier=specifier)
+    else:
+        req.specifier = specifier
+        result = req.__replace__()
+    assert result.specifier is not specifier
+    assert result.specifier._prereleases is prereleases
+    for old, new in zip(specifier, result.specifier, strict=True):
+        assert old == new
+        assert old is not new
+        assert old._prereleases is new._prereleases
+        new.prereleases = not old.prereleases
+        assert old._prereleases is not new._prereleases
+    result.specifier.prereleases = not prereleases
+    assert specifier._prereleases is prereleases
+
+
+def test_replace_subclass() -> None:
+    class CustomRequirement(Requirement):
+        def __init__(self, requirement_string: str) -> None:
+            super().__init__(requirement_string)
+            self.initialized = requirement_string
+
+    req = CustomRequirement("requests")
+    result = req.__replace__(name="flask")
+    assert isinstance(result, CustomRequirement)
+    assert result.initialized == "flask"
+    assert req.initialized == "requests"
+
+
+def test_replace_clear_url() -> None:
+    req = Requirement("requests @ https://example.com")
+    assert req.__replace__(url=None, specifier=SpecifierSet(">=3")) == Requirement(
+        "requests>=3"
+    )
