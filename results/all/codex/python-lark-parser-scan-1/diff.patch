+    def scan(self, text: TextOrSlice, start: Optional[str]=None) -> Iterator[ScanMatch[_Return_T]]:
+        """Yield non-overlapping, longest grammar matches at the earliest source offsets.
+
+        Only LALR with the basic or contextual lexer is supported, without postlex.
+        Lexer callbacks may run for discarded candidates. ValueError from a lexer
+        callback rejects that candidate; other callback exceptions propagate.
+        """
+        if self.options.postlex is not None:
+            raise ConfigurationError("scan() does not support postlex")
+        if self.options.parser != 'lalr' or self.options.lexer not in ('basic', 'contextual'):
+            raise ConfigurationError("scan() requires parser='lalr' and a basic or contextual lexer")
+        start = self.parser._verify_start(start)
+        return self._scan(TextSlice.cast_from(text), start)
+
+    def _scan(self, text: TextSlice, start: str) -> Iterator[ScanMatch[_Return_T]]:
+        """Recognize candidates without reductions' callbacks, then parse retained tokens."""
+        callback_errors = []
