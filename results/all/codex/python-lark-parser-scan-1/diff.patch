+        def guard(callback):
+            """Distinguish callback parse errors from failed recognition."""
+            def call(token):
+                """Preserve callback exceptions for the scan loop."""
+                try:
+                    return callback(token)
+                except UnexpectedInput as error:
+                    callback_errors.append(error)
+                    raise
+            return call
+
+        def clone(lexer):
+            """Reuse lexer configuration with guarded callbacks and a fresh scanner."""
+            lexer = copy(lexer)
+            lexer.user_callbacks = {name: guard(callback) for name, callback in lexer.user_callbacks.items()}
+            lexer._scanner = None
+            return lexer
+
+        lexer = self.parser.lexer
+        if self.options.lexer == 'basic':
