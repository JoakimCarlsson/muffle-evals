+@pytest.mark.parametrize("prefix", ["", "[parent]\n"])
+@pytest.mark.parametrize("key", ["a", "a2"])
+@pytest.mark.parametrize("count", [1, 2])
+@pytest.mark.parametrize("suffix", ["", "c.d = 2\nz = 3\n[other]\ny = 4\n"])
+def test_replace_dotted_key_with_aot_keeps_following_siblings(
+    prefix: str, key: str, count: int, suffix: str
+) -> None:
+    doc = parse(f"{prefix}{key}.b = 1\n{suffix}")
+    target = doc["parent"] if prefix else doc
+    value = tomlkit.aot()
+    for x in range(9, 9 + count):
+        value.append(tomlkit.table().add("x", x))
+    target[key] = value
+
+    expected: dict[str, Any] = {key: [{"x": x} for x in range(9, 9 + count)]}
+    if suffix:
+        expected.update({"c": {"d": 2}, "z": 3})
+    if prefix:
+        expected = {"parent": expected}
+    if suffix:
+        expected["other"] = {"y": 4}
+    assert doc == expected
+    assert parse(tomlkit.dumps(doc)) == expected
+
+
 def test_replace_value_with_table_keeps_following_dotted_sibling() -> None:
     # A plain value turning into a table must likewise clear the inline region
     # (including dotted keys) before emitting its header.
