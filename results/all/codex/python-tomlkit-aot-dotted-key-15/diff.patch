diff --git a/tests/test_toml_document.py b/tests/test_toml_document.py
index 0e950cb..6f8b980 100644
--- a/tests/test_toml_document.py
+++ b/tests/test_toml_document.py
@@ -1170,6 +1170,37 @@ x = 9
     assert parse(doc.as_string()) == {"c": {"d": 2}, "a": {"x": 9}}
 
 
+@pytest.mark.parametrize(
+    "content",
+    [
+        "a.b = 1\nc.d = 2\n",
+        "c.d = 2\na.b = 1\n",
+        "a.b = 1\nplain = 3\nc.d = 2\n[other]\nz = 4\n",
+        "a.b = 1\nc.d = 2\na.e = 3\n",
+        "a.b = 1\n",
+    ],
+)
+@pytest.mark.parametrize("prefix", ["", "[parent]\n"])
+@pytest.mark.parametrize("rows", [[{"x": 9}], [{}, {"x2": 9}]])
+def test_replace_dotted_key_with_aot_keeps_siblings(
+    content: str, prefix: str, rows: list[dict[str, int]]
+) -> None:
+    doc = parse(prefix + content)
+    target = doc["parent"] if prefix else doc
+    expected = doc.unwrap()
+    expected_target = expected["parent"] if prefix else expected
+    expected_target["a"] = rows
+    aot = tomlkit.aot()
+    for row in rows:
+        table = tomlkit.table()
+        table.update(row)
+        aot.append(table)
+    target["a"] = aot
+
+    assert target == expected_target
+    assert parse(tomlkit.dumps(doc)) == expected
+
+
 def test_replace_value_with_table_keeps_following_dotted_sibling() -> None:
     # A plain value turning into a table must likewise clear the inline region
     # (including dotted keys) before emitting its header.
