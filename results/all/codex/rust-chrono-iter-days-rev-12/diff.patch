+#[test]
+fn test_date_iterators_reverse() {
+    let start = NaiveDate::from_ymd_opt(2025, 10, 10).unwrap();
+    for start in [NaiveDate::MIN, start, NaiveDate::MAX] {
+        for count in [0, 1, 7] {
+            let mut days: Vec<_> = start.iter_days().take(count).collect();
+            days.reverse();
+            assert_eq!(days, start.iter_days().take(count).rev().collect::<Vec<_>>());
+            let mut weeks: Vec<_> = start.iter_weeks().take(count).collect();
+            weeks.reverse();
+            assert_eq!(weeks, start.iter_weeks().take(count).rev().collect::<Vec<_>>());
+        }
+    }
+    for offset in 0..22 {
+        let start = NaiveDate::MAX.checked_sub_days(Days::new(offset)).unwrap();
+        for step in [1, 7] {
+            let expected: Vec<_> =
+                if step == 1 { start.iter_days().collect() } else { start.iter_weeks().collect() };
+            let reversed: Vec<_> = if step == 1 {
+                start.iter_days().rev().collect()
+            } else {
+                start.iter_weeks().rev().collect()
+            };
+            assert_eq!(reversed, expected.iter().rev().copied().collect::<Vec<_>>());
+            let mut iter: Box<dyn DoubleEndedIterator<Item = NaiveDate>> =
+                if step == 1 { Box::new(start.iter_days()) } else { Box::new(start.iter_weeks()) };
+            let mut front = 0;
+            let mut back = expected.len();
+            while front < back {
+                assert_eq!(iter.size_hint(), (back - front, Some(back - front)));
+                assert_eq!(iter.next(), Some(expected[front]));
+                front += 1;
+                if front < back {
+                    back -= 1;
+                    assert_eq!(iter.next_back(), Some(expected[back]));
+                }
+            }
+            assert_eq!(iter.size_hint(), (0, Some(0)));
+            assert_eq!(iter.next_back(), None);
+            assert_eq!(iter.next(), None);
+            assert_eq!(iter.next_back(), None);
+        }
+    }
+}
