+// numDigitsUint64 returns the exact number of decimal digits of u (1 for zero).
+func numDigitsUint64(u uint64) int {
+	n := 1
+	for u >= 10 {
+		// strip digits in chunks to keep the loop short
+		if u >= 1e8 {
+			u /= 1e8
+			n += 8
+			continue
+		}
+		u /= 10
+		n++
+	}
+	return n
+}
