+func TestDecimal_NumDigitsPowersOfTen(t *testing.T) {
+	for _, s := range []string{"100000000000000E20", "1000000000000000E20", "10000000000000000E20"} {
+		d, err := NewFromString(s)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if want, got := len(d.Coefficient().Text(10)), d.NumDigits(); got != want {
+			t.Errorf("%s: NumDigits() = %d, want %d", s, got, want)
+		}
+	}
+}
