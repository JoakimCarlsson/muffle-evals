+
+func TestDecimal_NumDigitsExact(t *testing.T) {
+	p := big.NewInt(1)
+	for i := 0; i < 80; i++ {
+		for _, x := range []*big.Int{new(big.Int).Set(p), new(big.Int).Sub(p, big.NewInt(1)), new(big.Int).Neg(p)} {
+			if x.Sign() == 0 {
+				continue
+			}
+			want := len(new(big.Int).Abs(x).String())
+			if got := NewFromBigInt(x, 0).NumDigits(); got != want {
+				t.Errorf("NumDigits(%s) = %d, want %d", x, got, want)
+			}
+		}
+		p.Mul(p, big.NewInt(10))
+	}
+}
