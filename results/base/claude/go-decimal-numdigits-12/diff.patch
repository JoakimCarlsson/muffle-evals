+
+func TestDecimal_NumDigitsPowersOfTen(t *testing.T) {
+	for i := 0; i < 400; i++ {
+		p := new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(i)), nil)
+		for _, v := range []*big.Int{p, new(big.Int).Sub(p, big.NewInt(1)), new(big.Int).Neg(p)} {
+			if v.Sign() == 0 {
+				continue
+			}
+			d := NewFromBigInt(v, 0)
+			if want := len(new(big.Int).Abs(v).Text(10)); d.NumDigits() != want {
+				t.Errorf("NumDigits(%s) = %d, want %d", v, d.NumDigits(), want)
+			}
+		}
+	}
+	d, _ := NewFromString("1000000000000000E20")
+	if d.NumDigits() != 16 {
+		t.Errorf("got %d, want 16", d.NumDigits())
+	}
+}
