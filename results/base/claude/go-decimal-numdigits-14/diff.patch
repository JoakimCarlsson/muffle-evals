+func TestNumDigitsPowersOfTen(t *testing.T) {
+	for e := 0; e < 60; e++ {
+		p := new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(e)), nil)
+		for _, off := range []int64{-1, 0, 1} {
+			c := new(big.Int).Add(p, big.NewInt(off))
+			if c.Sign() == 0 {
+				continue
+			}
+			want := len(c.Text(10))
+			if got := NewFromBigInt(c, 20).NumDigits(); got != want {
+				t.Errorf("NumDigits(%s) = %d, want %d", c, got, want)
+			}
+			if got := NewFromBigInt(new(big.Int).Neg(c), 0).NumDigits(); got != want {
+				t.Errorf("NumDigits(-%s) = %d, want %d", c, got, want)
+			}
+		}
+	}
+}
