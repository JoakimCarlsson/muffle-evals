+
+func TestNumDigitsPowersOfTen(t *testing.T) {
+	for _, s := range []string{"100000000000000E20", "1000000000000000E20", "10000000000000000E20"} {
+		d, err := NewFromString(s)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if want, got := len(d.Coefficient().Text(10)), d.NumDigits(); want != got {
+			t.Errorf("%s: want %d, got %d", s, want, got)
+		}
+	}
+	p := big.NewInt(1)
+	for i := 1; i <= 80; i++ {
+		d := NewFromBigInt(p, 0)
+		if got := d.NumDigits(); got != i {
+			t.Errorf("10^%d: want %d, got %d", i-1, i, got)
+		}
+		p.Mul(p, big.NewInt(10))
+		m := new(big.Int).Sub(p, big.NewInt(1))
+		if got := NewFromBigInt(m, 0).NumDigits(); got != i {
+			t.Errorf("10^%d-1: want %d, got %d", i, i, got)
+		}
+	}
+}
