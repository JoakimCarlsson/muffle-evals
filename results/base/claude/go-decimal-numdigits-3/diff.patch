+
+func TestNumDigitsExact(t *testing.T) {
+	for _, s := range []string{"100000000000000E20", "1000000000000000E20", "10000000000000000E20"} {
+		d, err := NewFromString(s)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if want, got := len(d.Coefficient().Text(10)), d.NumDigits(); want != got {
+			t.Errorf("%s: want %d, got %d", s, want, got)
+		}
+	}
+	p := big.NewInt(1)
+	for i := 0; i < 2000; i++ {
+		for _, delta := range []int64{-1, 0, 1} {
+			v := new(big.Int).Add(p, big.NewInt(delta))
+			d := NewFromBigInt(v, 0)
+			if want, got := len(v.Text(10)), d.NumDigits(); want != got {
+				t.Fatalf("10^%d%+d: want %d, got %d", i, delta, want, got)
+			}
+		}
+		p.Mul(p, big.NewInt(10))
+	}
+}
