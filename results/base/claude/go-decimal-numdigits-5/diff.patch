+
+func TestDecimal_NumDigitsExact(t *testing.T) {
+	for _, s := range []string{
+		"100000000000000E20", "1000000000000000E20", "10000000000000000E20",
+		"-1000000000000000E20", "9999999999999999", "-9223372036854775808",
+		"18446744073709551616", "0", "-1",
+	} {
+		d, err := NewFromString(s)
+		if err != nil {
+			t.Fatal(err)
+		}
+		want := len(new(big.Int).Abs(d.Coefficient()).Text(10))
+		if got := d.NumDigits(); got != want {
+			t.Errorf("%s: NumDigits() = %d, want %d", s, got, want)
+		}
+	}
+	for e := 0; e < 40; e++ {
+		for _, delta := range []int64{-1, 0, 1} {
+			v := new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(e)), nil)
+			v.Add(v, big.NewInt(delta))
+			d := NewFromBigInt(v, 0)
+			want := len(v.Text(10))
+			if got := d.NumDigits(); got != want {
+				t.Errorf("%s: NumDigits() = %d, want %d", v, got, want)
+			}
+		}
+	}
+}
