+def test_merge_options():
+    with pytest.raises(OptionError):
+        _cmd(MergeCatalog, input_files=['a'], output_file='o')
+    with pytest.raises(OptionError):
+        _cmd(MergeCatalog, input_files=['a', 'b'])
+    assert _cmd(MergeCatalog, input_files=['a', 'b'], update=True).suffix == '~'
