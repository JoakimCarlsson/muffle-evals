+
+
+class TestReplace:
+    def test_basic(self) -> None:
+        r = Requirement('requests[security]>=2.0; python_version >= "3"')
+        assert str(r.__replace__(name="flask")) == (
+            'flask[security]>=2.0; python_version >= "3"'
+        )
+        assert str(r) == 'requests[security]>=2.0; python_version >= "3"'
+
+    def test_no_args(self) -> None:
+        r = Requirement("a[x]>=1; os_name == 'a'")
+        c = r.__replace__()
+        assert c == r
+        assert c is not r
+        assert c.specifier is not r.specifier
+
+    def test_unknown_keyword(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("a").__replace__(foo=1)  # type: ignore[call-arg]
+        with pytest.raises(TypeError):
+            Requirement("a").__replace__("b")  # type: ignore[misc]
+
+    @pytest.mark.parametrize(
+        "kwargs",
+        [
+            {"name": "not a name!"},
+            {"name": "foo[bar]"},
+            {"extras": {"a,b"}},
+            {"extras": {""}},
+            {"url": "http://x; y"},
+        ],
+    )
+    def test_invalid(self, kwargs: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("a").__replace__(**kwargs)  # type: ignore[arg-type]
+
+    def test_marker_normalized(self) -> None:
+        r = Requirement("a").__replace__(marker=Marker('extra == "Foo_Bar"'))
+        assert str(r.marker) == 'extra == "foo-bar"'
+
+    def test_url_and_clear(self) -> None:
+        r = Requirement("a>=1; os_name == 'a'").__replace__(
+            specifier=SpecifierSet(), marker=None, url="https://x/y"
+        )
+        assert str(r) == "a @ https://x/y"
+        assert r.__replace__(url=None).url is None
+
+    def test_prereleases_kept_and_not_shared(self) -> None:
+        spec = SpecifierSet(
+            [Specifier(">=1", prereleases=True), Specifier("<3")], prereleases=False
+        )
+        r = Requirement("a").__replace__(specifier=spec)
+        assert r.specifier is not spec
+        assert r.specifier.prereleases is False
+        assert r.specifier._prereleases is False
+        orig = {str(s): s for s in spec}
+        for s in r.specifier:
+            assert s is not orig[str(s)]
+            assert s._prereleases == orig[str(s)]._prereleases
+        r2 = r.__replace__(name="b")
+        assert r2.specifier is not r.specifier
+        assert r2.specifier._prereleases is False
+        assert {str(s): s._prereleases for s in r2.specifier}[">=1"] is True
+
+    def test_copy_replace_and_subclass(self) -> None:
+        class Sub(Requirement):
+            def __init__(self, s: str) -> None:
+                super().__init__(s)
+                self.extra_state = 1
+
+        r = Sub("a").__replace__(name="b")
+        assert type(r) is Sub
+        assert r.extra_state == 1
+        if hasattr(copy, "replace"):
+            assert str(copy.replace(Requirement("a>=2"), name="c")) == "c>=2"
