+    def __replace__(
+        self,
+        /,
+        *,
+        name: str = _UNSET,
+        url: str | None = _UNSET,
+        extras: Iterable[str] = _UNSET,
+        specifier: SpecifierSet = _UNSET,
+        marker: Marker | None = _UNSET,
+    ) -> Self:
+        """Return a copy of this requirement with the given fields replaced.
+
+        Fields that are not passed are kept. The result is validated as if its
+        string form had been parsed, and the specifier is copied (including
+        ``prereleases`` settings) rather than shared.
+
+        :raises InvalidRequirement: If the resulting requirement is not valid,
+            or a value would be read back as something different (for example
+            ``name="foo[bar]"``).
+
+        .. versionadded:: 26.4
+        """
+        if name is _UNSET:
+            name = self.name
+        if url is _UNSET:
+            url = self.url
+        if extras is _UNSET:
+            extras = self.extras
+        elif isinstance(extras, str):
+            raise TypeError("extras must be an iterable of strings, not a string")
+        if specifier is _UNSET:
+            specifier = self.specifier
+        elif not isinstance(specifier, SpecifierSet):
+            raise TypeError("specifier must be a SpecifierSet")
+        if marker is _UNSET:
+            marker = self.marker
+        elif marker is not None and not isinstance(marker, Marker):
+            raise TypeError("marker must be a Marker or None")
+        if not isinstance(name, str) or not (url is None or isinstance(url, str)):
+            raise TypeError("name and url must be strings")
+
+        extras = set(extras)
+        if not all(isinstance(e, str) for e in extras):
+            raise TypeError("extras must be strings")
+        url = url or None
+        new_specifier = _copy_specifier_set(specifier)
+        # Normalize the marker the same way parsing does.
+        new_marker = Marker(str(marker)) if marker is not None else None
+
+        candidate = Requirement.__new__(Requirement)
+        candidate.name = name
+        candidate.url = url
+        candidate.extras = extras
+        candidate.specifier = new_specifier
+        candidate.marker = new_marker
+        try:
+            result = type(self)(str(candidate))
+        except InvalidRequirement as e:
+            raise InvalidRequirement(f"Invalid replacement: {e}") from e
+
+        # Reject values that parse, but as something other than what was asked.
+        if (
+            result.name != name
+            or result.url != url
+            or result.extras != extras
+            or str(result.specifier) != str(new_specifier)
+            or result.specifier != new_specifier
+            or str(result.marker) != str(new_marker)
+        ):
+            raise InvalidRequirement(
+                f"Replacement values do not round-trip: {str(candidate)!r}"
+            )
+        result.specifier = new_specifier
+        return result
+
