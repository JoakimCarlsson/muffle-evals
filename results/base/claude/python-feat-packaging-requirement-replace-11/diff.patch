 __all__ = [
     "InvalidRequirement",
     "Requirement",
@@ -106,6 +109,88 @@ class Requirement:
             self.marker = Marker.__new__(Marker)
             self.marker._markers = _normalize_extra_values(parsed.marker)
 
+    def __replace__(self, /, **changes: Any) -> Self:
+        """Return a copy of this requirement with the given fields replaced.
+
+        Accepts the keyword arguments ``name``, ``url``, ``extras``,
+        ``specifier`` and ``marker``. Fields that are not given are kept. The
+        result is validated and normalized as if its string form was parsed.
+        This is what :func:`copy.replace` calls on Python 3.13+.
+
+        :raises TypeError: If an unknown keyword or a value of the wrong type
+            is given.
+        :raises InvalidRequirement: If the resulting requirement is not valid,
+            or would not read back as the same requirement from its string.
+
+        .. versionadded:: 26.3
+        """
+        unknown = changes.keys() - set(self.__slots__)
+        if unknown:
+            raise TypeError(
+                f"Requirement.__replace__() got an unexpected keyword argument "
+                f"{sorted(unknown)[0]!r}"
+            )
+
+        name = changes.get("name", self.name)
+        url = changes.get("url", self.url) or None
+        extras = changes.get("extras", self.extras)
+        specifier = changes.get("specifier", self.specifier)
+        marker = changes.get("marker", self.marker)
+
+        if not isinstance(name, str):
+            raise TypeError(f"name must be a str, not {type(name).__name__}")
+        if url is not None and not isinstance(url, str):
+            raise TypeError(f"url must be a str or None, not {type(url).__name__}")
+        if isinstance(extras, str) or not isinstance(extras, Iterable):
+            raise TypeError("extras must be an iterable of str")
+        extras = set(extras)
+        if not all(isinstance(e, str) for e in extras):
+            raise TypeError("extras must be an iterable of str")
+        if not isinstance(specifier, SpecifierSet):
+            raise TypeError(
+                f"specifier must be a SpecifierSet, not {type(specifier).__name__}"
+            )
+        if marker is not None and not isinstance(marker, Marker):
+            raise TypeError(f"marker must be a Marker or None, not {type(marker).__name__}")
+
+        # Copy the specifier set and its specifiers, keeping prereleases
+        # settings, so the result does not share mutable state with the input.
+        specs = tuple(
+            Specifier(str(s), prereleases=s._prereleases)
+            if isinstance(s, Specifier)
+            else s
+            for s in specifier._specs
+        )
+        new_specifier = SpecifierSet(specs, prereleases=specifier._prereleases)
+
+        candidate = Requirement.__new__(Requirement)
+        candidate.name = name
+        candidate.url = url
+        candidate.extras = extras
+        candidate.specifier = new_specifier
+        candidate.marker = marker
+        try:
+            result = self.__class__(str(candidate))
+            new_marker = Marker(str(marker)) if marker is not None else None
+        except InvalidMarker as e:
+            raise InvalidRequirement(str(e)) from e
+
+        # Reject values that parse, but as something other than what was given.
+        if (
+            result.name != name
+            or result.url != url
+            or result.extras != extras
+            or str(result.specifier) != str(new_specifier)
+            or str(result.marker) != str(new_marker)
+        ):
+            raise InvalidRequirement(
+                f"Cannot replace fields: {str(candidate)!r} does not parse back "
+                "to the same requirement"
+            )
+
+        result.specifier = new_specifier
+        return result
+
     def _iter_parts(self, name: str) -> Iterator[str]:
         yield name
 
diff --git a/tests/test_requirements.py b/tests/test_requirements.py
index ad78c2b..660ea0d 100644
--- a/tests/test_requirements.py
+++ b/tests/test_requirements.py
@@ -1085,3 +1085,48 @@ def test_pickle_requirement_25_0_format_loads() -> None:
     assert str(r.specifier) == ">=2.0"
     assert r.marker is None
     assert r == Requirement("requests>=2.0")
+
+
+class TestReplace:
+    def test_replace_fields(self) -> None:
+        r = Requirement('requests[security]>=2.0; python_version >= "3"')
+        assert str(r.__replace__(name="flask")) == (
+            'flask[security]>=2.0; python_version >= "3"'
+        )
+        assert str(r) == 'requests[security]>=2.0; python_version >= "3"'
+        copy_ = r.__replace__()
+        assert copy_ == r
+        assert copy_ is not r
+
+    def test_unknown_keyword(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("a").__replace__(foo=1)  # type: ignore[call-arg]
+
+    @pytest.mark.parametrize(
+        "change", [{"name": "not a name!"}, {"name": "foo[bar]"}, {"extras": {"a,b"}}]
+    )
+    def test_invalid(self, change: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("a").__replace__(**change)
+
+    def test_prereleases_not_shared(self) -> None:
+        r = Requirement("a>=1,<2")
+        r.specifier.prereleases = True
+        old_spec = next(s for s in r.specifier._specs if str(s) == ">=1")
+        old_spec._prereleases = False
+        new = r.__replace__(name="b")
+        new_spec = next(s for s in new.specifier._specs if str(s) == ">=1")
+        assert new.specifier is not r.specifier
+        assert new.specifier.prereleases is True
+        assert new_spec._prereleases is False
+        assert new_spec is not old_spec
+
+    def test_subclass(self) -> None:
+        class Sub(Requirement):
+            def __init__(self, s: str) -> None:
+                super().__init__(s)
+                self.extra_attr = 1
+
+        new = Sub("a").__replace__(name="b")
+        assert type(new) is Sub
+        assert new.extra_attr == 1
