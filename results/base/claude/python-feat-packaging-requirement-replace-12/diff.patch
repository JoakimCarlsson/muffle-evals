+    def __replace__(self, /, **changes: Any) -> Requirement:
+        """Return a copy of this requirement with the given fields replaced.
+
+        Accepts only the keyword arguments ``name``, ``url``, ``extras``,
+        ``specifier`` and ``marker``; fields not given are kept. The result is
+        validated as if its string form had been parsed, and the
+        :attr:`~packaging.specifiers.SpecifierSet.prereleases` settings of the
+        specifier set and its specifiers are preserved. The returned
+        requirement shares no mutable state with this one. Subclasses get an
+        instance of their own class.
+
+        This is what :func:`copy.replace` calls on Python 3.13+.
+
+        :raises TypeError: If an unknown keyword argument is given.
+        :raises InvalidRequirement: If the resulting requirement is not valid,
+            or a value would not read back unchanged.
+
+        .. versionadded:: 26.4
+        """
+        unknown = changes.keys() - set(self.__slots__)
+        if unknown:
+            raise TypeError(
+                f"__replace__() got an unexpected keyword argument {sorted(unknown)[0]!r}"
+            )
+
+        name = changes.get("name", self.name)
+        url = changes.get("url", self.url)
+        extras = changes.get("extras", self.extras)
+        specifier = changes.get("specifier", self.specifier)
+        marker = changes.get("marker", self.marker)
+
+        if not isinstance(name, str):
+            raise InvalidRequirement(f"Invalid name: {name!r}")
+        if url is not None and not isinstance(url, str):
+            raise InvalidRequirement(f"Invalid url: {url!r}")
+        if isinstance(extras, str) or not all(isinstance(e, str) for e in extras):
+            raise InvalidRequirement(f"Invalid extras: {extras!r}")
+        extras = set(extras)
+        if not isinstance(specifier, SpecifierSet):
+            raise InvalidRequirement(f"Invalid specifier: {specifier!r}")
+        if marker is not None and not isinstance(marker, Marker):
+            raise InvalidRequirement(f"Invalid marker: {marker!r}")
+
+        # Build the string form and parse it, so the result is exactly what
+        # parsing would give (including normalization).
+        parts = Requirement.__new__(Requirement)
+        parts.name, parts.url, parts.extras = name, url, extras
+        parts.specifier, parts.marker = specifier, marker
+        new = self.__class__(str(parts))
+
+        # Reject values that parsed into something other than what was given.
+        expected_marker = None if marker is None else str(Marker(str(marker)))
+        if (
+            new.name != name
+            or new.url != url
+            or new.extras != extras
+            or str(new.specifier) != str(specifier)
+            or (None if new.marker is None else str(new.marker)) != expected_marker
+        ):
+            raise InvalidRequirement(
+                f"Replacement values do not round-trip: {str(parts)!r}"
+            )
+
+        # The string form drops prereleases settings; restore them on fresh
+        # copies so nothing is shared with the input.
+        new.specifier = SpecifierSet(
+            [copy.copy(s) for s in specifier], prereleases=specifier._prereleases
+        )
+        return new
+
