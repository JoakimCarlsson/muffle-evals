+    def __replace__(
+        self,
+        *,
+        name: str = _MISSING,
+        url: str | None = _MISSING,
+        extras: Iterable[str] = _MISSING,
+        specifier: SpecifierSet = _MISSING,
+        marker: Marker | None = _MISSING,
+    ) -> Requirement:
+        """Return a copy of this requirement with the given fields replaced.
+
+        Fields that are not passed are kept. The result is validated as if it
+        had been parsed from its string form.
+
+        :raises InvalidRequirement: If the resulting requirement is invalid, or
+            a value would not read back unchanged from the string form.
+
+        .. versionadded:: 26.3
+        """
+        if name is _MISSING:
+            name = self.name
+        if url is _MISSING:
+            url = self.url
+        if extras is _MISSING:
+            extras = self.extras
+        elif isinstance(extras, str):
+            raise TypeError("extras must be an iterable of strings, not str")
+        if specifier is _MISSING:
+            specifier = self.specifier
+        elif not isinstance(specifier, SpecifierSet):
+            raise TypeError("specifier must be a SpecifierSet")
+        if marker is _MISSING:
+            marker = self.marker
+        elif marker is not None and not isinstance(marker, Marker):
+            raise TypeError("marker must be a Marker or None")
+        if not isinstance(name, str):
+            raise TypeError("name must be a str")
+        if url is not None and not isinstance(url, str):
+            raise TypeError("url must be a str or None")
+        extras = set(extras)
+        if not all(isinstance(e, str) for e in extras):
+            raise TypeError("extras must be strings")
+        specifier = _copy_specifier_set(specifier)
+
+        # Build the string form and parse it, so the result is exactly what
+        # parsing would give.
+        parts = [name]
+        if extras:
+            parts.append(f"[{','.join(sorted(extras))}]")
+        if specifier:
+            parts.append(str(specifier))
+        if url:
+            parts.append(f" @ {url}")
+            if marker:
+                parts.append(" ")
+        if marker:
+            parts.append(f"; {marker}")
+        new = self.__class__("".join(parts))
+
+        # Reject values that parsed as something other than what was passed.
+        if new.name != name or new.extras != extras or new.url != url:
+            raise InvalidRequirement(
+                f"Replacement values do not round-trip: {''.join(parts)!r}"
+            )
+        new.specifier = specifier
+        return new
