+    from typing_extensions import Self
 
 __all__ = [
     "InvalidRequirement",
@@ -106,6 +109,107 @@ class Requirement:
             self.marker = Marker.__new__(Marker)
             self.marker._markers = _normalize_extra_values(parsed.marker)
 
+    def __replace__(
+        self,
+        *,
+        name: str = _UNSET,
+        url: str | None = _UNSET,
+        extras: Iterable[str] = _UNSET,
+        specifier: SpecifierSet = _UNSET,
+        marker: Marker | None = _UNSET,
+    ) -> Self:
+        """
+        __replace__(*, name=..., url=..., extras=..., specifier=..., marker=...)
+
+        Return a new requirement with parts replaced.
+
+        Parts that are not given are kept. The result is always a new object
+        that shares no mutable state with this one, and it is validated as if
+        its string form had been parsed; values are normalized the same way.
+        Subclasses get an instance of their own class.
+
+        >>> r = Requirement('requests[security]>=2.0')
+        >>> r.__replace__(name="flask")
+        <Requirement('flask[security]>=2.0')>
+
+        :param str name:
+        :param str | None url:
+        :param Iterable[str] extras:
+        :param SpecifierSet specifier:
+        :param Marker | None marker:
+        :raises InvalidRequirement: If the resulting requirement is not valid,
+            or a value would not read back unchanged from the requirement
+            string.
+        :raises TypeError: If a value has the wrong type.
+
+        .. versionadded:: 26.4
+        """
+        new_name = self.name if name is _UNSET else name
+        new_url = self.url if url is _UNSET else (url or None)
+        new_marker = self.marker if marker is _UNSET else marker
+        new_specifier = self.specifier if specifier is _UNSET else specifier
+        if extras is _UNSET:
+            new_extras = set(self.extras)
+        elif isinstance(extras, str):
+            raise TypeError("extras must be an iterable of strings, not str")
+        else:
+            new_extras = set(extras)
+
+        if not isinstance(new_name, str):
+            raise TypeError(f"name must be a str, not {type(new_name).__name__}")
+        if new_url is not None and not isinstance(new_url, str):
+            raise TypeError(f"url must be a str or None, not {type(new_url).__name__}")
+        if not all(isinstance(e, str) for e in new_extras):
+            raise TypeError("extras must all be strings")
+        if not isinstance(new_specifier, SpecifierSet):
+            raise TypeError(
+                f"specifier must be a SpecifierSet, not {type(new_specifier).__name__}"
+            )
+        if new_marker is not None and not isinstance(new_marker, Marker):
+            raise TypeError(
+                f"marker must be a Marker or None, not {type(new_marker).__name__}"
+            )
+
+        parts = [new_name]
+        if new_extras:
+            parts.append(f"[{','.join(sorted(new_extras))}]")
+        parts.append(str(new_specifier))
+        if new_url:
+            parts.append(f" @ {new_url}")
+            if new_marker:
+                parts.append(" ")
+        if new_marker:
+            parts.append(f"; {new_marker}")
+        requirement_string = "".join(parts)
+
+        result = type(self)(requirement_string)
+
+        # Anything that parsed into something other than what was asked for
+        # (e.g. name="foo[bar]" or extras={"a,b"}) is rejected.
+        if (
+            result.name != new_name
+            or result.url != new_url
+            or result.extras != new_extras
+            or len(result.specifier) != len(new_specifier)
+            or (result.marker is None) != (not new_marker)
+        ):
+            raise InvalidRequirement(
+                f"Replacement values do not form a consistent requirement: "
+                f"{requirement_string!r}"
+            )
+
+        # Rebuild the specifier set so prereleases overrides survive, on the
+        # set and on each specifier, without sharing mutable objects.
+        copied: list[Specifier] = []
+        for spec in new_specifier:
+            copy_ = Specifier(str(spec))
+            copy_._prereleases = spec._prereleases
+            copied.append(copy_)
+        specifier_copy = SpecifierSet(copied)
+        specifier_copy._prereleases = new_specifier._prereleases
+        result.specifier = specifier_copy
+        return result
+
     def _iter_parts(self, name: str) -> Iterator[str]:
         yield name
 
