 from __future__ import annotations
 
+import copy
 import pickle
 
 import pytest
 
 from packaging.markers import Marker
 from packaging.requirements import InvalidRequirement, Requirement
-from packaging.specifiers import SpecifierSet
+from packaging.specifiers import Specifier, SpecifierSet
 
 EQUAL_DEPENDENCIES = [
     ("packaging>20.1", "packaging>20.1"),
@@ -1085,3 +1086,71 @@ def test_pickle_requirement_25_0_format_loads() -> None:
     assert str(r.specifier) == ">=2.0"
     assert r.marker is None
     assert r == Requirement("requests>=2.0")
+
+
+class TestRequirementReplace:
+    def test_replace_fields(self) -> None:
+        r = Requirement('requests[security]>=2.0; python_version >= "3"')
+        assert str(r.__replace__(name="flask")) == (
+            'flask[security]>=2.0; python_version >= "3"'
+        )
+        assert str(r) == 'requests[security]>=2.0; python_version >= "3"'
+        assert (
+            str(r.__replace__(extras=set())) == 'requests>=2.0; python_version >= "3"'
+        )
+        assert str(r.__replace__(marker=None)) == "requests[security]>=2.0"
+
+    def test_no_arguments(self) -> None:
+        r = Requirement("requests>=2.0")
+        copied = r.__replace__()
+        assert copied == r
+        assert copied is not r
+        assert copied.specifier is not r.specifier
+
+    def test_unknown_keyword(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("a").__replace__(foo=1)  # type: ignore[call-arg]
+
+    @pytest.mark.parametrize(
+        "kwargs",
+        [
+            {"name": "not a name!"},
+            {"name": "foo[bar]"},
+            {"extras": {"a,b"}},
+            {"url": "a b"},
+            {"url": "http://x/y.whl"},  # url plus specifier
+        ],
+    )
+    def test_invalid(self, kwargs: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("a>=1").__replace__(**kwargs)  # type: ignore[arg-type]
+
+    def test_marker_normalized(self) -> None:
+        r = Requirement("a").__replace__(marker=Marker('extra == "Foo_Bar"'))
+        assert str(r.marker) == 'extra == "foo-bar"'
+
+    def test_specifier_prereleases_preserved_and_not_shared(self) -> None:
+        ss = SpecifierSet([Specifier(">=1", prereleases=True)], prereleases=False)
+        r = Requirement("a").__replace__(specifier=ss)
+        assert r.specifier is not ss
+        assert r.specifier._prereleases is False
+        assert [s._prereleases for s in r.specifier] == [True]
+        assert r.specifier._specs[0] is not ss._specs[0]
+        again = r.__replace__()
+        assert again.specifier._prereleases is False
+        assert again.specifier._specs[0] is not r.specifier._specs[0]
+
+    def test_subclass(self) -> None:
+        class Sub(Requirement):
+            def __init__(self, s: str) -> None:
+                super().__init__(s)
+                self.extra_attr = 1
+
+        new = Sub("a").__replace__(name="b")
+        assert type(new) is Sub
+        assert new.extra_attr == 1
+
+    def test_copy_replace(self) -> None:
+        if not hasattr(copy, "replace"):
+            pytest.skip("copy.replace needs Python 3.13+")
+        assert str(copy.replace(Requirement("a>=2"), name="b")) == "b>=2"
