+    def scan(self, text: TextOrSlice, start: Optional[str]=None) -> 'Iterator[ScanMatch[_Return_T]]':
+        """Find the matches of the grammar inside the given text, like a regexp search would.
+
+        Yields non-overlapping matches, in order. Each match is the longest prefix that parses,
+        starting at the earliest position where a match is possible. Text that doesn't parse is skipped.
+        Matches are never empty, and never start or end with an ignored terminal.
+
+        Only works with parser='lalr' and a built-in lexer (and without postlex).
+
+        Parameters:
+            text (TextOrSlice): Text to scan, as `str`, `bytes` or `TextSlice`.
+                When given a TextSlice, only the slice is scanned, but positions are relative to the whole text.
+            start (str, optional): Required if Lark was given multiple possible start symbols (using the start option).
+
+        Returns:
+            An iterator of ``ScanMatch`` instances, whose ``range`` is a ``(start, end)`` tuple,
+            and whose ``value`` is what ``parse()`` returns for the matched text (a Tree, or the result of the transformer).
+
+        :raises ConfigurationError: (immediately) if this Lark instance can't scan.
+
+        Lexer callbacks and the transformer's token callbacks may be called on text that doesn't end up matching.
+        A callback may raise ValueError to signal that a token is invalid.
+        """
+        if self.options.parser is None:
+            raise ConfigurationError("scan() requires a parser. It doesn't work with parser=None (lexer-only mode)")
+        if self.options.parser != 'lalr':
+            raise ConfigurationError("scan() currently only works with parser='lalr'")
+        if self.options.postlex is not None:
+            raise ConfigurationError("scan() doesn't support postlex")
+        if isinstance(self.options.lexer, type):
+            raise ConfigurationError("scan() doesn't support custom lexers")
+        return self.parser.scan(text, start=start)
+
 
 ###}
