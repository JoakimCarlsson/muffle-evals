@@ -1617,3 +1617,14 @@ value = 5
 """
 
     assert doc.as_string() == expected
+
+
+def test_replace_dotted_key_with_aot_keeps_following_keys():
+    doc = tomlkit.parse("a.b = 1\nc.d = 2\n")
+    aot = tomlkit.aot()
+    t = tomlkit.table()
+    t["x"] = 9
+    aot.append(t)
+    doc["a"] = aot
+
+    assert tomlkit.parse(tomlkit.dumps(doc)) == {"c": {"d": 2}, "a": [{"x": 9}]}
