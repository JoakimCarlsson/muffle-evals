+#[test]
+fn test_day_iterator_rev() {
+    let start = NaiveDate::from_ymd_opt(2025, 10, 10).unwrap();
+    let mut fwd: Vec<_> = start.iter_days().take(7).collect();
+    fwd.reverse();
+    let rev: Vec<_> = start.iter_days().take(7).rev().collect();
+    assert_eq!(fwd, rev);
