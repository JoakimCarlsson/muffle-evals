 pub struct NaiveDateWeeksIterator {
+    /// Next date to yield from the front.
     value: NaiveDate,
+    /// Last date (inclusive) still to be yielded; next date to yield from the back.
+    end: NaiveDate,
+    /// Set once the two ends have met and the final date has been yielded.
+    done: bool,
+}
+
+impl NaiveDateWeeksIterator {
+    const fn new(start: NaiveDate) -> Self {
+        let days = NaiveDate::MAX.signed_duration_since(start).num_days();
+        let end = match start.add_days((days / 7 * 7) as i32) {
+            Some(end) => end,
+            None => start,
+        };
+        NaiveDateWeeksIterator { value: start, end, done: false }
+    }
 }
 
