 pub struct NaiveDateWeeksIterator {
     value: NaiveDate,
+    /// Upper bound: a yielded date `d` satisfies `d + 7 days <= end`.
+    end: NaiveDate,
+}
+
+impl NaiveDateWeeksIterator {
+    fn remaining(&self) -> i64 {
+        (self.end.signed_duration_since(self.value).num_days() / 7).max(0)
+    }
