+    /// Strip a prefix from the iterator, like [`str::strip_prefix`].
+    ///
+    /// If the iterator starts with all of the items of `prefix`, in order,
+    /// return `Ok` with the iterator advanced past the prefix.
+    /// An empty prefix returns the whole iterator.
+    ///
+    /// Otherwise return a [`StripPrefixError`] holding what was consumed:
+    /// the iterator (stopped right after the mismatching item), the rest of the
+    /// prefix, and the mismatching pair of items.
+    ///
+    /// ```
+    /// use itertools::Itertools;
+    ///
+    /// let rest = (1..6).strip_prefix([1, 2]).unwrap().collect_vec();
+    /// assert_eq!(rest, [3, 4, 5]);
+    ///
+    /// let err = (1..6).strip_prefix([1, 2, 9, 4]).unwrap_err();
+    /// assert_eq!(err.mismatch, (Some(3), 9));
+    /// assert_eq!(err.prefix.collect_vec(), [4]);
+    /// assert_eq!(err.iterator.collect_vec(), [4, 5]);
+    ///
+    /// let err = (1..3).strip_prefix([1, 2, 3]).unwrap_err();
+    /// assert_eq!(err.mismatch, (None, 3));
+    /// assert_eq!(err.iterator.count(), 0);
+    /// ```
+    #[allow(clippy::type_complexity)]
+    fn strip_prefix<J>(self, prefix: J) -> Result<Self, StripPrefixError<Self, J::IntoIter>>
+    where
+        Self: Sized,
+        J: IntoIterator,
+        Self::Item: PartialEq<J::Item>,
+    {
+        self.strip_prefix_by(prefix, |x, y| x == y)
+    }
+
+    /// Like [`strip_prefix`](Itertools::strip_prefix), but compares items
+    /// with the closure `eq`, so the prefix can have a different item type.
+    ///
+    /// ```
+    /// use itertools::Itertools;
+    ///
+    /// let rest = ["1", "2", "3"]
+    ///     .iter()
+    ///     .strip_prefix_by([1, 2], |s, n| s.parse::<i32>() == Ok(*n))
+    ///     .unwrap()
+    ///     .collect_vec();
+    /// assert_eq!(rest, [&"3"]);
+    /// ```
+    #[allow(clippy::type_complexity)]
+    fn strip_prefix_by<J, F>(
+        mut self,
+        prefix: J,
+        mut eq: F,
+    ) -> Result<Self, StripPrefixError<Self, J::IntoIter>>
+    where
+        Self: Sized,
+        J: IntoIterator,
+        F: FnMut(&Self::Item, &J::Item) -> bool,
+    {
+        let mut prefix = prefix.into_iter();
+        while let Some(p) = prefix.next() {
+            match self.next() {
+                Some(x) if eq(&x, &p) => {}
+                other => {
+                    return Err(StripPrefixError {
+                        iterator: self,
+                        prefix,
+                        mismatch: (other, p),
+                    })
+                }
+            }
+        }
+        Ok(self)
+    }
