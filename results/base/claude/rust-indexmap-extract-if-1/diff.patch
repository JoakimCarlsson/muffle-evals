+    T: fmt::Debug,
+{
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_list()
+            .entries(self.inner.pending().iter().map(Bucket::key_ref))
+            .finish()
+    }
+}
