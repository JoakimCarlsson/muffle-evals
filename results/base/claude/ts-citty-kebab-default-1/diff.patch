+  };
+  propagateAliases();
+
+  // Apply defaults last so values passed via any alias take precedence
+  for (const [name, value] of Object.entries(defaults)) {
+    if ((out as any)[name] === undefined) {
+      (out as any)[name] = value;
     }
   }
+  propagateAliases();
 
