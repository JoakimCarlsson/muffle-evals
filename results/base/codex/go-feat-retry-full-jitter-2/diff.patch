+func TestWithFullJitter(t *testing.T) {
+	t.Parallel()
+
+	// Changing bases also verifies that each call advances the wrapped backoff.
+	bases := []time.Duration{time.Nanosecond, time.Second, 1<<63 - 1, 0, -time.Second, -1 << 63}
+	i := 0
+	b := retry.WithFullJitter(retry.BackoffFunc(func() (time.Duration, bool) {
+		if i == len(bases) {
+			return time.Second, true
+		}
+		base := bases[i]
+		i++
+		return base, false
+	}))
+	for _, base := range bases {
+		val, stop := b.Next()
+		if stop {
+			t.Fatal("should not stop")
+		}
+		if base > 0 {
+			if val < 0 || val >= base {
+				t.Errorf("expected %v in [0, %v)", val, base)
+			}
+		} else if val != base {
+			t.Errorf("expected %v, got %v", base, val)
+		}
+	}
+	if val, stop := b.Next(); !stop || val != 0 {
+		t.Errorf("expected (0, true), got (%v, %t)", val, stop)
+	}
+}
