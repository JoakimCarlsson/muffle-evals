@@ -106,6 +109,66 @@ class Requirement:
             self.marker = Marker.__new__(Marker)
             self.marker._markers = _normalize_extra_values(parsed.marker)
 
+    def __replace__(  # noqa: PYI019 - Self requires Python 3.11
+        self: _RequirementT, **changes: object
+    ) -> _RequirementT:
+        """Return a new requirement with the given fields replaced.
+
+        Accepts ``name``, ``url``, ``extras``, ``specifier``, and ``marker``
+        as keyword arguments, with the same types as the corresponding
+        attributes. Unspecified fields are retained. The result is validated
+        and normalized by parsing, and mutable fields are copied. Specifier
+        prerelease overrides are preserved.
+
+        :raises TypeError: If an unknown keyword is supplied.
+        :raises InvalidRequirement: If the resulting fields cannot be represented
+            by a requirement string without changing their meaning.
+        """
+        for field in changes:
+            if field not in Requirement.__slots__:
+                raise TypeError(f"Unexpected keyword argument {field!r}")
+
+        name = changes.get("name", self.name)
+        url = changes.get("url", self.url)
+        extras = changes.get("extras", self.extras)
+        specifier = changes.get("specifier", self.specifier)
+        marker = changes.get("marker", self.marker)
+        if not (
+            isinstance(name, str)
+            and (url is None or isinstance(url, str))
+            and isinstance(extras, set)
+            and all(isinstance(extra, str) for extra in extras)
+            and isinstance(specifier, SpecifierSet)
+            and (marker is None or isinstance(marker, Marker))
+        ):
+            raise InvalidRequirement("Invalid requirement field types")
+
+        candidate = Requirement.__new__(Requirement)
+        candidate.name = name
+        candidate.url = url
+        candidate.extras = extras
+        candidate.specifier = specifier
+        candidate.marker = marker
+        result = type(self)(str(candidate))
+        # Parsing must not let delimiters embedded in a field inject other
+        # fields, or silently discard parts of the supplied values.
+        if (
+            result.name != name
+            or result.url != url
+            or result.extras != extras
+            or str(result.specifier) != str(specifier)
+            or result.marker != marker
+        ):
+            raise InvalidRequirement("Replacement fields do not round-trip")
+
+        # Parsing alone loses explicit prerelease overrides. Reconstruct both
+        # levels so neither the set nor its mutable members are shared.
+        result.specifier = SpecifierSet(
+            (Specifier(str(s), prereleases=s._prereleases) for s in specifier),
+            prereleases=specifier._prereleases,
+        )
+        return result
+
     def _iter_parts(self, name: str) -> Iterator[str]:
         yield name
 
