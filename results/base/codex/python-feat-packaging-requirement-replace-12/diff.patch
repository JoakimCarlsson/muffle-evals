 import pytest
@@ -1085,3 +1086,115 @@ def test_pickle_requirement_25_0_format_loads() -> None:
     assert str(r.specifier) == ">=2.0"
     assert r.marker is None
     assert r == Requirement("requests>=2.0")
+
+
+class TestRequirementReplace:
+    @pytest.mark.parametrize(
+        ("changes", "expected"),
+        [
+            ({}, 'requests[security]>=2.0; python_version >= "3"'),
+            ({"name": "flask"}, 'flask[security]>=2.0; python_version >= "3"'),
+            (
+                {"extras": {"foo", "Bar"}},
+                'requests[Bar,foo]>=2.0; python_version >= "3"',
+            ),
+            (
+                {"specifier": SpecifierSet("<4")},
+                'requests[security]<4; python_version >= "3"',
+            ),
+            ({"marker": None}, "requests[security]>=2.0"),
+            (
+                {"marker": Marker('extra == "Foo_Bar"')},
+                'requests[security]>=2.0; extra == "foo-bar"',
+            ),
+            (
+                {"url": "https://example.com/pkg", "specifier": SpecifierSet()},
+                'requests[security] @ https://example.com/pkg ; python_version >= "3"',
+            ),
+        ],
+    )
+    def test_replace(self, changes: dict[str, object], expected: str) -> None:
+        original = 'requests[security]>=2.0; python_version >= "3"'
+        req = Requirement(original)
+        result = req.__replace__(**changes)
+        assert result is not req
+        assert str(result) == expected
+        assert result == Requirement(str(result))
+        assert str(req) == original
+        assert result.extras is not req.extras
+        if result.marker is not None:
+            assert result.marker is not req.marker
+
+    @pytest.mark.parametrize(
+        "changes",
+        [
+            {"name": "not a name!"},
+            {"name": "foo[bar]"},
+            {"name": "foo>=1"},
+            {"name": " foo "},
+            {"extras": {"a,b"}},
+            {"extras": {""}},
+            {"url": ""},
+            {"url": 'https://example.com ; os_name == "posix"'},
+            {"url": "https://example.com", "specifier": SpecifierSet(">=1")},
+            {"name": None},
+            {"extras": "foo"},
+            {"extras": {1}},
+            {"specifier": ">=1"},
+            {"marker": 'os_name == "posix"'},
+        ],
+    )
+    def test_invalid(self, changes: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("requests").__replace__(**changes)
+
+    def test_unknown_keyword(self) -> None:
+        with pytest.raises(TypeError, match="unknown"):
+            Requirement("requests").__replace__(unknown="value")
+
+    def test_positional_argument(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("requests").__replace__("flask")  # type: ignore[call-arg]
+
+    @pytest.mark.parametrize("override", [None, True, False])
+    @pytest.mark.parametrize("replace_specifier", [False, True])
+    def test_prereleases(self, override: bool | None, replace_specifier: bool) -> None:
+        req = Requirement("requests>=1,<4,!=2")
+        specifiers = SpecifierSet(">=1,<4,!=2", prereleases=override)
+        for specifier, value in zip(specifiers, (None, True, False), strict=True):
+            specifier.prereleases = value
+        if replace_specifier:
+            result = req.__replace__(specifier=specifiers)
+        else:
+            req.specifier = specifiers
+            result = req.__replace__()
+        assert result.specifier is not specifiers
+        assert result.specifier._prereleases is override
+        for old, new in zip(specifiers, result.specifier, strict=True):
+            assert new == old
+            assert new is not old
+            assert new._prereleases is old._prereleases
+            new.prereleases = not old.prereleases
+            assert new.prereleases is not old.prereleases
+        result.specifier.prereleases = not override
+        assert specifiers._prereleases is override
+
+    def test_subclass(self) -> None:
+        class CustomRequirement(Requirement):
+            def __init__(self, requirement_string: str) -> None:
+                super().__init__(requirement_string)
+                self.initialized_name = self.name
+
+        req = CustomRequirement("requests")
+        result = req.__replace__(name="flask")
+        assert isinstance(result, CustomRequirement)
+        assert result.initialized_name == "flask"
+        assert req.initialized_name == "requests"
+
+    def test_copy_replace(self) -> None:
+        if not hasattr(copy, "replace"):
+            pytest.skip("copy.replace requires Python 3.13+")
+        req = Requirement("requests>=2.0")
+        assert copy.replace(req, specifier=SpecifierSet(">=3.0")) == Requirement(
+            "requests>=3.0"
+        )
