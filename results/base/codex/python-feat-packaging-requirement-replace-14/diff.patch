@@ -106,6 +111,70 @@ class Requirement:
             self.marker = Marker.__new__(Marker)
             self.marker._markers = _normalize_extra_values(parsed.marker)
 
+    def __replace__(
+        self,
+        *,
+        name: str = _UNSET,
+        url: str | None = _UNSET,
+        extras: set[str] = _UNSET,
+        specifier: SpecifierSet = _UNSET,
+        marker: Marker | None = _UNSET,
+    ) -> Self:
+        """Return a new requirement with the specified fields replaced.
+
+        Unspecified fields are retained. Values must have the same types as
+        the corresponding attributes and form a valid requirement without
+        changing the meaning of other fields, or :class:`InvalidRequirement`
+        is raised. Specifiers are copied, preserving prerelease overrides.
+
+        Supports :func:`copy.replace` on Python 3.13 and later, and can be
+        called directly on earlier Python versions.
+        """
+        name = self.name if name is _UNSET else name
+        url = self.url if url is _UNSET else url
+        extras = self.extras if extras is _UNSET else extras
+        specifier = self.specifier if specifier is _UNSET else specifier
+        marker = self.marker if marker is _UNSET else marker
+
+        field_types = (
+            (name, str),
+            (url, (str, type(None))),
+            (extras, set),
+            (specifier, SpecifierSet),
+            (marker, (Marker, type(None))),
+        )
+        if not all(isinstance(value, types) for value, types in field_types):
+            raise InvalidRequirement("Invalid requirement field types")
+        if not all(isinstance(extra, str) for extra in extras):
+            raise InvalidRequirement("Invalid extra types")
+
+        # Serialize using the usual formatting, then parse to validate and
+        # normalize. Compare fields individually to reject delimiter injection
+        # (e.g. a name of 'foo[bar]') even when the string is valid.
+        candidate = Requirement.__new__(Requirement)
+        candidate.name = name
+        candidate.url = url
+        candidate.extras = extras
+        candidate.specifier = specifier
+        candidate.marker = marker
+        result = type(self)(str(candidate))
+        if (
+            result.name != name
+            or result.url != url
+            or result.extras != extras
+            or result.specifier != specifier
+            or result.marker != marker
+        ):
+            raise InvalidRequirement("Requirement fields do not round-trip")
+
+        # Parsing cannot retain these overrides. Reconstruct each specifier
+        # as well as the set so none of their mutable state is shared.
+        result.specifier = SpecifierSet(
+            (Specifier(str(s), prereleases=s._prereleases) for s in specifier),
+            prereleases=specifier._prereleases,
+        )
+        return result
+
     def _iter_parts(self, name: str) -> Iterator[str]:
         yield name
 
