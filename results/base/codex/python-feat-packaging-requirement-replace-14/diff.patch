+class TestRequirementReplace:
+    def test_fields(self) -> None:
+        original = Requirement('requests[security]>=2; python_version >= "3"')
+        result = original.__replace__(name="flask")
+        assert str(result) == 'flask[security]>=2; python_version >= "3"'
+        assert str(original) == 'requests[security]>=2; python_version >= "3"'
+        assert result == Requirement(str(result))
+        assert result.extras is not original.extras
+        assert result.marker is not original.marker
+        assert original.__replace__() == original
+        assert original.__replace__() is not original
+
+    def test_all_fields(self) -> None:
+        result = Requirement("requests>=2").__replace__(
+            name="flask",
+            url="https://example.com/flask.whl",
+            extras={"Test_Extra"},
+            specifier=SpecifierSet(),
+            marker=Marker('extra == "Foo_Bar"'),
+        )
+        assert str(result) == (
+            'flask[Test_Extra] @ https://example.com/flask.whl ; extra == "foo-bar"'
+        )
+        cleared = result.__replace__(url=None, extras=set(), marker=None)
+        assert str(cleared) == "flask"
+
+    @pytest.mark.parametrize(
+        "changes",
+        [
+            {"name": "not a name!"},
+            {"name": "foo[bar]"},
+            {"name": "foo>=2"},
+            {"name": " foo "},
+            {"extras": {"a,b"}},
+            {"extras": {""}},
+            {"url": ""},
+            {"url": 'https://example.com ; python_version >= "3"'},
+            {"url": "https://example.com"},  # conflicts with the specifier
+            {"name": None},
+            {"extras": "abc"},
+            {"extras": {1}},
+            {"specifier": ">=3"},
+            {"marker": "invalid"},
+            {"url": 1},
+        ],
+    )
+    def test_invalid(self, changes: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("requests>=2").__replace__(**changes)  # type: ignore[arg-type]
+
+    def test_arguments(self) -> None:
+        req = Requirement("requests")
+        with pytest.raises(TypeError):
+            req.__replace__(unknown="foo")  # type: ignore[call-arg]
+        with pytest.raises(TypeError):
+            req.__replace__("foo")  # type: ignore[call-arg]
+
+    @pytest.mark.parametrize("prereleases", [None, False, True])
+    @pytest.mark.parametrize("replace_specifier", [False, True])
+    def test_specifier_copy(
+        self, prereleases: bool | None, replace_specifier: bool
+    ) -> None:
+        req = Requirement("requests>=2,<4,!=3")
+        source = SpecifierSet(">=2,<4,!=3") if replace_specifier else req.specifier
+        source.prereleases = prereleases
+        overrides = {">=2": True, "<4": False, "!=3": None}
+        for spec in source:
+            spec.prereleases = overrides[str(spec)]
+        result = (
+            req.__replace__(specifier=source)
+            if replace_specifier
+            else req.__replace__()
+        )
+        assert result.specifier == source
+        assert result.specifier is not source
+        assert result.specifier._prereleases is prereleases
+        for spec in result.specifier:
+            assert spec._prereleases is overrides[str(spec)]
+            assert all(spec is not old for old in source)
+            spec.prereleases = not spec.prereleases
+        assert {str(s): s._prereleases for s in source} == overrides
+        result.specifier.prereleases = not prereleases
+        assert source._prereleases is prereleases
+
+    def test_subclass(self) -> None:
+        class CustomRequirement(Requirement):
+            def __init__(self, requirement_string: str) -> None:
+                super().__init__(requirement_string)
+                self.initial_name = self.name
+
+        result = CustomRequirement("requests").__replace__(name="flask")
+        assert isinstance(result, CustomRequirement)
+        assert result.initial_name == "flask"
+
+    def test_copy_replace(self) -> None:
+        if not hasattr(copy, "replace"):
+            pytest.skip("copy.replace requires Python 3.13+")
+        result = copy.replace(
+            Requirement("requests>=2.0"), specifier=SpecifierSet(">=3.0")
+        )
+        assert str(result) == "requests>=3.0"
