--- a/CHANGELOG.rst
+++ b/CHANGELOG.rst
@@ -4,6 +4,12 @@ Changelog
 *unreleased*
 ~~~~~~~~~~~~
 
+Features:
+
+* Add :meth:`Requirement.__replace__ <packaging.requirements.Requirement.__replace__>`
+  for validated copies with selected fields changed, including support for
+  :func:`copy.replace` on Python 3.13 and later.
+
 Removals:
 
 * Drop support for EOL Python 3.9. (:pull:`1263`)
diff --git a/docs/requirements.rst b/docs/requirements.rst
index fede671..f8e59e4 100644
--- a/docs/requirements.rst
+++ b/docs/requirements.rst
@@ -60,6 +60,22 @@ Usage
     >>> requirements2 = {Requirement("pip"), Requirement("packaging")}
     >>> requirements1 == requirements2
     True
+    >>> # Create a validated copy with selected fields replaced:
+    >>> from packaging.specifiers import SpecifierSet
+    >>> req.__replace__(name="other", specifier=SpecifierSet(">=3"))
+    <Requirement('other[foo]>=3; python_version > "2.0"')>
+
+``Requirement.__replace__`` accepts the keyword arguments ``name``, ``url``,
+``extras``, ``specifier``, and ``marker``, using the same types as the attributes.
+Unspecified fields are preserved, and the original requirement is unchanged.
+The result is validated and normalized as if parsed from a string; invalid fields
+or fields that would be interpreted differently raise :class:`InvalidRequirement`.
+Unknown keywords raise :class:`TypeError`.
+
+The specifier set and its individual specifiers are copied independently,
+preserving their prerelease overrides. Subclasses receive an instance of their
+own class, initialized with the resulting requirement string.
+On Python 3.13 and later, this method also supports :func:`copy.replace`.
 
 .. versionchanged:: 23.2
 
diff --git a/src/packaging/requirements.py b/src/packaging/requirements.py
index 124de66..fe482f8 100644
--- a/src/packaging/requirements.py
+++ b/src/packaging/requirements.py
@@ -8,12 +8,14 @@ from typing import TYPE_CHECKING
 from ._parser import parse_requirement as _parse_requirement
 from ._tokenizer import ParserSyntaxError
 from .markers import Marker, _normalize_extra_values
-from .specifiers import InvalidSpecifier, SpecifierSet
+from .specifiers import InvalidSpecifier, Specifier, SpecifierSet
 from .utils import canonicalize_name
 
 if TYPE_CHECKING:
     from collections.abc import Iterator
 
+    from typing_extensions import Self
+
 __all__ = [
     "InvalidRequirement",
     "Requirement",
@@ -106,6 +108,65 @@ class Requirement:
             self.marker = Marker.__new__(Marker)
             self.marker._markers = _normalize_extra_values(parsed.marker)
 
+    def __replace__(self, **changes: object) -> Self:
+        """Return a new requirement with the given fields replaced.
+
+        Accepts ``name``, ``url``, ``extras``, ``specifier``, and ``marker``
+        with the same types as the corresponding attributes. The result is
+        validated and normalized by parsing its string representation.
+
+        Supports :func:`copy.replace` on Python 3.13 and later, and can be
+        called directly on earlier versions.
+
+        :raises TypeError: If an unknown field is supplied.
+        :raises InvalidRequirement: If the fields cannot be represented as a
+            requirement without changing their meaning.
+        """
+        fields = ("name", "url", "extras", "specifier", "marker")
+        for field in changes:
+            if field not in fields:
+                raise TypeError(f"Unexpected field for Requirement: {field!r}")
+
+        values = {field: changes.get(field, getattr(self, field)) for field in fields}
+        extras = values["extras"]
+        if not (
+            isinstance(values["name"], str)
+            and (values["url"] is None or isinstance(values["url"], str))
+            and isinstance(extras, set)
+            and all(isinstance(extra, str) for extra in extras)
+            and isinstance(values["specifier"], SpecifierSet)
+            and (values["marker"] is None or isinstance(values["marker"], Marker))
+        ):
+            raise InvalidRequirement("Invalid types for requirement fields")
+
+        candidate = Requirement.__new__(Requirement)
+        for field, value in values.items():
+            setattr(candidate, field, value)
+
+        result = type(self)(str(candidate))
+        # Compare fields individually: requirement equality normalizes names
+        # and extras and could hide a field being interpreted as another one.
+        marker = Marker(str(candidate.marker)) if candidate.marker is not None else None
+        if (
+            result.name != candidate.name
+            or result.url != candidate.url
+            or result.extras != candidate.extras
+            or result.specifier != candidate.specifier
+            or result.marker != marker
+        ):
+            raise InvalidRequirement("Requirement fields do not round-trip")
+
+        # Parsing loses explicit prerelease overrides. Recreate both the set
+        # and its members to preserve those overrides without sharing state.
+        result.specifier = SpecifierSet(
+            (
+                Specifier(str(spec), prereleases=spec._prereleases)
+                for spec in candidate.specifier
+            ),
+            prereleases=candidate.specifier._prereleases,
+        )
+        return result
+
     def _iter_parts(self, name: str) -> Iterator[str]:
         yield name
 
diff --git a/tests/test_requirements.py b/tests/test_requirements.py
index ad78c2b..50b9af9 100644
--- a/tests/test_requirements.py
+++ b/tests/test_requirements.py
@@ -4,6 +4,7 @@
 
 from __future__ import annotations
 
+import copy
 import pickle
 
 import pytest
@@ -1085,3 +1086,110 @@ def test_pickle_requirement_25_0_format_loads() -> None:
     assert str(r.specifier) == ">=2.0"
     assert r.marker is None
     assert r == Requirement("requests>=2.0")
+
+
+class TestReplace:
+    def test_fields(self) -> None:
+        original = Requirement('requests[security]>=2; python_version >= "3"')
+        replacement = original.__replace__(name="flask")
+        assert str(replacement) == 'flask[security]>=2; python_version >= "3"'
+        assert original.name == "requests"
+        clone = original.__replace__()
+        assert clone == original
+        assert clone is not original
+        assert clone.extras is not original.extras
+        assert clone.marker is not original.marker
+        assert original.__replace__(extras={"test"}).extras == {"test"}
+        assert original.__replace__(marker=None).marker is None
+        assert original.__replace__(
+            specifier=SpecifierSet(">=3")
+        ).specifier == SpecifierSet(">=3")
+
+    def test_url(self) -> None:
+        original = Requirement("requests>=2")
+        replacement = original.__replace__(
+            url="https://example.com/archive.zip", specifier=SpecifierSet()
+        )
+        assert str(replacement) == "requests @ https://example.com/archive.zip"
+        assert replacement.__replace__(url=None) == Requirement("requests")
+
+    @pytest.mark.parametrize(
+        "changes",
+        [
+            {"name": "not a name!"},
+            {"name": "foo[bar]"},
+            {"name": " foo"},
+            {"extras": {"a,b"}},
+            {"extras": {""}},
+            {"url": ""},
+            {"url": "https://example.com ; os_name == 'posix'"},
+            {"url": "https://example.com"},
+            {"name": None},
+            {"specifier": ">=3"},
+            {"marker": "os_name == 'posix'"},
+            {"extras": ["test"]},
+        ],
+    )
+    def test_invalid(self, changes: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("requests>=2").__replace__(**changes)
+
+    def test_keyword_arguments(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("requests").__replace__(unknown="value")
+        with pytest.raises(TypeError):
+            Requirement("requests").__replace__("flask")  # type: ignore[call-arg]
+
+    def test_marker_normalization(self) -> None:
+        result = Requirement("requests").__replace__(
+            marker=Marker('extra == "Foo_Bar"')
+        )
+        assert str(result.marker) == 'extra == "foo-bar"'
+        assert result == Requirement(str(result))
+
+    @pytest.mark.parametrize("override", [None, False, True])
+    @pytest.mark.parametrize("member_override", [None, False, True])
+    @pytest.mark.parametrize("supplied", [False, True])
+    def test_prereleases(
+        self, override: bool | None, member_override: bool | None, supplied: bool
+    ) -> None:
+        original = Requirement("requests>=2a1,<4")
+        source = SpecifierSet(">=3a1,<5") if supplied else original.specifier
+        source.prereleases = override
+        for spec in source:
+            spec.prereleases = member_override
+        result = (
+            original.__replace__(specifier=source)
+            if supplied
+            else original.__replace__()
+        )
+        assert result.specifier is not source
+        assert result.specifier._prereleases is override
+        for before, after in zip(
+            sorted(source, key=str), sorted(result.specifier, key=str), strict=True
+        ):
+            assert before == after
+            assert before is not after
+            assert after._prereleases is member_override
+            after.prereleases = not member_override
+            assert before._prereleases is member_override
+        result.specifier.prereleases = not override
+        assert source._prereleases is override
+
+    def test_subclass(self) -> None:
+        class CustomRequirement(Requirement):
+            def __init__(self, requirement_string: str) -> None:
+                super().__init__(requirement_string)
+                self.initialized_name = self.name
+
+        original = CustomRequirement("requests")
+        result = original.__replace__(name="flask")
+        assert isinstance(result, CustomRequirement)
+        assert result.initialized_name == "flask"
+
+    def test_copy_replace(self) -> None:
+        if not hasattr(copy, "replace"):
+            pytest.skip("copy.replace requires Python 3.13+")
+        assert copy.replace(
+            Requirement("requests>=2"), specifier=SpecifierSet(">=3")
+        ) == Requirement("requests>=3")
