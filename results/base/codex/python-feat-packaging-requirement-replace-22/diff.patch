@@ -4,6 +4,7 @@
 
 from __future__ import annotations
 
+import copy
 import pickle
 
 import pytest
@@ -1085,3 +1086,123 @@ def test_pickle_requirement_25_0_format_loads() -> None:
     assert str(r.specifier) == ">=2.0"
     assert r.marker is None
     assert r == Requirement("requests>=2.0")
+
+
+@pytest.mark.parametrize(
+    ("changes", "expected"),
+    [
+        ({}, 'requests[security]>=2.0; python_version >= "3"'),
+        ({"name": "flask"}, 'flask[security]>=2.0; python_version >= "3"'),
+        ({"extras": {"docs"}}, 'requests[docs]>=2.0; python_version >= "3"'),
+        (
+            {"specifier": SpecifierSet(">=3")},
+            'requests[security]>=3; python_version >= "3"',
+        ),
+        ({"marker": None}, "requests[security]>=2.0"),
+        (
+            {"marker": Marker('extra == "Foo_Bar"')},
+            'requests[security]>=2.0; extra == "foo-bar"',
+        ),
+        (
+            {"url": "https://example.com/a.whl", "specifier": SpecifierSet()},
+            'requests[security] @ https://example.com/a.whl ; python_version >= "3"',
+        ),
+    ],
+)
+def test_replace(changes: dict[str, object], expected: str) -> None:
+    original = 'requests[security]>=2.0; python_version >= "3"'
+    r = Requirement(original)
+    result = r.__replace__(**changes)  # type: ignore[arg-type]
+    assert result is not r
+    assert str(result) == expected
+    assert result == Requirement(str(result))
+    assert str(r) == original
+    assert result.extras is not r.extras
+    assert result.marker is not r.marker or r.marker is None
+
+
+@pytest.mark.parametrize(
+    "changes",
+    [
+        {"name": "not a name!"},
+        {"name": "foo[bar]"},
+        {"name": "foo>=1"},
+        {"name": " foo "},
+        {"name": ""},
+        {"extras": {"a,b"}},
+        {"extras": {""}},
+        {"extras": {"a]"}},
+        {"url": "https://example.com/a ; os_name == 'posix'"},
+        {"url": ""},
+        {"url": "https://example.com/a"},  # Conflicts with the specifier.
+        {"name": None},
+        {"extras": None},
+        {"specifier": ">=3"},
+        {"marker": "os_name == 'posix'"},
+    ],
+)
+def test_replace_invalid(changes: dict[str, object]) -> None:
+    r = Requirement("requests>=2")
+    with pytest.raises(InvalidRequirement):
+        r.__replace__(**changes)  # type: ignore[arg-type]
+    assert str(r) == "requests>=2"
+
+
+def test_replace_arguments() -> None:
+    r = Requirement("requests")
+    with pytest.raises(TypeError):
+        r.__replace__(unknown="foo")  # type: ignore[call-arg]
+    with pytest.raises(TypeError):
+        r.__replace__("foo")  # type: ignore[call-arg]
+
+
+@pytest.mark.parametrize("override", [None, False, True])
+@pytest.mark.parametrize("member_override", [None, False, True])
+@pytest.mark.parametrize("replace_specifier", [False, True])
+def test_replace_prereleases(
+    override: bool | None, member_override: bool | None, replace_specifier: bool
+) -> None:
+    r = Requirement("requests>=2.0a1,<4")
+    specs = SpecifierSet(">=3.0a1,<5") if replace_specifier else r.specifier
+    specs.prereleases = override
+    for spec in specs:
+        spec.prereleases = member_override
+    result = r.__replace__(specifier=specs) if replace_specifier else r.__replace__()
+    assert result.specifier is not specs
+    assert result.specifier._prereleases is override
+    for source in specs:
+        copied = next(s for s in result.specifier if str(s) == str(source))
+        assert copied is not source
+        assert copied._prereleases is member_override
+        copied.prereleases = not member_override
+        assert source._prereleases is member_override
+    result.specifier.prereleases = not override
+    assert specs._prereleases is override
+
+
+def test_replace_clear_url() -> None:
+    r = Requirement("requests[security] @ https://example.com/a")
+    result = r.__replace__(url=None, extras=set(), specifier=SpecifierSet(">=3"))
+    assert str(result) == "requests>=3"
+
+
+def test_replace_subclass() -> None:
+    class CustomRequirement(Requirement):
+        def __init__(self, requirement_string: str) -> None:
+            super().__init__(requirement_string)
+            self.initialized_name = self.name
+
+    r = CustomRequirement("requests>=2")
+    result = r.__replace__(name="flask")
+    assert isinstance(result, CustomRequirement)
+    assert result.initialized_name == "flask"
+    assert r.initialized_name == "requests"
+
+
+def test_copy_replace() -> None:
+    if not hasattr(copy, "replace"):
+        pytest.skip("copy.replace requires Python 3.13+")
+    r = Requirement("requests>=2")
+    result = copy.replace(r, specifier=SpecifierSet(">=3"))
+    assert result == Requirement("requests>=3")
+    assert str(r) == "requests>=2"
