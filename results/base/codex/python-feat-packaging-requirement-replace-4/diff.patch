index 124de66..6a8851d 100644
--- a/src/packaging/requirements.py
+++ b/src/packaging/requirements.py
@@ -8,12 +8,14 @@ from typing import TYPE_CHECKING
 from ._parser import parse_requirement as _parse_requirement
 from ._tokenizer import ParserSyntaxError
 from .markers import Marker, _normalize_extra_values
-from .specifiers import InvalidSpecifier, SpecifierSet
+from .specifiers import InvalidSpecifier, Specifier, SpecifierSet
 from .utils import canonicalize_name
 
 if TYPE_CHECKING:
     from collections.abc import Iterator
 
+    from typing_extensions import Self
+
 __all__ = [
     "InvalidRequirement",
     "Requirement",
@@ -106,6 +108,61 @@ class Requirement:
             self.marker = Marker.__new__(Marker)
             self.marker._markers = _normalize_extra_values(parsed.marker)
 
+    def __replace__(self, **changes: object) -> Self:
+        """Return a new requirement with the specified fields replaced.
+
+        Accepts ``name``, ``url``, ``extras``, ``specifier`` and ``marker`` as
+        keyword arguments, with the same types as the corresponding attributes.
+        Values are validated and normalized as when parsing a requirement.
+        Invalid or ambiguous values raise :class:`InvalidRequirement`.
+
+        Specifiers are copied, preserving explicit prerelease settings.
+        This method also supports :func:`copy.replace` on Python 3.13+.
+        """
+        fields = Requirement.__slots__
+        for field in changes:
+            if field not in fields:
+                raise TypeError(f"Unexpected field name: {field!r}")
+
+        values = {field: changes.get(field, getattr(self, field)) for field in fields}
+        if not (
+            isinstance(values["name"], str)
+            and (values["url"] is None or isinstance(values["url"], str))
+            and isinstance(values["extras"], set)
+            and all(isinstance(extra, str) for extra in values["extras"])
+            and isinstance(values["specifier"], SpecifierSet)
+            and (values["marker"] is None or isinstance(values["marker"], Marker))
+        ):
+            raise InvalidRequirement("Invalid requirement field types")
+
+        candidate = Requirement.__new__(Requirement)
+        for field in fields:
+            setattr(candidate, field, values[field])
+        # Clone before serialization, which can canonicalize a specifier set.
+        candidate.specifier = SpecifierSet(
+            (
+                Specifier(str(spec), prereleases=spec._prereleases)
+                for spec in candidate.specifier
+            ),
+            prereleases=candidate.specifier._prereleases,
+        )
+
+        parsed = Requirement(str(candidate))
+        # Parsing must not reinterpret a field as another field, or discard it.
+        if (
+            parsed.name != candidate.name
+            or parsed.url != candidate.url
+            or parsed.extras != candidate.extras
+            or str(parsed.specifier) != str(candidate.specifier)
+            or (parsed.marker is None) != (candidate.marker is None)
+        ):
+            raise InvalidRequirement("Requirement fields do not round-trip")
+
+        result = type(self)(str(parsed))
+        # The string form omits both levels of explicit prerelease overrides.
+        result.specifier = candidate.specifier
+        return result
+
     def _iter_parts(self, name: str) -> Iterator[str]:
         yield name
 
diff --git a/tests/test_requirements.py b/tests/test_requirements.py
index ad78c2b..b425ab0 100644
--- a/tests/test_requirements.py
+++ b/tests/test_requirements.py
@@ -4,6 +4,7 @@
 
 from __future__ import annotations
 
+import copy
 import pickle
 
 import pytest
@@ -1085,3 +1086,125 @@ def test_pickle_requirement_25_0_format_loads() -> None:
     assert str(r.specifier) == ">=2.0"
     assert r.marker is None
     assert r == Requirement("requests>=2.0")
+
+
+class TestRequirementReplace:
+    @pytest.mark.parametrize(
+        ("changes", "expected"),
+        [
+            ({}, 'requests[security]>=2; python_version >= "3"'),
+            ({"name": "flask"}, 'flask[security]>=2; python_version >= "3"'),
+            (
+                {"extras": {"Other_Extra"}},
+                'requests[Other_Extra]>=2; python_version >= "3"',
+            ),
+            ({"extras": set()}, 'requests>=2; python_version >= "3"'),
+            (
+                {"specifier": SpecifierSet(">=3")},
+                'requests[security]>=3; python_version >= "3"',
+            ),
+            ({"marker": None}, "requests[security]>=2"),
+            (
+                {"marker": Marker('extra == "Foo_Bar"')},
+                'requests[security]>=2; extra == "foo-bar"',
+            ),
+            (
+                {"url": "https://example.com/pkg", "specifier": SpecifierSet()},
+                'requests[security] @ https://example.com/pkg ; python_version >= "3"',
+            ),
+        ],
+    )
+    def test_fields(self, changes: dict[str, object], expected: str) -> None:
+        original = Requirement('requests[security]>=2; python_version >= "3"')
+        result = original.__replace__(**changes)
+        assert result is not original
+        assert str(result) == expected
+        assert result == Requirement(str(result))
+        assert str(original) == 'requests[security]>=2; python_version >= "3"'
+        assert result.extras is not original.extras
+        if result.marker is not None:
+            assert result.marker is not original.marker
+
+    def test_clear_url(self) -> None:
+        assert Requirement("foo @ https://example.com").__replace__(
+            url=None, specifier=SpecifierSet(">=1")
+        ) == Requirement("foo>=1")
+
+    @pytest.mark.parametrize(
+        "changes",
+        [
+            {"name": "not a name!"},
+            {"name": "foo[bar]"},
+            {"name": "foo>=1"},
+            {"name": " foo "},
+            {"extras": {"a,b"}},
+            {"extras": {""}},
+            {"url": ""},
+            {"url": 'https://example.com ; os_name == "posix"'},
+            {"url": "https://example.com", "specifier": SpecifierSet(">=1")},
+            {"name": None},
+            {"extras": ["a"]},
+            {"extras": {1}},
+            {"specifier": ">=1"},
+            {"marker": "invalid"},
+        ],
+    )
+    def test_invalid(self, changes: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("foo").__replace__(**changes)
+
+    def test_arguments(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("foo").__replace__(unknown="bar")
+        with pytest.raises(TypeError):
+            Requirement("foo").__replace__("bar")  # type: ignore[call-arg]
+
+    @pytest.mark.parametrize("replace_specifier", [False, True])
+    @pytest.mark.parametrize("set_override", [None, False, True])
+    @pytest.mark.parametrize("spec_override", [None, False, True])
+    def test_prereleases(
+        self,
+        replace_specifier: bool,
+        set_override: bool | None,
+        spec_override: bool | None,
+    ) -> None:
+        original = Requirement("foo>=1a1,<3")
+        specifiers = (
+            SpecifierSet(">=2a1,!=2.5") if replace_specifier else original.specifier
+        )
+        specifiers.prereleases = set_override
+        for spec in specifiers:
+            spec.prereleases = spec_override
+        result = (
+            original.__replace__(specifier=specifiers)
+            if replace_specifier
+            else original.__replace__()
+        )
+        assert result.specifier == specifiers
+        assert result.specifier is not specifiers
+        assert result.specifier._prereleases is set_override
+        for copied, source in zip(
+            sorted(result.specifier, key=str), sorted(specifiers, key=str), strict=True
+        ):
+            assert copied is not source
+            assert copied._prereleases is spec_override
+            copied.prereleases = not spec_override
+            assert source._prereleases is spec_override
+        result.specifier.prereleases = not set_override
+        assert specifiers._prereleases is set_override
+
+    def test_subclass(self) -> None:
+        class CustomRequirement(Requirement):
+            def __init__(self, requirement_string: str) -> None:
+                super().__init__(requirement_string)
+                self.initialized_name = self.name
+
+        result = CustomRequirement("foo").__replace__(name="bar")
+        assert isinstance(result, CustomRequirement)
+        assert result.initialized_name == "bar"
+
+    def test_copy_replace(self) -> None:
+        if not hasattr(copy, "replace"):
+            pytest.skip("copy.replace requires Python 3.13+")
+        result = copy.replace(Requirement("requests>=2"), specifier=SpecifierSet(">=3"))
+        assert result == Requirement("requests>=3")
