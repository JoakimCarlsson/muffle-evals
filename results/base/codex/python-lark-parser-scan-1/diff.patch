+class _ScanCallbackError(Exception):
+    def __init__(self, error):
+        self.error = error
+
+
+def _scan_callback(callback):
+    def checked(token):
+        try:
+            result = callback(token)
+        except Exception as error:
+            raise _ScanCallbackError(error) from error
+        if isinstance(result, Token) and any(getattr(result, attr, None) is None for attr in
+                ('start_pos', 'end_pos', 'line', 'column', 'end_line', 'end_column')):
+            raise LexError("Lexer callback did not preserve token positions")
+        return result
+    return checked
+
+
+class ScanMatch(Generic[_Return_T]):
+    """A non-empty grammar match and its absolute source range."""
+
+    range: Tuple[int, int]
+    value: _Return_T
+
+    def __init__(self, range: Tuple[int, int], value: _Return_T):
+        self.range = range
+        self.value = value
+
+    def __eq__(self, other):
+        if not isinstance(other, ScanMatch):
+            return NotImplemented
+        return self.range == other.range and self.value == other.value
+
+    def __repr__(self):
+        return 'ScanMatch(%r, %r)' % (self.range, self.value)
+
