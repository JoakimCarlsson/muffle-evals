+    def scan(self, text: TextOrSlice, start: Optional[str]=None) -> Iterator[ScanMatch[_Return_T]]:
+        """Yield non-overlapping grammar matches, choosing the earliest, longest match.
+
+        Only built-in basic and contextual LALR lexers are supported. Source
+        positions, including those in TextSlice inputs, refer to the whole text.
+        Lexer callbacks may run for candidates that are subsequently discarded.
+        A ValueError from a lexer callback rejects that candidate.
+        """
+        if self.options.parser != 'lalr':
+            raise ConfigurationError("scan() requires parser='lalr'")
+        if self.options.postlex is not None:
+            raise ConfigurationError("scan() does not support postlex")
+        if self.options.lexer not in ('basic', 'contextual'):
+            raise ConfigurationError("scan() requires a built-in basic or contextual lexer")
+        start = self.parser._verify_start(start)
+        text = TextSlice.cast_from(text)
+        return self._scan(text, start)
+
+    def _scan(self, text, start):
+        # Recognition uses no tree/transformer callbacks. Once the longest
+        # accepted token sequence is known, replay it exactly once with callbacks.
+        # This avoids copying or sharing mutable transformed values across probes.
+        probe = self.parse_interactive(None, start)
+        conf = copy(probe.parser_state.parse_conf)
+        conf.callbacks = {}
+
+        # At a candidate's first character, ignore patterns must not swallow a
+        # possible match. Subsequent tokens use the ordinary lexer unchanged.
+        first_conf = copy(self.lexer_conf)
+        first_conf.callbacks = {name: _scan_callback(callback)
+                                for name, callback in first_conf.callbacks.items()}
+        first_conf.ignore = []
+        allowed = probe.accepts() if self.options.lexer == 'contextual' else None
+        first_conf.terminals = [t for t in first_conf.terminals
+                                if t.name not in self.lexer_conf.ignore
+                                and (allowed is None or t.name in allowed)]
+        first_conf.skip_validation = True
+        first_lexer = BasicLexer(first_conf)
+
+        def scan_lexer(original):
+            cloned = copy(original)
+            cloned.user_callbacks = first_conf.callbacks
+            cloned._scanner = None
+            return cloned
+
+        if self.options.lexer == 'contextual':
+            lexers = {state: scan_lexer(original)
+                      for state, original in self.parser.lexer.lexers.items()}
+        else:
+            lexer = scan_lexer(self.parser.lexer)
+        pos = text.start
+        while pos < text.end:
+            cursor = self.parse_interactive(TextSlice(text.text, pos, text.end), start)
+            cursor.parser_state.parse_conf = conf
+            state = cursor.lexer_thread.state
+            tokens = []
+            best = 0
+            while True:
+                try:
+                    active = first_lexer if not tokens else (
+                        lexers[cursor.parser_state.position]
+                        if self.options.lexer == 'contextual' else lexer)
+                    token = active.next_token(state, cursor.parser_state)
+                except _ScanCallbackError as error:
+                    if isinstance(error.error, ValueError) and not isinstance(error.error, ConfigurationError):
+                        break
+                    raise error.error
+                except (UnexpectedInput, EOFError):
+                    break
+                if any(getattr(token, attr, None) is None for attr in
+                       ('start_pos', 'end_pos', 'line', 'column', 'end_line', 'end_column')):
+                    raise LexError("Lexer callback did not preserve token positions")
+                try:
+                    cursor.feed_token(token)
+                except UnexpectedInput:
+                    break
+                tokens.append(token)
+                trial = cursor.copy(deepcopy_values=False)
+                try:
+                    trial.feed_eof(token)
+                except UnexpectedInput:
+                    pass
+                else:
+                    best = len(tokens)
+            if best:
+                matched = tokens[:best]
+                result = self.parse_interactive(None, start)
+                for token in matched:
+                    result.feed_token(token)
+                value = result.feed_eof(matched[-1])
+                end = matched[-1].end_pos
+                yield ScanMatch((pos, end), value)
+                pos = end
+            else:
+                pos += 1
