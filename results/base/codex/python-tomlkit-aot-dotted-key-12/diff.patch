+@pytest.mark.parametrize("suffix", ["", "\n[other]\ny = 3\n"])
+def test_replace_dotted_key_with_aot_keeps_following_sibling(suffix: str) -> None:
+    doc = parse("a.b = 1\nc.d = 2\n" + suffix)
+    aot = tomlkit.aot()
+    table = tomlkit.table()
+    table["x"] = 9
+    aot.append(table)
+    doc["a"] = aot
+
+    rendered = tomlkit.dumps(doc)
+    assert rendered.index("c.d = 2") < rendered.index("[[a]]")
+    expected: dict[str, Any] = {"c": {"d": 2}, "a": [{"x": 9}]}
+    if suffix:
+        expected["other"] = {"y": 3}
+    assert doc.unwrap() == expected
+    assert parse(rendered).unwrap() == expected
+
+
