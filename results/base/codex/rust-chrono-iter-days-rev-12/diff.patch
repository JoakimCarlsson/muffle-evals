diff --git a/src/naive/date/tests.rs b/src/naive/date/tests.rs
index 0b47ca4..640879f 100644
--- a/src/naive/date/tests.rs
+++ b/src/naive/date/tests.rs
@@ -728,22 +728,63 @@ fn test_date_parse_from_str() {
     );
 }
 
+fn check_date_iterator(
+    mut iter: impl DoubleEndedIterator<Item = NaiveDate> + ExactSizeIterator + Clone,
+) {
+    let mut expected = iter.clone().collect::<Vec<_>>();
+    assert_eq!(iter.len(), expected.len());
+    let mut from_front = true;
+    while !expected.is_empty() {
+        if from_front {
+            assert_eq!(iter.next(), Some(expected.remove(0)));
+        } else {
+            assert_eq!(iter.next_back(), expected.pop());
+        }
+        assert_eq!(iter.size_hint(), (expected.len(), Some(expected.len())));
+        from_front = !from_front;
+    }
+    assert_eq!(iter.next(), None);
+    assert_eq!(iter.next_back(), None);
+    assert_eq!(iter.next(), None);
+}
+
 #[test]
 fn test_day_iterator_limit() {
-    assert_eq!(NaiveDate::from_ymd_opt(MAX_YEAR, 12, 29).unwrap().iter_days().take(4).count(), 2);
+    for days in 0..20 {
+        let start = NaiveDate::MAX.checked_sub_days(Days::new(days)).unwrap();
+        let iter = start.iter_days();
+        assert_eq!(iter.len(), days as usize);
+        check_date_iterator(iter);
+    }
+    let start = NaiveDate::from_ymd_opt(2025, 10, 10).unwrap();
+    let expected = start.iter_days().take(7).collect::<Vec<_>>();
     assert_eq!(
-        NaiveDate::from_ymd_opt(MIN_YEAR, 1, 3).unwrap().iter_days().rev().take(4).count(),
-        2
+        start.iter_days().take(7).rev().collect::<Vec<_>>(),
+        expected.into_iter().rev().collect::<Vec<_>>()
     );
+    assert_eq!(start.iter_days().next_back(), NaiveDate::MAX.pred_opt());
+    check_date_iterator(start.iter_days().take(7));
+    assert_eq!(NaiveDate::MIN.iter_days().next(), Some(NaiveDate::MIN));
 }
 
 #[test]
 fn test_week_iterator_limit() {
-    assert_eq!(NaiveDate::from_ymd_opt(MAX_YEAR, 12, 12).unwrap().iter_weeks().take(4).count(), 2);
+    for days in 0..30 {
+        let start = NaiveDate::MAX.checked_sub_days(Days::new(days)).unwrap();
+        let iter = start.iter_weeks();
+        assert_eq!(iter.len(), days as usize / 7);
+        check_date_iterator(iter);
+    }
+    let start = NaiveDate::from_ymd_opt(2025, 10, 10).unwrap();
+    let expected = start.iter_weeks().take(7).collect::<Vec<_>>();
     assert_eq!(
-        NaiveDate::from_ymd_opt(MIN_YEAR, 1, 15).unwrap().iter_weeks().rev().take(4).count(),
-        2
+        start.iter_weeks().take(7).rev().collect::<Vec<_>>(),
+        expected.into_iter().rev().collect::<Vec<_>>()
     );
+    let last = start.checked_add_days(Days::new((start.iter_weeks().len() as u64 - 1) * 7));
+    assert_eq!(start.iter_weeks().next_back(), last);
+    check_date_iterator(start.iter_weeks().take(7));
+    assert_eq!(NaiveDate::MIN.iter_weeks().next(), Some(NaiveDate::MIN));
 }
 
