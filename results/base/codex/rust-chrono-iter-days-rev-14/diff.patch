--- a/src/naive/date/tests.rs
+++ b/src/naive/date/tests.rs
@@ -729,21 +729,57 @@ fn test_date_parse_from_str() {
 }
 
 #[test]
-fn test_day_iterator_limit() {
-    assert_eq!(NaiveDate::from_ymd_opt(MAX_YEAR, 12, 29).unwrap().iter_days().take(4).count(), 2);
-    assert_eq!(
-        NaiveDate::from_ymd_opt(MIN_YEAR, 1, 3).unwrap().iter_days().rev().take(4).count(),
-        2
-    );
-}
+fn test_date_iterators() {
+    fn check(iter: impl DoubleEndedIterator<Item = NaiveDate> + ExactSizeIterator + Clone) {
+        let expected: Vec<_> = iter.clone().take(7).collect();
+        let reversed: Vec<_> = iter.clone().take(7).rev().collect();
+        assert_eq!(expected.iter().rev().copied().collect::<Vec<_>>(), reversed);
+
+        let mut ends = iter.clone();
+        let len = ends.len();
+        assert_eq!(ends.next(), expected.first().copied());
+        assert_eq!(ends.len(), len.saturating_sub(1));
+        if len > 1 {
+            assert_eq!(ends.next_back(), iter.clone().next_back());
+            assert_eq!(ends.len(), len - 2);
+        }
 
-#[test]
-fn test_week_iterator_limit() {
-    assert_eq!(NaiveDate::from_ymd_opt(MAX_YEAR, 12, 12).unwrap().iter_weeks().take(4).count(), 2);
-    assert_eq!(
-        NaiveDate::from_ymd_opt(MIN_YEAR, 1, 15).unwrap().iter_weeks().rev().take(4).count(),
-        2
-    );
+        if len <= 15 {
+            let mut expected = iter.clone().collect::<Vec<_>>().into_iter();
+            let mut dates = iter.clone();
+            while expected.len() > 0 {
+                assert_eq!(dates.next(), expected.next());
+                assert_eq!(dates.next_back(), expected.next_back());
+                assert_eq!(dates.len(), expected.len());
+            }
+            assert_eq!(dates.next(), None);
+            assert_eq!(dates.next_back(), None);
+        }
+
+        let mut exhausted = iter.clone();
+        assert_eq!(exhausted.nth(usize::MAX), None);
+        assert_eq!(exhausted.len(), 0);
+        assert_eq!(exhausted.next_back(), None);
+        let mut exhausted = iter;
+        assert_eq!(exhausted.nth_back(usize::MAX), None);
+        assert_eq!(exhausted.len(), 0);
+        assert_eq!(exhausted.next(), None);
+    }
+
+    for start in [NaiveDate::MIN, NaiveDate::from_ymd_opt(2025, 10, 10).unwrap()] {
+        check(start.iter_days());
+        check(start.iter_weeks());
+        assert_eq!(start.iter_days().next_back(), Some(NaiveDate::MAX));
+    }
+    for days in 0..15 {
+        let start = NaiveDate::MAX.checked_sub_days(Days::new(days)).unwrap();
+        check(start.iter_days());
+        check(start.iter_weeks());
+        assert_eq!(start.iter_days().count(), days as usize + 1);
+        assert_eq!(start.iter_weeks().count(), days as usize / 7 + 1);
+        assert_eq!(start.iter_days().last(), Some(NaiveDate::MAX));
+        assert_eq!(start.iter_weeks().last(), start.iter_weeks().next_back());
+    }
 }
 
