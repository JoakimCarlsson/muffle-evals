@@ -730,20 +730,69 @@ fn test_date_parse_from_str() {
 
 #[test]
 fn test_day_iterator_limit() {
-    assert_eq!(NaiveDate::from_ymd_opt(MAX_YEAR, 12, 29).unwrap().iter_days().take(4).count(), 2);
-    assert_eq!(
-        NaiveDate::from_ymd_opt(MIN_YEAR, 1, 3).unwrap().iter_days().rev().take(4).count(),
-        2
-    );
+    let start = NaiveDate::from_ymd_opt(MAX_YEAR, 12, 29).unwrap();
+    let expected = [start, start.succ_opt().unwrap()];
+    assert_eq!(start.iter_days().collect::<Vec<_>>(), expected);
+    assert_eq!(start.iter_days().rev().collect::<Vec<_>>(), [expected[1], expected[0]]);
+    assert_eq!(NaiveDate::MAX.iter_days().next(), None);
+    assert_eq!(NaiveDate::MAX.iter_days().next_back(), None);
 }
 
 #[test]
 fn test_week_iterator_limit() {
-    assert_eq!(NaiveDate::from_ymd_opt(MAX_YEAR, 12, 12).unwrap().iter_weeks().take(4).count(), 2);
-    assert_eq!(
-        NaiveDate::from_ymd_opt(MIN_YEAR, 1, 15).unwrap().iter_weeks().rev().take(4).count(),
-        2
-    );
+    // Exercise every alignment of the upper bound with the weekly step.
+    for offset in 0..21 {
+        let start = NaiveDate::MAX.checked_sub_days(Days::new(offset)).unwrap();
+        let expected: Vec<_> =
+            (0..offset / 7).map(|i| start.checked_add_days(Days::new(i * 7)).unwrap()).collect();
+        assert_eq!(start.iter_weeks().collect::<Vec<_>>(), expected);
+        assert_eq!(
+            start.iter_weeks().rev().collect::<Vec<_>>(),
+            expected.into_iter().rev().collect::<Vec<_>>()
+        );
+    }
+}
+
+#[test]
+fn test_date_iterators_double_ended() {
+    fn check(mut iter: impl DoubleEndedIterator<Item = NaiveDate> + ExactSizeIterator + Clone) {
+        let mut expected: Vec<_> = iter.clone().collect();
+        let mut from_front = true;
+        while !expected.is_empty() {
+            assert_eq!(iter.len(), expected.len());
+            assert_eq!(iter.size_hint(), (expected.len(), Some(expected.len())));
+            if from_front {
+                assert_eq!(iter.next(), Some(expected.remove(0)));
+            } else {
+                assert_eq!(iter.next_back(), expected.pop());
+            }
+            from_front = !from_front;
+        }
+        assert_eq!(iter.len(), 0);
+        assert_eq!(iter.size_hint(), (0, Some(0)));
+        assert_eq!(iter.next(), None);
+        assert_eq!(iter.next_back(), None);
+        assert_eq!(iter.next(), None);
+    }
+
+    let start = NaiveDate::from_ymd_opt(2025, 10, 10).unwrap();
+    let mut days: Vec<_> = start.iter_days().take(7).collect();
+    days.reverse();
+    assert_eq!(start.iter_days().take(7).rev().collect::<Vec<_>>(), days);
+    let mut weeks: Vec<_> = start.iter_weeks().take(7).collect();
+    weeks.reverse();
+    assert_eq!(start.iter_weeks().take(7).rev().collect::<Vec<_>>(), weeks);
+    assert_eq!(start.iter_days().next_back(), NaiveDate::MAX.pred_opt());
+
+    for offset in 0..21 {
+        let near_max = NaiveDate::MAX.checked_sub_days(Days::new(offset)).unwrap();
+        check(near_max.iter_days());
+        check(near_max.iter_weeks());
+    }
+    check(NaiveDate::MIN.iter_days().take(7));
+    check(NaiveDate::MIN.iter_weeks().take(7));
+    check(start.iter_days().take(7));
+    check(start.iter_weeks().take(7));
 }
 
 #[test]
