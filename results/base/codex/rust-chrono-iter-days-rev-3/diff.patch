+#[test]
+fn test_date_iterators_double_ended() {
+    fn check(mut iter: impl DoubleEndedIterator<Item = NaiveDate> + ExactSizeIterator + Clone) {
+        let mut exhausted = iter.clone();
+        assert_eq!(exhausted.nth_back(usize::MAX), None);
+        assert_eq!(exhausted.len(), 0);
+        assert_eq!(exhausted.next(), None);
+        assert_eq!(exhausted.next_back(), None);
+        for n in 0..iter.len() {
+            let mut skipped = iter.clone();
+            assert_eq!(skipped.nth_back(n), iter.clone().nth(iter.len() - n - 1));
+            assert_eq!(skipped.len(), iter.len() - n - 1);
+        }
+        let mut expected = iter.clone();
+        let mut remaining = iter.len();
+        while remaining > 0 {
+            assert_eq!(iter.size_hint(), (remaining, Some(remaining)));
+            assert_eq!(iter.next(), expected.next());
+            remaining -= 1;
+            if remaining > 0 {
+                assert_eq!(iter.next_back(), expected.clone().nth(remaining - 1));
+                remaining -= 1;
+            }
+        }
+        assert_eq!(iter.len(), 0);
+        assert_eq!(iter.size_hint(), (0, Some(0)));
+        assert_eq!(iter.next(), None);
+        assert_eq!(iter.next_back(), None);
+        assert_eq!(iter.next(), None);
+    }
+
+    let start = NaiveDate::from_ymd_opt(2025, 10, 10).unwrap();
+    let expected_days = (0..7).rev().map(|n| start + Days::new(n));
+    assert!(start.iter_days().take(7).rev().eq(expected_days));
+    let expected_weeks = (0..7).rev().map(|n| start + Days::new(n * 7));
+    assert!(start.iter_weeks().take(7).rev().eq(expected_weeks));
+
+    for days_from_max in 0..30 {
+        let start = NaiveDate::MAX - Days::new(days_from_max);
+        let days = start.iter_days();
+        assert_eq!(days.len(), days.clone().count());
+        assert!(days.clone().rev().eq((0..days_from_max).rev().map(|n| start + Days::new(n))));
+        check(days);
+        let weeks = start.iter_weeks();
+        assert_eq!(weeks.len(), weeks.clone().count());
+        assert!(
+            weeks.clone().rev().eq((0..days_from_max / 7).rev().map(|n| start + Days::new(n * 7)))
+        );
+        check(weeks);
+    }
+    assert_eq!(NaiveDate::MIN.iter_days().next(), Some(NaiveDate::MIN));
+    assert_eq!(NaiveDate::MIN.iter_days().next_back(), NaiveDate::MAX.pred_opt());
+    assert_eq!(NaiveDate::MIN.iter_weeks().next(), Some(NaiveDate::MIN));
+}
