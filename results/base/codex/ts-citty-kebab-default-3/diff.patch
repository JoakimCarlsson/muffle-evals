diff --git a/test/args.test.ts b/test/args.test.ts
index 732572c..980d5c7 100644
--- a/test/args.test.ts
+++ b/test/args.test.ts
@@ -99,4 +99,38 @@ describe("args", () => {
     expect(parsed.userName).toBe("Jane");
     expect(parsed._).toEqual([]);
   });
+
+  it.each(["fooBar", "foo-bar"])("should override defaults through aliases of %s", (name) => {
+    const definition: ArgsDef = {
+      [name]: { type: "enum", options: ["one", "two"], default: "two", alias: "f" },
+    };
+
+    for (const flag of ["--fooBar", "--foo-bar", "-f"]) {
+      expect(parseArgs([flag, "one"], definition)).toEqual({
+        _: [],
+        fooBar: "one",
+        "foo-bar": "one",
+        f: "one",
+      });
+    }
+
+    expect(parseArgs([], definition)).toEqual({
+      _: [],
+      fooBar: "two",
+      "foo-bar": "two",
+      f: "two",
+    });
+
+    expect(() => parseArgs(["--foo-bar", "three"], definition)).toThrowError(
+      "Invalid value for argument:",
+    );
+  });
+
+  it("should override a false default through a kebab-case boolean alias", () => {
+    expect(parseArgs(["--foo-bar"], { fooBar: { type: "boolean", default: false } })).toEqual({
+      _: [],
+      fooBar: true,
+      "foo-bar": true,
+    });
+  });
 });
