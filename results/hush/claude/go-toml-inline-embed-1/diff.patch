+
+func TestUnmarshalEmbeddedInlineTag(t *testing.T) {
+	type Base struct {
+		Region string
+		BsPort int
+	}
+	type Config struct {
+		Base `toml:",inline"`
+		PID  uint32
+	}
+	var c Config
+	err := toml.Unmarshal([]byte("Region = \"us\"\nBsPort = 100\nPID = 42\n"), &c)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c.Region != "us" || c.BsPort != 100 || c.PID != 42 {
+		t.Fatalf("got %+v", c)
+	}
+}
