+        line_ctr = LineCounter(b'\n' if isinstance(text.text, bytes) else '\n')
+        if text.start > 0:
+            line_ctr.feed(TextSlice(text.text, 0, text.start))
+        pos = text.start
+        while pos < text.end:
+            found = first_lexer.scan_start(LexerState(text, copy(line_ctr)))
+            if found is None:
