+    def _scan(self, text: TextSlice, start: str, first_lexer: BasicLexer, lexers) -> Iterator[ScanMatch]:
+        parse_table = self.parser._parse_table
+        states = parse_table.states
+        start_state = parse_table.start_states[start]
+        end_state = parse_table.end_states[start]
