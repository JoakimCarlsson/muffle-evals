+def _lalr_feed(states, stack: list, token_type: str) -> bool:
+    "Feed a token type to a stack of LALR states. Returns False if it isn't accepted."
+    while True:
+        try:
+            action, arg = states[stack[-1]][token_type]
+        except KeyError:
+            return False
+        if action is Shift:
+            stack.append(arg)
+            return True
+        size = len(arg.expansion)
+        if size:
+            del stack[-size:]
+        stack.append(states[stack[-1]][arg.origin.name][1])
+
+
+def _lalr_accepts(states, stack: list, end_state) -> bool:
+    "Check if the end of input would be accepted, without changing the stack."
+    if '$END' not in states[stack[-1]]:
+        return False
+    stack = list(stack)
+    while True:
+        try:
+            action, arg = states[stack[-1]]['$END']
+        except KeyError:
+            return False
+        if action is Shift:
+            return False
+        size = len(arg.expansion)
+        if size:
+            del stack[-size:]
+        stack.append(states[stack[-1]][arg.origin.name][1])
+        if stack[-1] == end_state:
+            return True
