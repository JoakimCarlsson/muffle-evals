+    def scan(self, text: TextOrSlice, start: Optional[str]=None) -> Iterator['ScanMatch[_Return_T]']:
+        """Find the grammar's matches inside a larger text, like a regex search.
+
+        Yields non-overlapping matches, in order. Each match is the longest prefix that parses,
+        from the earliest position where one starts. Text that doesn't parse is skipped.
+        A match is never empty, and never starts or ends with an ignored terminal.
+
+        Only works with parser='lalr', and lexer='basic' or 'contextual' (no postlex).
+
+        Parameters:
+            text (str, bytes or TextSlice): Text to scan. For a TextSlice, only the slice is scanned,
+                and positions are relative to the whole text.
+            start (str, optional): Required if Lark was given multiple possible start symbols.
+
+        Returns:
+            An iterator of ``ScanMatch(range=(start, end), value=...)``, where value is the same
+            as what ``parse()`` returns for the matched text.
+
+        :raises ConfigurationError: If Lark's configuration doesn't support scanning.
+            Raised immediately, not when the iterator is first used.
+
+        Callbacks (``lexer_callbacks``, and the transformer's terminal callbacks) may be called
+        for text that ends up not matching. A callback that raises ValueError marks the token as invalid.
+        """
+        if self.options.parser is None:
+            raise ConfigurationError("scan() doesn't work with parser=None (lexer only)")
+        if self.options.parser != 'lalr':
+            raise ConfigurationError("scan() only works with parser='lalr'")
+        return self.parser.scan(text, start=start)
+
 
