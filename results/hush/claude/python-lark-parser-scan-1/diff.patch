+        def attempt(line_ctr: LineCounter) -> List[Token]:
+            lex_state = LexerState(text, copy(line_ctr))
+            stack = [start_state]
+            tokens: List[Token] = []
+            longest = 0
+            lexer = first_lexer
+            while True:
+                token = lexer.scan_token(lex_state)
+                if token is None:
+                    break
+                cb = token_callbacks.get(token.type)
+                if cb is not None:
+                    try:
+                        cb(Token.new_borrow_pos(token.type, token.value, token))
+                    except ConfigurationError:
+                        raise
+                    except ValueError:
+                        break
+                if not _lalr_feed(states, stack, token.type):
+                    break
+                tokens.append(token)
+                if _lalr_accepts(states, stack, end_state):
