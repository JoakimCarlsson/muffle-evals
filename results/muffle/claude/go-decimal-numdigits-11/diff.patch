+
+func TestNumDigitsMatchesCoefficientText(t *testing.T) {
+	for _, s := range []string{
+		"0", "9", "10", "-10", "-9223372036854775808", "9223372036854775807",
+		"100000000000000E20", "1000000000000000E20", "10000000000000000E20",
+		"99999999999999999999", "100000000000000000000", "-100000000000000000000",
+	} {
+		d, err := NewFromString(s)
+		if err != nil {
+			t.Fatal(err)
+		}
+		want := len(new(big.Int).Abs(d.Coefficient()).Text(10))
+		if got := d.NumDigits(); got != want {
+			t.Errorf("%s: NumDigits() = %d, want %d", s, got, want)
+		}
+	}
+	for e := 0; e < 60; e++ {
+		v := new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(e)), nil)
+		for _, x := range []*big.Int{v, new(big.Int).Sub(v, big.NewInt(1))} {
+			d := NewFromBigInt(x, 0)
+			want := len(x.Text(10))
+			if got := d.NumDigits(); got != want {
+				t.Errorf("%s: NumDigits() = %d, want %d", x, got, want)
+			}
+		}
+	}
+}
