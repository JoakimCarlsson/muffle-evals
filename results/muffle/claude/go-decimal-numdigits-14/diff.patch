+
+func TestDecimal_NumDigitsPowersOfTen(t *testing.T) {
+	for i := 0; i < 80; i++ {
+		v := new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(i)), nil)
+		for _, c := range []*big.Int{v, new(big.Int).Neg(v), new(big.Int).Sub(v, big.NewInt(1))} {
+			if c.Sign() == 0 {
+				continue
+			}
+			want := len(new(big.Int).Abs(c).Text(10))
+			if got := NewFromBigInt(c, 20).NumDigits(); got != want {
+				t.Errorf("NumDigits(%s) = %d, want %d", c, got, want)
+			}
+		}
+	}
+}
