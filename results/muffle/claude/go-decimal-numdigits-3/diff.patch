diff --git a/decimal.go b/decimal.go
index 880d569..1e13553 100644
--- a/decimal.go
+++ b/decimal.go
@@ -1251,6 +1251,11 @@ func (d Decimal) Ln(precision int32) (Decimal, error) {
 	return comp1.Round(precision), nil
 }
 
+// pow10Uint64 holds the powers of ten from 10^0 up to 10^16, enough to cover |i| <= 2^53.
+var pow10Uint64 = [...]uint64{
+	1, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11, 1e12, 1e13, 1e14, 1e15, 1e16,
+}
+
 // NumDigits returns the number of digits of the decimal coefficient (d.Value)
 func (d Decimal) NumDigits() int {
 	v := d.getValue()
@@ -1261,7 +1266,18 @@ func (d Decimal) NumDigits() int {
 			if i64 == 0 {
 				return 1
 			}
-			return int(math.Log10(math.Abs(float64(i64)))) + 1
+			u := uint64(i64)
+			if i64 < 0 {
+				u = uint64(-i64)
+			}
+			n := int(math.Log10(float64(u))) + 1
+			// math.Log10 is not exact near powers of ten, correct the estimate
+			if n < len(pow10Uint64) && u >= pow10Uint64[n] {
+				n++
+			} else if u < pow10Uint64[n-1] {
+				n--
+			}
+			return n
 		}
 	}
 
