--- a/decimal_test.go
+++ b/decimal_test.go
@@ -3962,3 +3962,29 @@ func ExampleNewFromFloat() {
 	//0.123123123123123
 	//-10000000000000
 }
+
+func TestDecimal_NumDigitsExact(t *testing.T) {
+	for _, s := range []string{"100000000000000E20", "1000000000000000E20", "10000000000000000E20"} {
+		d, err := NewFromString(s)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if want, got := len(d.Coefficient().Text(10)), d.NumDigits(); want != got {
+			t.Errorf("%s: want %d digits, got %d", s, want, got)
+		}
+	}
+	for i := 0; i <= 17; i++ {
+		for _, m := range []int64{-1, 0, 1} {
+			v := new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(i)), nil)
+			v.Add(v, big.NewInt(m))
+			d := NewFromBigInt(v, 0)
+			if want, got := len(new(big.Int).Abs(v).Text(10)), d.NumDigits(); want != got {
+				t.Errorf("%s: want %d digits, got %d", v, want, got)
+			}
+			d = d.Neg()
+			if want, got := len(new(big.Int).Abs(v).Text(10)), d.NumDigits(); want != got {
+				t.Errorf("-%s: want %d digits, got %d", v, want, got)
+			}
+		}
+	}
+}
