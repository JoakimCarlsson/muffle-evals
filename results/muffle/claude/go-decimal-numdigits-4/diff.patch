+
+func TestNumDigitsPowersOfTen(t *testing.T) {
+	for _, neg := range []string{"", "-"} {
+		for i := 0; i < 80; i++ {
+			s := neg + "1" + strings.Repeat("0", i)
+			d := RequireFromString(s)
+			if got := d.NumDigits(); got != i+1 {
+				t.Errorf("NumDigits(%s) = %d, want %d", s, got, i+1)
+			}
+			s = neg + strings.Repeat("9", i+1)
+			d = RequireFromString(s)
+			if got := d.NumDigits(); got != i+1 {
+				t.Errorf("NumDigits(%s) = %d, want %d", s, got, i+1)
+			}
+		}
+	}
+	d := RequireFromString("1000000000000000E20")
+	if got := d.NumDigits(); got != 16 {
+		t.Errorf("NumDigits(%s) = %d, want 16", d, got)
+	}
+}
