+func TestWithFullJitter(t *testing.T) {
+	t.Parallel()
+
+	for i := 0; i < 1000; i++ {
+		b := retry.WithFullJitter(retry.BackoffFunc(func() (time.Duration, bool) {
+			return 10 * time.Second, false
+		}))
+
+		val, stop := b.Next()
+		if stop {
+			t.Fatal("should not stop")
+		}
+		if val < 0 || val >= 10*time.Second {
+			t.Errorf("expected %v to be in [0, 10s)", val)
+		}
+	}
+}
+
+func TestWithFullJitter_Stop(t *testing.T) {
+	t.Parallel()
+
+	b := retry.WithFullJitter(retry.BackoffFunc(func() (time.Duration, bool) {
+		return 10 * time.Second, true
+	}))
+
+	if _, stop := b.Next(); !stop {
+		t.Error("expected stop")
+	}
+}
+
+func TestWithFullJitter_NonPositive(t *testing.T) {
+	t.Parallel()
+
+	for _, base := range []time.Duration{0, -5 * time.Second} {
+		b := retry.WithFullJitter(retry.BackoffFunc(func() (time.Duration, bool) {
+			return base, false
+		}))
+
+		val, stop := b.Next()
+		if stop {
+			t.Fatal("should not stop")
+		}
+		if val != base {
+			t.Errorf("expected %v, got %v", base, val)
+		}
+	}
+}
+
+func ExampleWithFullJitter() {
