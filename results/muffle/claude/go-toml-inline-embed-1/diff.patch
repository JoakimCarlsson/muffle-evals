+
+func TestUnmarshalEmbeddedInlineTag(t *testing.T) {
+	type Base struct {
+		Region string
+		Name   string
+		BsPort int
+	}
+	type Config struct {
+		Base  `toml:",inline"`
+		PID   uint32
+		index int `toml:"-"`
+	}
+	var c Config
+	err := toml.Unmarshal([]byte("Region = \"us\"\nName = \"srv1\"\nBsPort = 100\nPID = 42\n"), &c)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c.Region != "us" || c.Name != "srv1" || c.BsPort != 100 || c.PID != 42 {
+		t.Fatalf("unexpected result: %+v", c)
+	}
+	_ = c.index
+}
