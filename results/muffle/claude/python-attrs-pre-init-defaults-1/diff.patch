diff --git a/tests/test_make.py b/tests/test_make.py
index 80c0066..96d2e6a 100644
--- a/tests/test_make.py
+++ b/tests/test_make.py
@@ -2749,3 +2749,21 @@ class TestMatchArgs:
 
         C1 = make_class("C1", {"a": attr.ib(kw_only=True), "b": attr.ib()})
         assert ("b",) == C1.__match_args__
+
+
+class TestPreInitPassedValues:
+    def test_passed_values_with_defaults(self):
+        seen = {}
+
+        @attr.s
+        class C:
+            a = attr.ib()
+            b = attr.ib(default=100)
+            c = attr.ib(default=1, kw_only=True)
+
+            def __attrs_pre_init__(self, a, b, c):
+                seen.update(a=a, b=b, c=c)
+
+        C(1, 2, c=3)
+
+        assert {"a": 1, "b": 2, "c": 3} == seen
