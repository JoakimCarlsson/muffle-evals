diff --git a/tests/test_requirements.py b/tests/test_requirements.py
index ad78c2b..d22b179 100644
--- a/tests/test_requirements.py
+++ b/tests/test_requirements.py
@@ -1085,3 +1085,56 @@ def test_pickle_requirement_25_0_format_loads() -> None:
     assert str(r.specifier) == ">=2.0"
     assert r.marker is None
     assert r == Requirement("requests>=2.0")
+
+
+class TestRequirementReplace:
+    def test_replace_name_and_noop(self) -> None:
+        r = Requirement('requests[security]>=2.0; python_version >= "3"')
+        assert str(r.__replace__(name="flask")) == (
+            'flask[security]>=2.0; python_version >= "3"'
+        )
+        same = r.__replace__()
+        assert same == r
+        assert same is not r
+        assert same.specifier is not r.specifier
+        assert same.extras is not r.extras
+
+    def test_unknown_keyword(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("a").__replace__(foo=1)  # type: ignore[call-arg]
+
+    @pytest.mark.parametrize(
+        "kwargs",
+        [
+            {"name": "not a name!"},
+            {"name": "foo[bar]"},
+            {"extras": {"a,b"}},
+            {"url": "http://example.com"},  # existing specifier
+        ],
+    )
+    def test_invalid(self, kwargs: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("a>=1").__replace__(**kwargs)  # type: ignore[arg-type]
+
+    def test_marker_normalized(self) -> None:
+        r = Requirement("a").__replace__(marker=Marker('extra == "Foo_Bar"'))
+        assert str(r.marker) == 'extra == "foo-bar"'
+
+    def test_specifier_prereleases_preserved_and_copied(self) -> None:
+        ss = SpecifierSet(">=1,<3", prereleases=True)
+        next(iter(ss)).prereleases = False  # the first specifier in the set
+        r = Requirement("a").__replace__(specifier=ss)
+        assert r.specifier is not ss
+        assert r.specifier.prereleases is True
+        assert {str(s): s._prereleases for s in r.specifier} == {">=1": False, "<3": None}
+        assert all(a is not b for a in r.specifier for b in ss)
+
+    def test_subclass(self) -> None:
+        class Sub(Requirement):
+            def __init__(self, s: str) -> None:
+                super().__init__(s)
+                self.extra_attr = 1
+
+        r = Sub("a").__replace__(name="b")
+        assert type(r) is Sub
+        assert r.extra_attr == 1
