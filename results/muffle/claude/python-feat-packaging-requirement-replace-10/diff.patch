+    def __replace__(
+        self,
+        /,
+        *,
+        name: str = _UNSET,
+        url: str | None = _UNSET,
+        extras: Iterable[str] = _UNSET,
+        specifier: SpecifierSet = _UNSET,
+        marker: Marker | None = _UNSET,
+    ) -> Self:
+        """Return a copy with the given fields replaced.
+
+        Fields that are not passed are kept. The original is not modified, and
+        the result shares no mutable state (``extras``, ``specifier`` and its
+        specifiers) with it. Values are validated and normalized as if the
+        resulting requirement string had been parsed.
+
+        >>> Requirement("requests[security]>=2.0").__replace__(name="flask")
+        <Requirement('flask[security]>=2.0')>
+
+        :raises InvalidRequirement: If the result would not be a valid
+            requirement, or would parse back to different values.
+
+        .. versionadded:: 26.3
+        """
+        if name is _UNSET:
+            name = self.name
+        elif not isinstance(name, str):
+            raise TypeError(f"name must be a str, not {type(name).__name__}")
+        if url is _UNSET:
+            url = self.url
+        elif url is not None and not isinstance(url, str):
+            raise TypeError(f"url must be a str or None, not {type(url).__name__}")
+        url = url or None
+        if extras is _UNSET:
+            new_extras = set(self.extras)
+        elif isinstance(extras, str):
+            raise TypeError("extras must be an iterable of str, not a str")
+        else:
+            new_extras = set(extras)
+            if not all(isinstance(e, str) for e in new_extras):
+                raise TypeError("extras must only contain str")
+        if specifier is _UNSET:
+            specifier = self.specifier
+        elif not isinstance(specifier, SpecifierSet):
+            raise TypeError(
+                f"specifier must be a SpecifierSet, not {type(specifier).__name__}"
+            )
+        if marker is _UNSET:
+            marker = self.marker
+        elif marker is not None and not isinstance(marker, Marker):
+            raise TypeError(
+                f"marker must be a Marker or None, not {type(marker).__name__}"
+            )
+
+        # Copy the specifier set and its specifiers, keeping every
+        # ``prereleases`` setting, so nothing is shared with the input.
+        new_specifier = SpecifierSet(
+            [Specifier(str(s), prereleases=s._prereleases) for s in specifier],
+            prereleases=specifier._prereleases,
+        )
+
+        # Build the string form and parse it, so the result is exactly what
+        # parsing would give. Then make sure nothing was reinterpreted.
+        parts = Requirement.__new__(Requirement)
+        parts.name, parts.url, parts.extras = name, url, new_extras
+        parts.specifier, parts.marker = new_specifier, marker
+        result = type(self)(str(parts))
+        if (
+            result.name != name
+            or result.url != url
+            or result.extras != new_extras
+            or result.specifier != new_specifier
+            or (result.marker is None) != (marker is None)
+        ):
+            raise InvalidRequirement(
+                f"Replacement values do not round-trip: {str(parts)!r}"
+            )
+        result.specifier = new_specifier
+        return result
+
     def __getstate__(self) -> tuple[str, bool | None]:
