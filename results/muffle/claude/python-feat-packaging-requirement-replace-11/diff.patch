 class InvalidRequirement(ValueError):
     """
     Raised when attempting to create a :class:`Requirement` with a string that
@@ -106,6 +109,69 @@ class Requirement:
             self.marker = Marker.__new__(Marker)
             self.marker._markers = _normalize_extra_values(parsed.marker)
 
+    def __replace__(
+        self,
+        *,
+        name: str = _UNSET,
+        url: str | None = _UNSET,
+        extras: set[str] = _UNSET,
+        specifier: SpecifierSet = _UNSET,
+        marker: Marker | None = _UNSET,
+    ) -> Requirement:
+        """Return a copy of this requirement with the given fields replaced.
+
+        Fields that are not given are kept. The original is not modified, and
+        the result shares no mutable state with it or with the arguments.
+        This is what :func:`copy.replace` calls on Python 3.13+.
+
+        :raises InvalidRequirement: If the resulting requirement is not valid,
+            or a value would not read back unchanged from the requirement
+            string (for example ``name="foo[bar]"``).
+        """
+        if name is _UNSET:
+            name = self.name
+        if url is _UNSET:
+            url = self.url
+        if extras is _UNSET:
+            extras = self.extras
+        if specifier is _UNSET:
+            specifier = self.specifier
+        if marker is _UNSET:
+            marker = self.marker
+
+        if not isinstance(name, str):
+            raise InvalidRequirement(f"Invalid name: {name!r}")
+        if url is not None and not isinstance(url, str):
+            raise InvalidRequirement(f"Invalid url: {url!r}")
+        if isinstance(extras, str) or not all(isinstance(e, str) for e in extras):  # type: ignore[redundant-expr]
+            raise InvalidRequirement(f"Invalid extras: {extras!r}")
+        extras = set(extras)
+        if not isinstance(specifier, SpecifierSet):
+            raise InvalidRequirement(f"Invalid specifier: {specifier!r}")
+        if marker is not None and not isinstance(marker, Marker):
+            raise InvalidRequirement(f"Invalid marker: {marker!r}")
+
+        # Copy so the result shares no Specifier or SpecifierSet with the input,
+        # keeping the explicit prereleases overrides, which the string drops.
+        specifier_copy = SpecifierSet(
+            [Specifier(str(s), prereleases=s._prereleases) for s in specifier],
+            prereleases=specifier._prereleases,
+        )
+
+        # Round-trip through the parser so the result is exactly what parsing
+        # its string would give, normalization included.
+        parts = Requirement.__new__(Requirement)
+        parts.name, parts.url, parts.extras = name, url, extras
+        parts.specifier, parts.marker = specifier_copy, marker
+        new = self.__class__(str(parts))
+
+        if new.name != name or new.url != url or new.extras != extras:
+            raise InvalidRequirement(
+                f"Replacement values do not round-trip: {str(parts)!r}"
+            )
+        new.specifier = specifier_copy
+        return new
+
     def _iter_parts(self, name: str) -> Iterator[str]:
         yield name
 
