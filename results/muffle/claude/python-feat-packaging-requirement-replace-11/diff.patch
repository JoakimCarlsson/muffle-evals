+
+
+class TestReplace:
+    def test_replace_fields(self) -> None:
+        r = Requirement('requests[security]>=2.0; python_version >= "3"')
+        assert (
+            str(r.__replace__(name="flask"))
+            == 'flask[security]>=2.0; python_version >= "3"'
+        )
+        assert str(r) == 'requests[security]>=2.0; python_version >= "3"'
+        assert (
+            str(r.__replace__(extras=set())) == 'requests>=2.0; python_version >= "3"'
+        )
+        assert str(r.__replace__(marker=None)) == "requests[security]>=2.0"
+        url = Requirement("a").__replace__(url="https://x/y.whl")
+        assert str(url) == "a @ https://x/y.whl"
+
+    def test_copy_replace(self) -> None:
+        if not hasattr(copy, "replace"):
+            pytest.skip("copy.replace needs Python 3.13+")
+        new = copy.replace(Requirement("requests>=2.0"), specifier=SpecifierSet(">=3"))
+        assert str(new) == "requests>=3"
+
+    def test_no_arguments(self) -> None:
+        r = Requirement("a[b]>=1; os_name == 'x'")
+        new = r.__replace__()
+        assert new == r
+        assert new is not r
+        assert new.extras is not r.extras
+        assert new.specifier is not r.specifier
+
+    def test_unknown_keyword(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("a").__replace__(foo=1)  # type: ignore[call-arg]
+        with pytest.raises(TypeError):
+            Requirement("a").__replace__("b")  # type: ignore[misc]
+
+    @pytest.mark.parametrize(
+        "kwargs",
+        [
+            {"name": "not a name!"},
+            {"name": "foo[bar]"},
+            {"name": " foo"},
+            {"extras": {"a,b"}},
+            {"extras": {"a b"}},
+            {"extras": "abc"},
+            {"url": "https://x ; os_name == 'y'"},
+            {"url": "https://x"},  # a specifier cannot be combined with a URL
+            {"name": 1},
+            {"specifier": ">=1"},
+            {"marker": 'os_name == "x"'},
+        ],
+    )
+    def test_invalid(self, kwargs: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("a>=1").__replace__(**kwargs)  # type: ignore[arg-type]
+
+    def test_marker_normalized(self) -> None:
+        new = Requirement("a").__replace__(marker=Marker('extra == "Foo_Bar"'))
+        assert str(new.marker) == 'extra == "foo-bar"'
+
+    @pytest.mark.parametrize("carried", [True, False])
+    def test_specifier_prereleases_and_isolation(self, carried: bool) -> None:
+        spec = SpecifierSet(
+            [Specifier(">=1", prereleases=False), Specifier("<3", prereleases=True)],
+            prereleases=True,
+        )
+        r = Requirement("a")
+        r.specifier = spec
+        new = (
+            r.__replace__() if carried else Requirement("b").__replace__(specifier=spec)
+        )
+        assert new.specifier is not spec
+        assert new.specifier._prereleases is True
+        assert {str(s): s._prereleases for s in new.specifier} == {
+            ">=1": False,
+            "<3": True,
+        }
+        assert not {id(s) for s in new.specifier} & {id(s) for s in spec}
+
+    def test_subclass(self) -> None:
+        class Sub(Requirement):
+            def __init__(self, requirement_string: str) -> None:
+                super().__init__(requirement_string)
+                self.tag = "set"
+
+        new = Sub("a").__replace__(name="b")
+        assert type(new) is Sub
+        assert new.tag == "set"
+        assert new.name == "b"
