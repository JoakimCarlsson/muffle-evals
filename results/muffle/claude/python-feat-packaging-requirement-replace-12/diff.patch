+    def __replace__(
+        self,
+        *,
+        name: str = _UNSET,
+        url: str | None = _UNSET,
+        extras: Iterable[str] = _UNSET,
+        specifier: SpecifierSet = _UNSET,
+        marker: Marker | None = _UNSET,
+    ) -> Requirement:
+        """Return a copy of this requirement with the given fields replaced.
+
+        Fields that are not passed are kept. The original is not modified, and
+        the result shares no mutable state with it or with the arguments.
+        Values are validated and normalized as if the resulting requirement
+        string had been parsed.
+
+        >>> Requirement("requests[security]>=2.0").__replace__(name="flask")
+        <Requirement('flask[security]>=2.0')>
+
+        :param name: The new name.
+        :param url: The new URL, or ``None`` to remove it.
+        :param extras: The new extras.
+        :param specifier: The new :class:`~.SpecifierSet`. Its
+            :attr:`~.SpecifierSet.prereleases` settings, and those of its
+            specifiers, are preserved.
+        :param marker: The new :class:`~.Marker`, or ``None`` to remove it.
+        :raises InvalidRequirement: If the resulting requirement is not valid,
+            or a value would be read back as something different (for example
+            ``name="foo[bar]"``).
+        :raises TypeError: If an unknown keyword is passed, or a value has the
+            wrong type.
+
+        .. versionadded:: 26.4
+        """
+        if name is _UNSET:
+            name = self.name
+        elif not isinstance(name, str):
+            raise TypeError(f"name must be a str, not {type(name).__name__}")
+
+        if url is _UNSET:
+            url = self.url
+        elif url is not None and not isinstance(url, str):
+            raise TypeError(f"url must be a str or None, not {type(url).__name__}")
+        url = url or None
+
+        if extras is _UNSET:
+            extras = self.extras
+        elif isinstance(extras, str):
+            raise TypeError("extras must be an iterable of str, not a str")
+        new_extras = set(extras)
+        if not all(isinstance(e, str) for e in new_extras):
+            raise TypeError("extras must only contain str")
+
+        if specifier is _UNSET:
+            specifier = self.specifier
+        elif not isinstance(specifier, SpecifierSet):
+            raise TypeError(
+                f"specifier must be a SpecifierSet, not {type(specifier).__name__}"
+            )
+
+        if marker is _UNSET:
+            marker = self.marker
+        elif marker is not None and not isinstance(marker, Marker):
+            raise TypeError(
+                f"marker must be a Marker or None, not {type(marker).__name__}"
+            )
+
+        # Copy the specifiers so the result shares nothing with the input and
+        # keeps each prereleases override, which the string form drops.
+        try:
+            new_specifier = SpecifierSet(
+                [
+                    Specifier(str(s), prereleases=getattr(s, "_prereleases", None))
+                    for s in specifier._specs
+                ],
+                prereleases=specifier._prereleases,
+            )
+        except InvalidSpecifier as e:
+            raise InvalidRequirement(str(e)) from e
+
+        parts = [name]
+        if new_extras:
+            parts.append(f"[{','.join(sorted(new_extras))}]")
+        if new_specifier:
+            parts.append(str(new_specifier))
+        if url:
+            parts.append(f" @ {url}")
+            if marker:
+                parts.append(" ")
+        if marker:
+            parts.append(f"; {marker}")
+
+        # Parsing (through the subclass' __init__) validates and normalizes.
+        new = type(self)("".join(parts))
+
+        # Reject values that parsed as something other than what was given.
+        if (
+            new.name != name
+            or new.url != url
+            or new.extras != new_extras
+            or str(new.specifier) != str(new_specifier)
+        ):
+            raise InvalidRequirement(
+                f"Cannot represent the given values as a requirement: {new!s}"
+            )
+
+        new.specifier = new_specifier
+        return new
+
     def __getstate__(self) -> tuple[str, bool | None]:
