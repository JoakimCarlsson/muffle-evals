diff --git a/tests/test_requirements.py b/tests/test_requirements.py
index ad78c2b..4854fa6 100644
--- a/tests/test_requirements.py
+++ b/tests/test_requirements.py
@@ -1085,3 +1085,115 @@ def test_pickle_requirement_25_0_format_loads() -> None:
     assert str(r.specifier) == ">=2.0"
     assert r.marker is None
     assert r == Requirement("requests>=2.0")
+
+
+class TestRequirementReplace:
+    def test_issue_examples(self) -> None:
+        r = Requirement('requests[security]>=2.0; python_version >= "3"')
+        assert str(r.__replace__(name="flask")) == (
+            'flask[security]>=2.0; python_version >= "3"'
+        )
+        assert str(r) == 'requests[security]>=2.0; python_version >= "3"'
+
+    def test_no_args_equal_but_distinct(self) -> None:
+        r = Requirement('a[b]>=1; os_name == "x"')
+        new = r.__replace__()
+        assert new == r
+        assert new is not r
+        assert new.specifier is not r.specifier
+        assert new.extras is not r.extras
+        assert new.marker is not r.marker
+
+    def test_each_field(self) -> None:
+        r = Requirement("a>=1")
+        assert str(r.__replace__(extras={"x", "y"})) == "a[x,y]>=1"
+        assert str(r.__replace__(marker=Marker('os_name == "x"'))) == (
+            'a>=1; os_name == "x"'
+        )
+        assert str(r.__replace__(specifier=SpecifierSet())) == "a"
+        u = Requirement("a @ http://x/y ; os_name == 'x'")
+        assert u.__replace__(url=None, specifier=SpecifierSet(">1")).url is None
+        assert str(r.__replace__(specifier=SpecifierSet(), url="http://x/y")) == (
+            "a @ http://x/y"
+        )
+
+    def test_copy_replace(self) -> None:
+        copy = pytest.importorskip("copy")
+        if not hasattr(copy, "replace"):
+            pytest.skip("copy.replace needs Python 3.13+")
+        new = copy.replace(Requirement("requests>=2.0"), specifier=SpecifierSet(">=3"))
+        assert str(new) == "requests>=3"
+
+    def test_unknown_keyword(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("a").__replace__(foo=1)  # type: ignore[call-arg]
+        with pytest.raises(TypeError):
+            Requirement("a").__replace__("b")  # type: ignore[call-arg]
+
+    @pytest.mark.parametrize(
+        "kwargs",
+        [
+            {"name": "not a name!"},
+            {"name": ""},
+            {"name": "foo[bar]"},
+            {"name": "foo>=1"},
+            {"name": " foo"},
+            {"extras": {"a,b"}},
+            {"extras": {"a b"}},
+            {"extras": {""}},
+            {"url": "http://x y"},
+            {"url": "http://x ; os_name == 'x'"},
+            {"specifier": SpecifierSet(">=1"), "url": "http://x"},
+        ],
+    )
+    def test_invalid(self, kwargs: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("a").__replace__(**kwargs)  # type: ignore[arg-type]
+
+    def test_wrong_types(self) -> None:
+        r = Requirement("a")
+        with pytest.raises(TypeError):
+            r.__replace__(extras="abc")
+        with pytest.raises(TypeError):
+            r.__replace__(name=1)  # type: ignore[arg-type]
+        with pytest.raises(TypeError):
+            r.__replace__(specifier=">=1")  # type: ignore[arg-type]
+        with pytest.raises(TypeError):
+            r.__replace__(marker="os_name == 'x'")  # type: ignore[arg-type]
+
+    def test_normalizes_marker(self) -> None:
+        r = Requirement("a").__replace__(marker=Marker('extra == "Foo_Bar"'))
+        assert str(r.marker) == 'extra == "foo-bar"'
+
+    def test_prereleases_preserved_and_not_shared(self) -> None:
+        spec = SpecifierSet(">=1,<3", prereleases=True)
+        spec_list = list(spec)
+        spec_list[0].prereleases = False
+        r = Requirement("a").__replace__(specifier=spec)
+        assert r.specifier.prereleases is True
+        assert r.specifier is not spec
+        assert [s.prereleases for s in r.specifier] == [s.prereleases for s in spec]
+        assert {id(s) for s in r.specifier}.isdisjoint(id(s) for s in spec)
+        # carried over, too
+        again = r.__replace__(name="b")
+        assert again.specifier.prereleases is True
+        assert [s._prereleases for s in again.specifier._specs] == [
+            s._prereleases for s in r.specifier._specs
+        ]
+        assert {id(s) for s in again.specifier}.isdisjoint(id(s) for s in r.specifier)
+        # mutating the original does not leak
+        spec.prereleases = False
+        assert r.specifier.prereleases is True
+
+    def test_subclass(self) -> None:
+        class Sub(Requirement):
+            __slots__ = ("extra_attr",)
+
+            def __init__(self, requirement_string: str) -> None:
+                super().__init__(requirement_string)
+                self.extra_attr = "set"
+
+        new = Sub("a>=1").__replace__(name="b")
+        assert type(new) is Sub
+        assert new.extra_attr == "set"
+        assert str(new) == "b>=1"
