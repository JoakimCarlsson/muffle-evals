+
+
+class TestRequirementReplace:
+    def test_replace_name_and_unchanged(self) -> None:
+        r = Requirement('requests[security]>=2.0; python_version >= "3"')
+        assert str(r.__replace__(name="flask")) == (
+            'flask[security]>=2.0; python_version >= "3"'
+        )
+        assert r.name == "requests"
+        same = r.__replace__()
+        assert same == r
+        assert same is not r
+
+    def test_unknown_keyword(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("a").__replace__(foo=1)  # type: ignore[call-arg]
+
+    @pytest.mark.parametrize(
+        "kwargs",
+        [{"name": "not a name!"}, {"name": "foo[bar]"}, {"extras": {"a,b"}}],
+    )
+    def test_invalid(self, kwargs: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("a").__replace__(**kwargs)  # type: ignore[arg-type]
+
+    def test_marker_normalized(self) -> None:
+        r = Requirement("a").__replace__(marker=Marker('extra == "Foo_Bar"'))
+        assert str(r) == 'a; extra == "foo-bar"'
+
+    def test_specifier_prereleases_not_shared(self) -> None:
+        ss = SpecifierSet(">=1,<3", prereleases=True)
+        ss._specs[0].prereleases = False
+        r = Requirement("a").__replace__(specifier=ss)
+        assert r.specifier is not ss
+        assert r.specifier.prereleases is True
+        assert {s._prereleases for s in r.specifier._specs} == {None, False}
+        assert all(a is not b for a in r.specifier._specs for b in ss._specs)
+
+    def test_subclass(self) -> None:
+        class Sub(Requirement):
+            def __init__(self, s: str) -> None:
+                super().__init__(s)
+                self.extra_attr = 1
+
+        r = Sub("a").__replace__(name="b")
+        assert type(r) is Sub
+        assert r.extra_attr == 1
