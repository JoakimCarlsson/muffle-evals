+def _copy_specifier_set(specifier: SpecifierSet) -> SpecifierSet:
+    """Deep copy a SpecifierSet, keeping ``prereleases`` on the set and its members."""
+    specs = []
+    for spec in specifier._specs:
+        new_spec = Specifier(str(spec))
+        new_spec._prereleases = spec._prereleases
+        specs.append(new_spec)
+    new = SpecifierSet(specs)
+    new._prereleases = specifier._prereleases
+    return new
+
+
+def _check_extras(extras: Iterable[str]) -> list[str]:
+    if isinstance(extras, str):
+        raise TypeError("extras must be an iterable of str, not a str")
+    result = list(extras)
+    if not all(isinstance(e, str) for e in result):
+        raise TypeError("extras must only contain str")
+    return result
+
