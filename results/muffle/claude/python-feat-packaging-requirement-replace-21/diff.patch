@@ -1085,3 +1085,64 @@ def test_pickle_requirement_25_0_format_loads() -> None:
     assert str(r.specifier) == ">=2.0"
     assert r.marker is None
     assert r == Requirement("requests>=2.0")
+
+
+class TestRequirementReplace:
+    def test_replace_name_keeps_rest(self) -> None:
+        r = Requirement('requests[security]>=2.0; python_version >= "3"')
+        new = r.__replace__(name="flask")
+        assert str(new) == 'flask[security]>=2.0; python_version >= "3"'
+        assert r.name == "requests"
+
+    def test_no_args_equal_but_distinct(self) -> None:
+        r = Requirement("foo>=1")
+        new = r.__replace__()
+        assert new == r
+        assert new is not r
+        assert new.specifier is not r.specifier
+
+    def test_unknown_keyword(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("foo").__replace__(bar=1)
+
+    @pytest.mark.parametrize(
+        "changes",
+        [
+            {"name": "not a name!"},
+            {"name": "foo[bar]"},
+            {"extras": {"a,b"}},
+            {"url": "http://x ; python_version > '3'"},
+        ],
+    )
+    def test_invalid(self, changes: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("foo").__replace__(**changes)
+
+    def test_marker_normalized(self) -> None:
+        new = Requirement("foo").__replace__(marker=Marker('extra == "Foo_Bar"'))
+        assert str(new.marker) == 'extra == "foo-bar"'
+
+    def test_specifier_prereleases_copied(self) -> None:
+        spec = SpecifierSet(
+            [Specifier(">=1", prereleases=True), Specifier("<3")], prereleases=False
+        )
+        new = Requirement("foo").__replace__(specifier=spec)
+        assert new.specifier is not spec
+        assert new.specifier._prereleases is False
+        by_str = {str(s): s for s in new.specifier}
+        assert by_str[">=1"]._prereleases is True
+        assert by_str["<3"]._prereleases is None
+        assert all(a is not b for a, b in zip(new.specifier, spec))
+        kept = new.__replace__(name="bar")
+        assert kept.specifier._prereleases is False
+        assert {str(s): s for s in kept.specifier}[">=1"]._prereleases is True
+
+    def test_subclass(self) -> None:
+        class Sub(Requirement):
+            def __init__(self, s: str) -> None:
+                super().__init__(s)
+                self.extra_state = 1
+
+        new = Sub("foo").__replace__(name="bar")
+        assert type(new) is Sub
+        assert new.extra_state == 1
