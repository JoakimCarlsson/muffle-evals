diff --git a/tests/test_requirements.py b/tests/test_requirements.py
index ad78c2b..02a5c9e 100644
--- a/tests/test_requirements.py
+++ b/tests/test_requirements.py
@@ -1085,3 +1085,60 @@ def test_pickle_requirement_25_0_format_loads() -> None:
     assert str(r.specifier) == ">=2.0"
     assert r.marker is None
     assert r == Requirement("requests>=2.0")
+
+
+class TestRequirementReplace:
+    def test_no_changes_equal_but_distinct(self) -> None:
+        r = Requirement('requests[security]>=2.0; python_version >= "3"')
+        copy_ = r.__replace__()
+        assert copy_ == r
+        assert copy_ is not r
+        assert copy_.specifier is not r.specifier
+
+    def test_replace_name(self) -> None:
+        r = Requirement('requests[security]>=2.0; python_version >= "3"')
+        assert str(r.__replace__(name="flask")) == (
+            'flask[security]>=2.0; python_version >= "3"'
+        )
+        assert r.name == "requests"
+
+    def test_replace_normalizes_marker(self) -> None:
+        r = Requirement("foo").__replace__(marker=Marker('extra == "Foo_Bar"'))
+        assert str(r.marker) == 'extra == "foo-bar"'
+
+    def test_unknown_keyword(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("foo").__replace__(bogus=1)
+
+    @pytest.mark.parametrize(
+        "changes",
+        [
+            {"name": "not a name!"},
+            {"name": "foo[bar]"},
+            {"extras": {"a,b"}},
+            {"url": "a b"},
+        ],
+    )
+    def test_invalid(self, changes: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("foo").__replace__(**changes)
+
+    def test_specifier_not_shared_keeps_prereleases(self) -> None:
+        ss = SpecifierSet(">=1,<3", prereleases=True)
+        ss_inner = next(iter(ss))
+        ss_inner._prereleases = False
+        new = Requirement("foo").__replace__(specifier=ss)
+        assert new.specifier is not ss
+        assert new.specifier._prereleases is True
+        assert all(a is not b for a in new.specifier for b in ss)
+        assert any(s._prereleases is False for s in new.specifier)
+
+    def test_subclass(self) -> None:
+        class Sub(Requirement):
+            def __init__(self, s: str) -> None:
+                super().__init__(s)
+                self.extra_attr = 1
+
+        new = Sub("foo").__replace__(name="bar")
+        assert type(new) is Sub
+        assert new.extra_attr == 1
