+def _copy_specifier_set(source: SpecifierSet) -> SpecifierSet:
+    """Copy a SpecifierSet and its Specifiers, keeping ``prereleases`` overrides."""
+    specs = [
+        (
+            Specifier(str(spec), prereleases=spec._prereleases)
+            if isinstance(spec, Specifier)
+            else Specifier(str(spec))
+        )
+        for spec in source
+    ]
+    return SpecifierSet(specs, prereleases=source._prereleases)
