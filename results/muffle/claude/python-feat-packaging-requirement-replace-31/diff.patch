+    def __replace__(
+        self,
+        *,
+        name: str = _UNSET,
+        url: str | None = _UNSET,
+        extras: set[str] = _UNSET,
+        specifier: SpecifierSet = _UNSET,
+        marker: Marker | None = _UNSET,
+    ) -> Requirement:
+        """Return a copy of this requirement with the given fields replaced.
+
+        Fields that are not given are kept. The result is validated as if it
+        had been parsed from its string form.
+
+        :raises InvalidRequirement: If the resulting requirement is not valid,
+            or if a value would be read back as something different.
+
+        .. versionadded:: 26.4
+        """
+        new_name = self.name if name is _UNSET else name
+        new_url = self.url if url is _UNSET else url
+        new_extras = self.extras if extras is _UNSET else extras
+        new_specifier = self.specifier if specifier is _UNSET else specifier
+        new_marker = self.marker if marker is _UNSET else marker
+
+        if not isinstance(new_name, str):
+            raise InvalidRequirement(f"Invalid name: {new_name!r}")
+        if new_url is not None and not isinstance(new_url, str):
+            raise InvalidRequirement(f"Invalid url: {new_url!r}")
+        if isinstance(new_extras, str) or not all(
+            isinstance(e, str) for e in new_extras
+        ):
+            raise InvalidRequirement(f"Invalid extras: {new_extras!r}")
+        new_extras = set(new_extras)
+        if not isinstance(new_specifier, SpecifierSet):
+            raise InvalidRequirement(f"Invalid specifier: {new_specifier!r}")
+        if new_marker is not None and not isinstance(new_marker, Marker):
+            raise InvalidRequirement(f"Invalid marker: {new_marker!r}")
+
+        # Serialize the candidate and parse it back, so that validation and
+        # normalization are exactly those of parsing.
+        candidate = Requirement.__new__(Requirement)
+        candidate.name = new_name
+        candidate.url = new_url
+        candidate.extras = new_extras
+        candidate.specifier = new_specifier
+        candidate.marker = new_marker
+        result = self.__class__(str(candidate))
+
+        # Reject values that were read back as something different, such as
+        # ``name="foo[bar]"`` or ``extras={"a,b"}``.
+        if (
+            result.name != new_name
+            or result.url != new_url
+            or result.extras != new_extras
+            or result.specifier != new_specifier
+            or (result.marker is None) != (new_marker is None)
+        ):
+            raise InvalidRequirement(f"Invalid replacement for {str(self)!r}")
+
+        # The string form drops ``prereleases`` overrides; restore them on
+        # fresh copies so nothing is shared with the input.
+        result.specifier = _copy_specifier_set(new_specifier)
+        return result
