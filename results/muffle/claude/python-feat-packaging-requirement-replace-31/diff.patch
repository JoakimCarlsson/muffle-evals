+class TestRequirementReplace:
+    def test_replace_name_and_noop(self) -> None:
+        r = Requirement('requests[security]>=2.0; python_version >= "3"')
+        assert str(r.__replace__(name="flask")) == (
+            'flask[security]>=2.0; python_version >= "3"'
+        )
+        same = r.__replace__()
+        assert same == r
+        assert same is not r
+        assert same.specifier is not r.specifier
+
+    def test_invalid(self) -> None:
+        r = Requirement("foo")
+        for kw in (
+            {"name": "not a name!"},
+            {"name": "foo[bar]"},
+            {"extras": {"a,b"}},
+            {"url": ""},
+        ):
+            with pytest.raises(InvalidRequirement):
+                r.__replace__(**kw)
+        with pytest.raises(TypeError):
+            r.__replace__(bogus=1)  # type: ignore[call-arg]
+
+    def test_marker_normalized(self) -> None:
+        r = Requirement("foo").__replace__(marker=Marker('extra == "Foo_Bar"'))
+        assert str(r.marker) == 'extra == "foo-bar"'
+
+    def test_prereleases_kept_not_shared(self) -> None:
+        spec = SpecifierSet(">=1", prereleases=True)
+        spec._specs[0].prereleases = False
+        r = Requirement("foo").__replace__(specifier=spec)
+        assert r.specifier is not spec
+        assert r.specifier._prereleases is True
+        assert r.specifier._specs[0]._prereleases is False
+        assert all(a is not b for a, b in zip(r.specifier._specs, spec._specs))
+        assert r.__replace__().specifier._specs[0]._prereleases is False
+
+    def test_subclass_and_copy_replace(self) -> None:
+        class Sub(Requirement):
+            def __init__(self, s: str) -> None:
+                super().__init__(s)
+                self.extra_attr = 1
+
+        r = Sub("foo").__replace__(name="bar")
+        assert type(r) is Sub
+        assert r.extra_attr == 1
+        if hasattr(copy, "replace"):
+            assert str(copy.replace(Requirement("a>=2"), name="b")) == "b>=2"
