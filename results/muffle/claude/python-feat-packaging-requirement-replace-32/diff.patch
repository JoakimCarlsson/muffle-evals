@@ -4,6 +4,7 @@
 
 from __future__ import annotations
 
+import copy
 import pickle
 
 import pytest
@@ -1085,3 +1086,114 @@ def test_pickle_requirement_25_0_format_loads() -> None:
     assert str(r.specifier) == ">=2.0"
     assert r.marker is None
     assert r == Requirement("requests>=2.0")
+
+
+class TestRequirementReplace:
+    def test_example(self) -> None:
+        r = Requirement('requests[security]>=2.0; python_version >= "3"')
+        assert str(r.__replace__(name="flask")) == (
+            'flask[security]>=2.0; python_version >= "3"'
+        )
+        assert str(r) == 'requests[security]>=2.0; python_version >= "3"'
+
+    def test_copy_replace(self) -> None:
+        copy_replace = getattr(copy, "replace", None)
+        if copy_replace is None:
+            pytest.skip("copy.replace requires Python 3.13+")
+        r = copy_replace(Requirement("requests>=2.0"), specifier=SpecifierSet(">=3.0"))
+        assert str(r) == "requests>=3.0"
+
+    def test_no_arguments(self) -> None:
+        r = Requirement("a[b]>=1; os_name == 'nt'")
+        new = r.__replace__()
+        assert new == r
+        assert new is not r
+        assert new.extras is not r.extras
+        assert new.specifier is not r.specifier
+
+    def test_each_field(self) -> None:
+        r = Requirement("a[b]>=1")
+        assert r.__replace__(extras={"c", "d"}).extras == {"c", "d"}
+        assert str(r.__replace__(marker=Marker("os_name == 'nt'"))) == (
+            'a[b]>=1; os_name == "nt"'
+        )
+        assert str(r.__replace__(url="http://x/a.whl", specifier=SpecifierSet())) == (
+            "a[b] @ http://x/a.whl"
+        )
+        assert r.__replace__(marker=None).marker is None
+        assert Requirement("a @ http://x").__replace__(url=None).url is None
+
+    def test_unknown_keyword(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("a").__replace__(foo=1)  # type: ignore[call-arg]
+        with pytest.raises(TypeError):
+            Requirement("a").__replace__("b")  # type: ignore[misc]
+
+    @pytest.mark.parametrize(
+        "kwargs",
+        [
+            {"name": "not a name!"},
+            {"name": "foo[bar]"},
+            {"name": "foo; os_name == 'nt'"},
+            {"name": ""},
+            {"extras": {"a,b"}},
+            {"extras": {"a b"}},
+            {"extras": {"a]"}},
+            {"url": ""},
+            {"url": "http://x; os_name == 'nt'"},
+            {"url": "http://x"},  # a specifier cannot be combined with a URL
+        ],
+    )
+    def test_invalid(self, kwargs: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("a>=1").__replace__(**kwargs)  # type: ignore[arg-type]
+
+    @pytest.mark.parametrize(
+        "kwargs",
+        [
+            {"name": 1},
+            {"url": 1},
+            {"extras": "abc"},
+            {"extras": [1]},
+            {"specifier": ">=1"},
+            {"marker": "os_name == 'nt'"},
+        ],
+    )
+    def test_wrong_type(self, kwargs: dict[str, object]) -> None:
+        with pytest.raises(TypeError):
+            Requirement("a").__replace__(**kwargs)  # type: ignore[arg-type]
+
+    def test_marker_normalized(self) -> None:
+        r = Requirement("a").__replace__(marker=Marker('extra == "Foo_Bar"'))
+        assert str(r.marker) == 'extra == "foo-bar"'
+
+    def test_prereleases_preserved_and_not_shared(self) -> None:
+        specifier = SpecifierSet(">=1,<3", prereleases=True)
+        specifier._specs[0].prereleases = False
+        r = Requirement("a").__replace__(specifier=specifier)
+        assert r.specifier is not specifier
+        assert r.specifier._prereleases is True
+        by_str = {str(s): s for s in r.specifier}
+        assert by_str[">=1"]._prereleases is False
+        assert by_str["<3"]._prereleases is None
+        assert not any(s is o for s in r.specifier for o in specifier)
+
+        # Carried over, too.
+        kept = r.__replace__(name="b")
+        assert kept.specifier is not r.specifier
+        assert kept.specifier._prereleases is True
+        assert {str(s): s._prereleases for s in kept.specifier} == {
+            ">=1": False,
+            "<3": None,
+        }
+        assert not any(s is o for s in kept.specifier for o in r.specifier)
+
+    def test_subclass(self) -> None:
+        class Sub(Requirement):
+            def __init__(self, requirement_string: str) -> None:
+                super().__init__(requirement_string)
+                self.extra_state = "set"
+
+        new = Sub("a").__replace__(name="b")
+        assert type(new) is Sub
+        assert new.extra_state == "set"
