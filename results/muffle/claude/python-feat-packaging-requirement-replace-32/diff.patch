@@ -106,6 +113,107 @@ class Requirement:
             self.marker = Marker.__new__(Marker)
             self.marker._markers = _normalize_extra_values(parsed.marker)
 
+    def __replace__(
+        self,
+        *,
+        name: str = _UNSET,
+        url: str | None = _UNSET,
+        extras: Iterable[str] = _UNSET,
+        specifier: SpecifierSet = _UNSET,
+        marker: Marker | None = _UNSET,
+    ) -> Self:
+        """
+        __replace__(*, name=..., url=..., extras=..., specifier=..., marker=...)
+
+        Return a new requirement with the given parts replaced.
+
+        Parts that are not given are kept, and this requirement is not
+        modified. The result is validated like a parsed requirement string, so
+        values that are invalid, or that would read back as something
+        different (for example ``name="foo[bar]"``), raise
+        :exc:`InvalidRequirement`. Markers are normalized as when parsing.
+        The specifier set and its specifiers are copied, keeping their
+        ``prereleases`` settings. Subclasses get an instance of their own
+        class.
+
+        >>> r = Requirement('requests[security]>=2.0')
+        >>> r.__replace__(name="flask")
+        <Requirement('flask[security]>=2.0')>
+
+        :param str name:
+        :param str | None url:
+        :param Iterable[str] extras:
+        :param SpecifierSet specifier:
+        :param Marker | None marker:
+        :raises InvalidRequirement: If the result is not a valid requirement.
+        :raises TypeError: If a value has the wrong type.
+
+        .. versionadded:: 26.3
+        """
+        if name is _UNSET:
+            name = self.name
+        elif not isinstance(name, str):
+            raise TypeError(f"name must be a str, not {type(name).__name__}")
+        if url is _UNSET:
+            url = self.url
+        elif url is not None and not isinstance(url, str):
+            raise TypeError(f"url must be a str or None, not {type(url).__name__}")
+        if extras is _UNSET:
+            new_extras = set(self.extras)
+        elif isinstance(extras, str):
+            raise TypeError("extras must be an iterable of str, not a str")
+        else:
+            new_extras = set(extras)
+            if not all(isinstance(e, str) for e in new_extras):
+                raise TypeError("extras must only contain str")
+        if specifier is _UNSET:
+            specifier = self.specifier
+        elif not isinstance(specifier, SpecifierSet):
+            raise TypeError(
+                f"specifier must be a SpecifierSet, not {type(specifier).__name__}"
+            )
+        if marker is _UNSET:
+            marker = self.marker
+        elif marker is not None and not isinstance(marker, Marker):
+            raise TypeError(
+                f"marker must be a Marker or None, not {type(marker).__name__}"
+            )
+
+        # Copy so the result shares no mutable state with the input.
+        new_specifier = SpecifierSet(
+            (Specifier(str(s), s._prereleases) for s in specifier._specs),
+            specifier._prereleases,
+        )
+
+        # Render the candidate and re-parse it, so it is exactly what parsing
+        # its string gives (and subclass __init__ runs).
+        candidate = Requirement.__new__(Requirement)
+        candidate.name = name
+        candidate.url = url
+        candidate.extras = new_extras
+        candidate.specifier = new_specifier
+        candidate.marker = marker
+        try:
+            result = type(self)("".join(Requirement._iter_parts(candidate, name)))
+        except InvalidRequirement as e:
+            raise InvalidRequirement(f"Invalid replacement: {e}") from e
+
+        # Anything that did not survive the round trip would silently change
+        # another field (e.g. name="foo[bar]", extras={"a,b"}).
+        if (
+            result.name != name
+            or result.url != url
+            or result.extras != new_extras
+            or (result.marker is None) != (marker is None)
+        ):
+            raise InvalidRequirement(
+                f"Invalid replacement: {str(candidate)!r} does not parse back "
+                "to the given values"
+            )
+
+        result.specifier = new_specifier
+        return result
+
     def _iter_parts(self, name: str) -> Iterator[str]:
         yield name
 
