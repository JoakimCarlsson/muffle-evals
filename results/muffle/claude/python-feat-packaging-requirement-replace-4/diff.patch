+    def __replace__(
+        self,
+        *,
+        name: str = _UNSET,
+        url: str | None = _UNSET,
+        extras: Iterable[str] = _UNSET,
+        specifier: SpecifierSet = _UNSET,
+        marker: Marker | None = _UNSET,
+    ) -> Requirement:
+        """Return a copy of this requirement with the given fields replaced.
+
+        Fields that are not passed are kept. The result is validated as if its
+        string form had been parsed, and does not share mutable state with
+        ``self`` or the arguments. Subclasses get an instance of their own
+        class.
+
+        :raises InvalidRequirement: If the resulting requirement is not valid,
+            or a value would be read back as something different.
+        :raises TypeError: If a value has the wrong type.
+
+        .. versionadded:: 26.3
+        """
+        if name is _UNSET:
+            name = self.name
+        if url is _UNSET:
+            url = self.url
+        if extras is _UNSET:
+            extras = self.extras
+        if specifier is _UNSET:
+            specifier = self.specifier
+        if marker is _UNSET:
+            marker = self.marker
+
+        if not isinstance(name, str):
+            raise TypeError(f"name must be a str, not {type(name).__name__}")
+        if url is not None and not isinstance(url, str):
+            raise TypeError(f"url must be a str or None, not {type(url).__name__}")
+        if isinstance(extras, str) or not hasattr(extras, "__iter__"):
+            raise TypeError("extras must be an iterable of str")
+        new_extras = set(extras)
+        if not all(isinstance(e, str) for e in new_extras):
+            raise TypeError("extras must be an iterable of str")
+        if not isinstance(specifier, SpecifierSet):
+            raise TypeError(
+                f"specifier must be a SpecifierSet, not {type(specifier).__name__}"
+            )
+        if marker is not None and not isinstance(marker, Marker):
+            raise TypeError(
+                f"marker must be a Marker or None, not {type(marker).__name__}"
+            )
+        url = url or None
+
+        new_specifier = _copy_specifier_set(specifier)
+
+        parts = [name]
+        if new_extras:
+            parts.append(f"[{','.join(sorted(new_extras))}]")
+        if new_specifier:
+            parts.append(str(new_specifier))
+        if url:
+            parts.append(f" @ {url}")
+            if marker:
+                parts.append(" ")
+        if marker:
+            parts.append(f"; {marker}")
+
+        # Parsing the string form guarantees the result is valid and that
+        # values are normalized exactly as when parsing.
+        result = self.__class__("".join(parts))
+
+        # Reject values that were read back as something different, such as
+        # ``name="foo[bar]"`` or ``extras={"a,b"}``.
+        if (
+            result.name != name
+            or result.url != url
+            or result.extras != new_extras
+            or result.specifier != new_specifier
+            or (result.marker is None) != (marker is None)
+        ):
+            raise InvalidRequirement(
+                f"Replaced values do not form a consistent requirement: {parts!r}"
+            )
+
+        result.specifier = new_specifier
+        return result
+
