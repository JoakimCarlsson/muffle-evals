+class TestReplace:
+    def test_replace_fields(self) -> None:
+        r = Requirement('requests[security]>=2.0; python_version >= "3"')
+        assert str(r.__replace__(name="flask")) == (
+            'flask[security]>=2.0; python_version >= "3"'
+        )
+        assert r.__replace__(extras={"a"}).extras == {"a"}
+        assert r.__replace__(marker=None).marker is None
+        assert str(r) == 'requests[security]>=2.0; python_version >= "3"'
+
+    def test_replace_url(self) -> None:
+        r = Requirement("a @ http://x")
+        assert r.__replace__(url=None).url is None
+        assert Requirement("a").__replace__(url="http://y").url == "http://y"
+
+    def test_no_args_equal_but_distinct(self) -> None:
+        r = Requirement("a[x]>=1; os_name == 'a'")
+        c = r.__replace__()
+        assert c == r
+        assert c is not r
+        assert c.extras is not r.extras
+        assert c.specifier is not r.specifier
+
+    def test_copy_replace(self) -> None:
+        if not hasattr(copy, "replace"):
+            pytest.skip("copy.replace needs Python 3.13+")
+        r = copy.replace(Requirement("requests>=2.0"), specifier=SpecifierSet(">=3.0"))
+        assert str(r) == "requests>=3.0"
+
+    def test_unknown_keyword(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("a").__replace__(foo=1)  # type: ignore[call-arg]
+        with pytest.raises(TypeError):
+            Requirement("a").__replace__("b")  # type: ignore[misc]
+
+    @pytest.mark.parametrize(
+        "kwargs",
+        [
+            {"name": "not a name!"},
+            {"name": "foo[bar]"},
+            {"extras": {"a,b"}},
+            {"extras": {"a b"}},
+            {"url": "http://x"},  # url together with a specifier
+            {"url": "http://x y"},
+        ],
+    )
+    def test_invalid(self, kwargs: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("a>=1").__replace__(**kwargs)  # type: ignore[arg-type]
+
+    def test_marker_normalized(self) -> None:
+        r = Requirement("a").__replace__(marker=Marker('extra == "Foo_Bar"'))
+        assert str(r.marker) == 'extra == "foo-bar"'
+
+    def test_prereleases_kept_and_not_shared(self) -> None:
+        spec = Specifier(">=1", prereleases=True)
+        ss = SpecifierSet([spec, Specifier("<3", prereleases=False)], prereleases=True)
+        r = Requirement("a").__replace__(specifier=ss)
+        assert r.specifier._prereleases is True
+        assert {str(s): s._prereleases for s in r.specifier} == {
+            ">=1": True,
+            "<3": False,
+        }
+        assert r.specifier is not ss
+        assert not any(s is spec for s in r.specifier)
+
+        orig = Requirement("a")
+        orig.specifier = SpecifierSet(
+            [Specifier(">=1", prereleases=True)], prereleases=False
+        )
+        c = orig.__replace__(name="b")
+        assert c.specifier._prereleases is False
+        assert next(iter(c.specifier))._prereleases is True
+        assert c.specifier is not orig.specifier
+        assert next(iter(c.specifier)) is not next(iter(orig.specifier))
+
+    def test_subclass(self) -> None:
+        class Sub(Requirement):
+            def __init__(self, requirement_string: str) -> None:
+                super().__init__(requirement_string)
+                self.extra_state = "set"
+
+        r = Sub("a").__replace__(name="b")
+        assert type(r) is Sub
+        assert r.extra_state == "set"
