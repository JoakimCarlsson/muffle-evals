 if TYPE_CHECKING:
-    from collections.abc import Iterator
+    from collections.abc import Iterable, Iterator
+
+    from typing_extensions import Self
 
 __all__ = [
     "InvalidRequirement",
@@ -106,6 +109,109 @@ class Requirement:
             self.marker = Marker.__new__(Marker)
             self.marker._markers = _normalize_extra_values(parsed.marker)
 
+    def __replace__(
+        self,
+        *,
+        name: str = _UNSET,
+        url: str | None = _UNSET,
+        extras: Iterable[str] = _UNSET,
+        specifier: SpecifierSet = _UNSET,
+        marker: Marker | None = _UNSET,
+    ) -> Self:
+        """
+        __replace__(*, name=..., url=..., extras=..., specifier=..., marker=...)
+
+        Return a new requirement with parts replaced.
+
+        Fields that are not passed are kept. The original is not modified, and
+        the result shares no mutable state (extras, specifier, specifiers) with
+        it or with the arguments. The result is the same as parsing its string
+        form, and is an instance of ``type(self)``.
+
+        >>> r = Requirement('requests[security]>=2.0; python_version >= "3"')
+        >>> r.__replace__(name="flask")
+        <Requirement('flask[security]>=2.0; python_version >= "3"')>
+
+        :param str name:
+        :param str | None url:
+        :param Iterable[str] extras:
+        :param SpecifierSet specifier:
+        :param Marker | None marker:
+        :raises InvalidRequirement: If the resulting requirement would be
+            invalid, or would parse back as something different from the
+            given values.
+
+        .. versionadded:: 26.4
+        """
+        if name is _UNSET:
+            name = self.name
+        if url is _UNSET:
+            url = self.url
+        if extras is _UNSET:
+            extras = self.extras
+        if specifier is _UNSET:
+            specifier = self.specifier
+        if marker is _UNSET:
+            marker = self.marker
+
+        if not isinstance(name, str):
+            raise TypeError(f"name must be a str, not {type(name).__name__}")
+        if url is not None and not isinstance(url, str):
+            raise TypeError(f"url must be a str or None, not {type(url).__name__}")
+        if isinstance(extras, str):
+            raise TypeError("extras must be an iterable of str, not a str")
+        extras = set(extras)
+        if not all(isinstance(e, str) for e in extras):
+            raise TypeError("extras must only contain str")
+        if not isinstance(specifier, SpecifierSet):
+            raise TypeError(
+                f"specifier must be a SpecifierSet, not {type(specifier).__name__}"
+            )
+        if marker is not None and not isinstance(marker, Marker):
+            raise TypeError(
+                f"marker must be a Marker or None, not {type(marker).__name__}"
+            )
+
+        # Copy the specifiers so nothing is shared with the input, keeping the
+        # explicit prereleases overrides that the string form cannot carry.
+        try:
+            specs = [
+                Specifier(
+                    str(s), prereleases=s._prereleases if isinstance(s, Specifier) else None
+                )
+                for s in specifier._specs
+            ]
+        except InvalidSpecifier as e:
+            raise InvalidRequirement(str(e)) from e
+        new_specifier = SpecifierSet(specs, prereleases=specifier._prereleases)
+
+        # Build the string and parse it, so the result is exactly what parsing
+        # would give (and subclasses run their own __init__).
+        parts = Requirement.__new__(Requirement)
+        parts.name = name
+        parts.url = url
+        parts.extras = extras
+        parts.specifier = new_specifier
+        parts.marker = marker
+        result = type(self)(str(parts))
+
+        # Reject values that did not survive the round trip, e.g. a name of
+        # "foo[bar]" or an extra of "a,b", instead of silently changing fields.
+        if (
+            result.name != name
+            or result.url != url
+            or result.extras != extras
+            or str(result.specifier) != str(new_specifier)
+            or (None if result.marker is None else str(result.marker))
+            != (None if marker is None else str(marker))
+        ):
+            raise InvalidRequirement(
+                f"Replacement values do not form a valid requirement: {str(parts)!r}"
+            )
+
+        result.specifier = new_specifier
+        return result
+
     def _iter_parts(self, name: str) -> Iterator[str]:
         yield name
 
diff --git a/tests/test_requirements.py b/tests/test_requirements.py
index ad78c2b..e83762c 100644
--- a/tests/test_requirements.py
+++ b/tests/test_requirements.py
@@ -1085,3 +1085,77 @@ def test_pickle_requirement_25_0_format_loads() -> None:
     assert str(r.specifier) == ">=2.0"
     assert r.marker is None
     assert r == Requirement("requests>=2.0")
+
+
+class TestRequirementReplace:
+    def test_replace_name(self) -> None:
+        r = Requirement('requests[security]>=2.0; python_version >= "3"')
+        assert str(r.__replace__(name="flask")) == (
+            'flask[security]>=2.0; python_version >= "3"'
+        )
+        assert r.name == "requests"
+
+    def test_no_args_equal_but_distinct(self) -> None:
+        r = Requirement("a[x]>=1; os_name == 'nt'")
+        new = r.__replace__()
+        assert new == r
+        assert new is not r
+        assert new.extras is not r.extras
+        assert new.marker is not r.marker
+
+    def test_url_and_marker_and_extras(self) -> None:
+        r = Requirement("a")
+        new = r.__replace__(
+            url="http://x/y.whl",
+            extras={"b"},
+            marker=Marker('extra == "Foo_Bar"'),
+        )
+        assert str(new) == 'a[b] @ http://x/y.whl ; extra == "foo-bar"'
+        assert new.__replace__(url=None, marker=None) == Requirement("a[b]")
+
+    def test_unknown_keyword(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("a").__replace__(foo=1)  # type: ignore[call-arg]
+
+    @pytest.mark.parametrize(
+        "kwargs",
+        [
+            {"name": "not a name!"},
+            {"name": "foo[bar]"},
+            {"name": "a @ http://x"},
+            {"extras": {"a,b"}},
+            {"url": ""},
+        ],
+    )
+    def test_invalid(self, kwargs: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("a").__replace__(**kwargs)  # type: ignore[arg-type]
+
+    def test_specifier_copied_with_prereleases(self) -> None:
+        ss = SpecifierSet(">=1,<3", prereleases=True)
+        ss._specs[0].prereleases = False
+        new = Requirement("a").__replace__(specifier=ss)
+        assert new.specifier is not ss
+        assert new.specifier.prereleases is True
+        assert {s._prereleases for s in new.specifier._specs} == {None, False}
+        assert not set(map(id, new.specifier._specs)) & set(map(id, ss._specs))
+
+        kept = new.__replace__(name="b")
+        assert kept.specifier is not new.specifier
+        assert kept.specifier.prereleases is True
+
+    def test_subclass(self) -> None:
+        class Sub(Requirement):
+            def __init__(self, s: str) -> None:
+                super().__init__(s)
+                self.extra_attr = 1
+
+        new = Sub("a").__replace__(name="b")
+        assert type(new) is Sub
+        assert new.extra_attr == 1
+
+    def test_copy_replace(self) -> None:
+        copy = pytest.importorskip("copy")
+        if not hasattr(copy, "replace"):
+            pytest.skip("needs Python 3.13+")
+        assert copy.replace(Requirement("a>=2"), name="b") == Requirement("b>=2")
