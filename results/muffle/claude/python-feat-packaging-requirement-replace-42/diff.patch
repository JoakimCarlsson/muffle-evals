+
+
+class TestRequirementReplace:
+    def test_replace_fields(self) -> None:
+        r = Requirement('requests[security]>=2.0; python_version >= "3"')
+        assert str(r.__replace__(name="flask")) == (
+            'flask[security]>=2.0; python_version >= "3"'
+        )
+        assert str(r) == 'requests[security]>=2.0; python_version >= "3"'
+        assert r.__replace__(marker=None).marker is None
+        assert r.__replace__(extras=set()).extras == set()
+        assert str(Requirement("a").__replace__(url="http://x")) == "a @ http://x"
+
+    def test_no_arguments(self) -> None:
+        r = Requirement("a[b]>=1; os_name == 'x'")
+        new = r.__replace__()
+        assert new == r
+        assert new is not r
+        assert new.extras is not r.extras
+
+    def test_unknown_keyword(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("a").__replace__(foo=1)  # type: ignore[call-arg]
+        with pytest.raises(TypeError):
+            Requirement("a").__replace__("b")  # type: ignore[misc]
+
+    @pytest.mark.parametrize(
+        "kwargs",
+        [
+            {"name": "not a name!"},
+            {"name": "foo[bar]"},
+            {"name": ""},
+            {"extras": {"a,b"}},
+            {"url": ""},
+            {"url": "http://x y"},
+            {"url": "http://x", "specifier": SpecifierSet(">=1")},
+        ],
+    )
+    def test_invalid(self, kwargs: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("a").__replace__(**kwargs)  # type: ignore[arg-type]
+
+    def test_marker_normalized(self) -> None:
+        new = Requirement("a").__replace__(marker=Marker('extra == "Foo_Bar"'))
+        assert str(new.marker) == 'extra == "foo-bar"'
+
+    @pytest.mark.parametrize("pass_it", [True, False])
+    def test_specifier_copied(self, pass_it: bool) -> None:
+        spec = SpecifierSet([Specifier(">=1", prereleases=True)], prereleases=False)
+        r = Requirement("a")
+        r.specifier = spec
+        new = r.__replace__(specifier=spec) if pass_it else r.__replace__()
+        assert new.specifier is not spec
+        assert new.specifier._prereleases is False
+        (new_spec,) = new.specifier
+        assert new_spec is not next(iter(spec))
+        assert new_spec.prereleases is True
+
+    def test_copy_replace_and_subclass(self) -> None:
+        class Sub(Requirement):
+            def __init__(self, requirement_string: str) -> None:
+                super().__init__(requirement_string)
+                self.extra_attr = 1
+
+        new = Sub("a").__replace__(name="b")
+        assert type(new) is Sub
+        assert new.extra_attr == 1
+        assert new.name == "b"
+        if hasattr(copy, "replace"):
+            assert copy.replace(Requirement("a"), name="c").name == "c"
