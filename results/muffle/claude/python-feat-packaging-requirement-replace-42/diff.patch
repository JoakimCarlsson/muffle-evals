+    def __replace__(
+        self,
+        /,
+        *,
+        name: str = _MISSING,
+        url: str | None = _MISSING,
+        extras: Iterable[str] = _MISSING,
+        specifier: SpecifierSet = _MISSING,
+        marker: Marker | None = _MISSING,
+    ) -> Self:
+        """Return a copy of this requirement with the given fields replaced.
+
+        Fields that are not passed are kept. The result is validated like a
+        parsed requirement string, and the specifier is copied, keeping its
+        ``prereleases`` settings.
+
+        :raises InvalidRequirement: If the resulting requirement is not valid,
+            or a value would be read back as something different.
+        :raises TypeError: If an unknown keyword is passed or a value has the
+            wrong type.
+
+        .. versionadded:: 26.4
+        """
+        if name is _MISSING:
+            name = self.name
+        if url is _MISSING:
+            url = self.url
+        if extras is _MISSING:
+            extras = self.extras
+        elif isinstance(extras, str):
+            raise TypeError("extras must be an iterable of strings, not a string")
+        if specifier is _MISSING:
+            specifier = self.specifier
+        elif not isinstance(specifier, SpecifierSet):
+            raise TypeError("specifier must be a SpecifierSet")
+        if marker is _MISSING:
+            marker = self.marker
+        elif marker is not None and not isinstance(marker, Marker):
+            raise TypeError("marker must be a Marker or None")
+        extras = set(extras)
+        specifier = _copy_specifier_set(specifier)
+
+        candidate = Requirement.__new__(Requirement)
+        candidate.name = name
+        candidate.url = url
+        candidate.extras = extras
+        candidate.specifier = specifier
+        candidate.marker = marker
+        try:
+            requirement_string = str(candidate)
+        except TypeError as e:
+            raise TypeError(f"Invalid value for a requirement field: {e}") from e
+
+        new = type(self)(requirement_string)
+        # A value that parses differently (e.g. ``name="foo[bar]"``) is invalid.
+        if (
+            new.name != name
+            or new.url != url
+            or new.extras != extras
+            or str(new.specifier) != str(specifier)
+        ):
+            raise InvalidRequirement(
+                f"Replacement values do not form a valid requirement: "
+                f"{requirement_string!r}"
+            )
+        # The string form drops the prereleases settings.
+        new.specifier = specifier
+        return new
+
