@@ -106,6 +114,88 @@ class Requirement:
             self.marker = Marker.__new__(Marker)
             self.marker._markers = _normalize_extra_values(parsed.marker)
 
+    def __replace__(
+        self,
+        /,
+        *,
+        name: str = _UNSET,  # type: ignore[assignment]
+        url: str | None = _UNSET,  # type: ignore[assignment]
+        extras: Iterable[str] = _UNSET,  # type: ignore[assignment]
+        specifier: SpecifierSet = _UNSET,  # type: ignore[assignment]
+        marker: Marker | None = _UNSET,  # type: ignore[assignment]
+    ) -> Self:
+        """Return a copy of this requirement with the given fields replaced.
+
+        Fields that are not passed are kept. The original is not modified and
+        the result shares no mutable state with it. This is what
+        :func:`copy.replace` calls on Python 3.13+.
+
+        :raises InvalidRequirement: If the resulting requirement is not valid,
+            or if a value would be read back as something different from what
+            was given (for example ``name="foo[bar]"``).
+        :raises TypeError: If an unknown keyword or a value of the wrong type
+            is given.
+
+        .. versionadded:: 26.4
+        """
+        if name is _UNSET:
+            name = self.name
+        if url is _UNSET:
+            url = self.url
+        extras_set = set(self.extras if extras is _UNSET else extras)
+        if specifier is _UNSET:
+            specifier = self.specifier
+        if marker is _UNSET:
+            marker = self.marker
+
+        if not isinstance(name, str):
+            raise TypeError(f"name must be a str, not {type(name).__name__}")
+        if url is not None and not isinstance(url, str):
+            raise TypeError(f"url must be a str or None, not {type(url).__name__}")
+        if not all(isinstance(e, str) for e in extras_set):
+            raise TypeError("extras must be strings")
+        if not isinstance(specifier, SpecifierSet):
+            raise TypeError(
+                f"specifier must be a SpecifierSet, not {type(specifier).__name__}"
+            )
+        if marker is not None and not isinstance(marker, Marker):
+            raise TypeError(
+                f"marker must be a Marker or None, not {type(marker).__name__}"
+            )
+
+        # Render the new fields to a string and parse it, so the result is
+        # exactly what parsing would give (including marker normalization).
+        draft = Requirement.__new__(Requirement)
+        draft.name = name
+        draft.url = url or None
+        draft.extras = extras_set
+        draft.specifier = specifier
+        draft.marker = marker
+        requirement_string = str(draft)
+
+        parsed = Requirement(requirement_string)
+        if (
+            parsed.name != name
+            or parsed.url != (url or None)
+            or parsed.extras != extras_set
+            or (parsed.marker is None) != (marker is None)
+        ):
+            raise InvalidRequirement(
+                f"Replacement values do not round-trip: {requirement_string!r}"
+            )
+
+        new = type(self)(requirement_string)
+        # Strings do not carry the prereleases overrides, and the specifier
+        # must not be shared with the input, so copy each Specifier.
+        new.specifier = SpecifierSet(
+            [
+                Specifier(str(s), s._prereleases) if isinstance(s, Specifier) else s
+                for s in specifier._specs
+            ],
+            specifier._prereleases,
+        )
+        return new
+
     def _iter_parts(self, name: str) -> Iterator[str]:
         yield name
 
