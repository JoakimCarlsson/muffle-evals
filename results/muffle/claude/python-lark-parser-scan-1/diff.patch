+    def scan(self, text: TextOrSlice, start: Optional[str]=None) -> Iterator[ScanMatch]:
+        # Validation happens here, so that errors are raised when scan() is called, not on first iteration
+        if self.parser_conf.parser_type != 'lalr':
+            raise ConfigurationError("scan() only works with parser='lalr'")
+        if self.lexer_conf.postlex is not None:
+            raise ConfigurationError("scan() doesn't support postlex")
+        if not isinstance(self.lexer_conf.lexer_type, str):
+            raise ConfigurationError("scan() doesn't support custom lexers")
+        if self.skip_lexer:
+            raise ConfigurationError("scan() only works with lexer='basic' or 'contextual'")
+        chosen_start = self._verify_start(start)
+        if not isinstance(text, (str, bytes, TextSlice)):
+            raise TypeError("scan() expects str, bytes or TextSlice, got %s" % type(text).__name__)
+        return self._scan(TextSlice.cast_from(text), chosen_start)
+
+    def _scan_attempt(self, parse_conf: ParseConf, text: TextSlice, pos: int, line_ctr: LineCounter) -> List[Token]:
+        """Find the longest sequence of tokens, starting exactly at pos, that is a complete parse.
+
+        The parser runs without values: only the state stack is tracked, so the transformer is never applied here.
+        Returns an empty list if there is no such sequence.
+        """
+        lexer = self.lexer
+        contextual = isinstance(lexer, ContextualLexer)
+        parser_state = ParserState(parse_conf, None)    # type: ignore[arg-type]
+        stack = parser_state.state_stack
+        states = parse_conf.states
+        end_state = parse_conf.end_state
+        callbacks = parse_conf.callbacks
+        lexer_state = LexerState(TextSlice(text.text, pos, text.end), copy(line_ctr))
+
+        tokens: List[Token] = []
+        accepted = 0
+        while True:
+            try:
+                next_token = (lexer.lexers[stack[-1]] if contextual else lexer).next_token
+                token = next_token(lexer_state, parser_state)
+            except (EOFError, UnexpectedInput):
+                break
+            except ConfigurationError:
+                raise
+            except ValueError:      # A callback rejected the token
+                break
+
+            if None in (token.start_pos, token.end_pos, token.line, token.column, token.end_line, token.end_column):
+                raise LexError("A callback did not preserve token positions (token %r). Use Token.update() instead of creating a new Token" % (token,))
+            if not tokens and token.start_pos != pos:
+                return []   # An ignored terminal comes first, so this isn't a valid start
+
+            # Feed the token, without building values
+            while True:
+                try:
+                    action, arg = states[stack[-1]][token.type]
+                except KeyError:
+                    action = None
+                    break
+                if action is Shift:
+                    stack.append(arg)
+                    break
+                size = len(arg.expansion)
+                if size:
+                    del stack[-size:]
+                stack.append(states[stack[-1]][arg.origin.name][1])
+            if action is None:
+                break
+            if token.type in callbacks:
+                try:
+                    callbacks[token.type](Token.new_borrow_pos(token.type, token.value, token))
+                except ConfigurationError:
+                    raise
+                except ValueError:
+                    break
+
+            tokens.append(token)
+            if _accepts_end(states, end_state, stack):
+                accepted = len(tokens)
+
+        return tokens[:accepted]
+
+    def _scan(self, text: TextSlice, start: str) -> Iterator[ScanMatch]:
+        parse_conf = ParseConf(self.parser._parse_table, self.parser.parser.callbacks, start)
+        line_ctr = LineCounter(b'\n' if isinstance(text.text, bytes) else '\n')
+        if text.start > 0:
+            line_ctr.feed(TextSlice(text.text, 0, text.start))
+
+        pos = text.start
+        while pos < text.end:
+            tokens = self._scan_attempt(parse_conf, text, pos, line_ctr)
+            new_pos = pos + 1
+            if tokens:
+                # Parse again, now with values, from the tokens that were already lexed
+                value = self.parser.parse(_TokenReplay(tokens), start)
+                end = tokens[-1].end_pos
+                yield ScanMatch((pos, end), value)
+                new_pos = max(end, new_pos)
+            line_ctr.feed(text.text[pos:new_pos])
+            pos = new_pos
+
+
+class _TokenReplay:
+    "Stands in for a LexerThread, to feed the parser with tokens that were already lexed"
+    def __init__(self, tokens):
+        self.tokens = tokens
+
+    def lex(self, parser_state):
+        return iter(self.tokens)
+
+
+def _accepts_end(states, end_state, stack) -> bool:
+    "Whether the parser can finish, if the input ends now. Doesn't change the stack."
+    keep = len(stack)       # stack[:keep] is untouched, `pushed` is what comes after it
+    pushed: List[Any] = []
+    while True:
+        top = pushed[-1] if pushed else stack[keep - 1]
+        try:
+            action, rule = states[top]['$END']
+        except KeyError:
+            return False
+        if action is Shift:
+            return False
+        size = len(rule.expansion)
+        drop = min(size, len(pushed))
+        if drop:
+            del pushed[-drop:]
+        keep -= size - drop
+        top = pushed[-1] if pushed else stack[keep - 1]
+        new_state = states[top][rule.origin.name][1]
+        if new_state == end_state:
+            return True
+        pushed.append(new_state)
+
 
