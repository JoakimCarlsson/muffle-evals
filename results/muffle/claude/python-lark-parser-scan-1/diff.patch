+    def scan(self, text: TextOrSlice, start: Optional[str]=None) -> Iterator[ScanMatch[_Return_T]]:
+        """Find the parts of the text that match the grammar, like a regex search. Only works when parser='lalr'.
+
+        Yields non-overlapping matches, in order. Each match is the longest prefix that parses,
+        from the earliest position where one starts. Text that doesn't parse is skipped.
+        Matches are never empty, and never start or end with an ignored terminal.
+
+        Lexer callbacks and the transformer's terminal callbacks may be called on text that doesn't end up matching.
+        A callback that raises ValueError marks the token as invalid.
+
+        Parameters:
+            text (TextOrSlice): Text to be scanned, as `str`, `bytes` or `TextSlice`.
+                For a TextSlice, only the slice is scanned, and positions are relative to the whole text.
+            start (str, optional): Required if Lark was given multiple possible start symbols (using the start option).
+
+        Returns:
+            An iterator of ``ScanMatch`` instances, whose ``range`` is a ``(start, end)`` tuple of offsets into the text,
+            and whose ``value`` is what ``parse()`` returns for the matched text.
+
+        :raises ConfigurationError: (when called) If the configuration doesn't support scanning,
+            i.e. a parser other than 'lalr', no parser, a postlex, or a custom lexer.
+        """
+        if self.options.parser is None:
+            raise ConfigurationError("scan() requires a parser. Use parser='lalr'")
+        return self.parser.scan(text, start=start)
+
 
 ###}
