+
+def test_replace_dotted_key_with_aot_does_not_capture_siblings():
+    doc = parse("a.b = 1\nc.d = 2\n")
+    aot = tomlkit.aot()
+    t = tomlkit.table()
+    t["x"] = 9
+    aot.append(t)
+    doc["a"] = aot
+
+    assert parse(doc.as_string()) == {"c": {"d": 2}, "a": [{"x": 9}]}
