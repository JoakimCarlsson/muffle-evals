+def test_replace_dotted_key_with_aot_keeps_following_sibling() -> None:
+    doc = parse("a.b = 1\nc.d = 2\n")
+    aot = tomlkit.aot()
+    t = tomlkit.table()
+    t["x"] = 9
+    aot.append(t)
+    doc["a"] = aot
+    # ``[[a]]`` must not swallow the following ``c.d`` dotted key.
+    assert parse(doc.as_string()) == {"c": {"d": 2}, "a": [{"x": 9}]}
+
