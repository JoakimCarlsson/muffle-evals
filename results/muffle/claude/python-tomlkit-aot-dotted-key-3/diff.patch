+def test_replace_dotted_key_with_aot_does_not_capture_siblings():
+    doc = api.parse("a.b = 1\nc.d = 2\n")
+    aot = api.aot()
+    t = api.table()
+    t["x"] = 9
+    aot.append(t)
+    doc["a"] = aot
+
+    assert api.parse(doc.as_string()) == {"c": {"d": 2}, "a": [{"x": 9}]}
