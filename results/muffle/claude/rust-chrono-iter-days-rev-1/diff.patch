+    let last = NaiveDate::from_ymd_opt(MAX_YEAR, 12, 29).unwrap();
+    assert_eq!(last.iter_days().take(4).count(), 3);
+    assert_eq!(last.iter_days().next_back(), Some(NaiveDate::MAX));
