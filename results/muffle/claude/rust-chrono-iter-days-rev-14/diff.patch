+
+#[test]
+fn test_day_iterator_double_ended() {
+    let start = NaiveDate::from_ymd_opt(2025, 10, 10).unwrap();
+    let mut forward: Vec<_> = start.iter_days().take(7).collect();
+    forward.reverse();
+    let backward: Vec<_> = start.iter_days().take(7).rev().collect();
+    assert_eq!(forward, backward);
+
+    // Both ends work on the same range and stop when they meet.
+    let mut iter = NaiveDate::from_ymd_opt(MAX_YEAR, 12, 26).unwrap().iter_days();
+    assert_eq!(iter.len(), 5);
+    assert_eq!(iter.next(), NaiveDate::from_ymd_opt(MAX_YEAR, 12, 26));
+    assert_eq!(iter.next_back(), NaiveDate::from_ymd_opt(MAX_YEAR, 12, 30));
+    assert_eq!(iter.len(), 3);
+    assert_eq!(iter.next_back(), NaiveDate::from_ymd_opt(MAX_YEAR, 12, 29));
+    assert_eq!(iter.next(), NaiveDate::from_ymd_opt(MAX_YEAR, 12, 27));
+    assert_eq!(iter.next(), NaiveDate::from_ymd_opt(MAX_YEAR, 12, 28));
+    assert_eq!(iter.next(), None);
+    assert_eq!(iter.next_back(), None);
+
+    let all = NaiveDate::MIN.iter_days();
+    assert_eq!(all.len(), all.rev().count());
+    assert_eq!(NaiveDate::MIN.iter_days().next_back(), NaiveDate::MAX.pred_opt());
+}
+
+#[test]
+fn test_week_iterator_double_ended() {
+    let start = NaiveDate::from_ymd_opt(2025, 10, 10).unwrap();
+    let mut forward: Vec<_> = start.iter_weeks().take(7).collect();
+    forward.reverse();
+    let backward: Vec<_> = start.iter_weeks().take(7).rev().collect();
+    assert_eq!(forward, backward);
+
+    let mut iter = NaiveDate::from_ymd_opt(MAX_YEAR, 12, 1).unwrap().iter_weeks();
+    assert_eq!(iter.len(), 4);
+    assert_eq!(iter.next_back(), NaiveDate::from_ymd_opt(MAX_YEAR, 12, 22));
+    assert_eq!(iter.next(), NaiveDate::from_ymd_opt(MAX_YEAR, 12, 1));
+    assert_eq!(iter.len(), 2);
+    assert_eq!(iter.next_back(), NaiveDate::from_ymd_opt(MAX_YEAR, 12, 15));
+    assert_eq!(iter.next(), NaiveDate::from_ymd_opt(MAX_YEAR, 12, 8));
+    assert_eq!(iter.next(), None);
+    assert_eq!(iter.next_back(), None);
+
+    let all = NaiveDate::MIN.iter_weeks();
+    assert_eq!(all.len(), all.rev().count());
 }
 
 #[test]
