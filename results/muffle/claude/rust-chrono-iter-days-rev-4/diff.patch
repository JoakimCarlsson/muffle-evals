+        let remaining = self.remaining();
+        if remaining == 0 {
+            return None;
+        }
+        // The last remaining item lies `remaining - 1` weeks after `value`.
+        let last = self.value.checked_add_days(Days::new((remaining as u64 - 1) * 7))?;
+        self.end = last;
