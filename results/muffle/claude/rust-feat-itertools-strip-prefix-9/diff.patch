index 0000000..140e026
--- /dev/null
+++ b/src/strip_prefix.rs
@@ -0,0 +1,100 @@
+#[cfg(doc)]
+use crate::Itertools;
+use std::fmt::{self, Debug, Display, Formatter};
+
+/// Value returned for the error case of [`Itertools::strip_prefix`]
+/// and [`Itertools::strip_prefix_by`].
+pub struct StripPrefixError<I, P>
+where
+    I: Iterator,
+    P: Iterator,
+{
+    /// The original iterator, stopped right after the item that didn't match.
+    pub iterator: I,
+    /// The rest of the prefix iterator, after the prefix item that didn't match.
+    pub prefix: P,
+    /// The iterator's item (`None` if the iterator ran out first) and the
+    /// prefix item it was compared with.
+    pub mismatch: (Option<I::Item>, P::Item),
+}
+
+impl<I, P> Clone for StripPrefixError<I, P>
+where
+    I: Iterator + Clone,
+    P: Iterator + Clone,
+    I::Item: Clone,
+    P::Item: Clone,
+{
+    fn clone(&self) -> Self {
+        Self {
+            iterator: self.iterator.clone(),
+            prefix: self.prefix.clone(),
+            mismatch: self.mismatch.clone(),
+        }
+    }
+}
+
+impl<I, P> Debug for StripPrefixError<I, P>
+where
+    I: Iterator + Debug,
+    P: Iterator + Debug,
+    I::Item: Debug,
+    P::Item: Debug,
+{
+    fn fmt(&self, f: &mut Formatter<'_>) -> fmt::Result {
+        f.debug_struct("StripPrefixError")
+            .field("iterator", &self.iterator)
+            .field("prefix", &self.prefix)
+            .field("mismatch", &self.mismatch)
+            .finish()
+    }
+}
+
+impl<I, P> Display for StripPrefixError<I, P>
+where
+    I: Iterator,
+    P: Iterator,
+{
+    fn fmt(&self, f: &mut Formatter<'_>) -> fmt::Result {
+        match self.mismatch.0 {
+            Some(_) => write!(f, "iterator item did not match the prefix item"),
+            None => write!(f, "iterator ended before the prefix did"),
+        }
+    }
+}
+
+#[cfg(feature = "use_std")]
+impl<I, P> std::error::Error for StripPrefixError<I, P>
+where
+    I: Iterator + Debug,
+    P: Iterator + Debug,
+    I::Item: Debug,
+    P::Item: Debug,
+{
+}
+
+pub(crate) fn strip_prefix_by<I, P, F>(
+    mut iter: I,
+    prefix: P,
+    mut eq: F,
+) -> Result<I, StripPrefixError<I, P::IntoIter>>
+where
+    I: Iterator,
+    P: IntoIterator,
+    F: FnMut(&I::Item, &P::Item) -> bool,
+{
+    let mut prefix = prefix.into_iter();
+    while let Some(p) = prefix.next() {
+        match iter.next() {
+            Some(x) if eq(&x, &p) => {}
+            other => {
+                return Err(StripPrefixError {
+                    iterator: iter,
+                    prefix,
+                    mismatch: (other, p),
+                })
+            }
+        }
+    }
+    Ok(iter)
+}
diff --git a/tests/test_std.rs b/tests/test_std.rs
index 5f5cfd1..d1b0fd4 100644
--- a/tests/test_std.rs
+++ b/tests/test_std.rs
@@ -1675,3 +1675,29 @@ fn counts_by_with_hasher() {
     let _: HashMap<_, _, TestHasher> =
         empty::<u8>().counts_by_with_hasher(|x| x, TestHasher::new());
 }
+
+#[test]
+fn strip_prefix() {
+    assert_eq!(
+        (1..6).strip_prefix([1, 2]).unwrap().collect_vec(),
+        [3, 4, 5]
+    );
+    assert_eq!(
+        (1..3).strip_prefix(None::<i32>).unwrap().collect_vec(),
+        [1, 2]
+    );
+    let err = (1..6).strip_prefix([1, 2, 9, 4]).unwrap_err();
+    assert_eq!(err.mismatch, (Some(3), 9));
+    assert_eq!(err.prefix.collect_vec(), [4]);
+    assert_eq!(err.iterator.collect_vec(), [4, 5]);
+    let err = (1..3).strip_prefix([1, 2, 3]).unwrap_err();
+    assert_eq!(err.mismatch, (None, 3));
+    assert_eq!(err.iterator.count(), 0);
+    let rest: String = "hello"
+        .chars()
+        .strip_prefix("he".chars())
+        .unwrap()
+        .collect();
+    assert_eq!(Some(rest.as_str()), "hello".strip_prefix("he"));
+    assert!("hello".chars().strip_prefix("hx".chars()).is_err());
+}
