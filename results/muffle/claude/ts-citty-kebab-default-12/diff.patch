@@ -82,7 +82,6 @@ export function parseRawArgs<T = Record<string, any>>(
       const type = getType(name);
       options[name] = {
         type,
-        default: defaults[name],
       };
     }
   }
@@ -172,5 +171,18 @@ export function parseRawArgs<T = Record<string, any>>(
     }
   }
 
+  // Apply defaults last, so a value given under any alias (e.g. kebab-case)
+  // is not shadowed by the default of another name
+  for (const [name, value] of Object.entries(defaults)) {
+    const names = [name, ...(mainToAliases.get(name) || [])];
+    const given = names.find((n) => (out as any)[n] !== undefined);
+    const resolved = given === undefined ? value : (out as any)[given];
+    for (const n of names) {
+      if ((out as any)[n] === undefined) {
+        (out as any)[n] = resolved;
+      }
+    }
+  }
+
   return out;
 }
diff --git a/test/kebab-default.test.ts b/test/kebab-default.test.ts
new file mode 100644
index 0000000..8e9710f
--- /dev/null
+++ b/test/kebab-default.test.ts
@@ -0,0 +1,10 @@
+import { expect, it } from "vitest";
+import { parseArgs } from "../src/args.ts";
+
+it("kebab-case input overrides camelCase default", () => {
+  const def = { fooBar: { type: "enum", options: ["one", "two"], default: "two" } } as const;
+  const a = parseArgs(["--foo-bar", "one"], def) as any;
+  expect(a.fooBar).toBe("one");
+  expect(a["foo-bar"]).toBe("one");
+  expect((parseArgs([], def) as any).fooBar).toBe("two");
+});
