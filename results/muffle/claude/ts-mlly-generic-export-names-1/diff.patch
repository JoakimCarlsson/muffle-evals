+ */
+function _isGenericOpen(str: string, index: number): boolean {
+  if (!/[A-Za-z_$]/.test(/[\w$]+$/.exec(str.slice(0, index))?.[0] ?? "")) {
+    return false;
+  }
+  let depth = 0;
+  for (let i = index; i < str.length; i++) {
+    const char = str[i];
+    if (char === "<") {
+      depth++;
+    } else if (char === ">" && str[i - 1] !== "=") {
+      if (--depth === 0) {
+        return /^\s*[(`]/.test(str.slice(i + 1));
+      }
+    } else if (char === ";" || (char === "=" && str[i + 1] !== ">")) {
+      return false;
+    }
+  }
+  return false;
+}
