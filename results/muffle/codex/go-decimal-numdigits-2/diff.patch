+func TestDecimal_NumDigitsBoundaries(t *testing.T) {
+	// Check both sides of powers of ten through the int64 and big.Int paths.
+	for digits := 1; digits <= 100; digits++ {
+		power := new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(digits)), nil)
+		for _, offset := range []int64{-1, 0, 1} {
+			coefficient := new(big.Int).Add(power, big.NewInt(offset))
+			want := len(coefficient.String())
+			for _, sign := range []int64{1, -1} {
+				value := new(big.Int).Mul(coefficient, big.NewInt(sign))
+				for _, exp := range []int32{-20, 0, 20} {
+					d := NewFromBigInt(value, exp)
+					if got := d.NumDigits(); got != want {
+						t.Errorf("coefficient %s, exponent %d: got %d digits, want %d", value, exp, got, want)
+					}
+				}
+			}
+		}
+	}
+	for _, value := range []int64{-1 << 63, 1<<63 - 1} {
+		if got := New(value, 0).NumDigits(); got != 19 {
+			t.Errorf("coefficient %d: got %d digits, want 19", value, got)
+		}
+	}
+}
