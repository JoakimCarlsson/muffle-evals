+func TestDecimal_NumDigitsPowerOfTenBoundaries(t *testing.T) {
+	for power := int64(0); power <= 100; power++ {
+		boundary := new(big.Int).Exp(big.NewInt(10), big.NewInt(power), nil)
+		for delta := int64(-1); delta <= 1; delta++ {
+			coefficient := new(big.Int).Add(boundary, big.NewInt(delta))
+			want := len(coefficient.Text(10))
+			for _, negative := range []bool{false, true} {
+				value := new(big.Int).Set(coefficient)
+				if negative {
+					value.Neg(value)
+				}
+				for _, exp := range []int32{-20, 0, 20} {
+					d := NewFromBigInt(value, exp)
+					if got := d.NumDigits(); got != want {
+						t.Errorf("coefficient %s, exponent %d: got %d digits, want %d", value, exp, got, want)
+					}
+				}
+			}
+		}
+	}
+}
