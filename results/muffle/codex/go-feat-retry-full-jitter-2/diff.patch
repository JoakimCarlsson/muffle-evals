+// WithFullJitter wraps a backoff and returns a uniformly random duration in
+// [0, base), where base is the duration returned by the wrapped backoff.
+// Zero and negative durations are returned unchanged. If the wrapped backoff
+// stops, WithFullJitter returns zero and stops too.
+func WithFullJitter(next Backoff) Backoff {
+	return BackoffFunc(func() (time.Duration, bool) {
+		val, stop := next.Next()
+		if stop {
+			return 0, true
+		}
+		if val <= 0 {
+			return val, false
+		}
+		return time.Duration(rand.Int64N(int64(val))), false
+	})
+}
