+# A sentinel distinguishes omitted fields from explicit None values.
+_UNSET: Any = object()
+
+
 class InvalidRequirement(ValueError):
     """
     Raised when attempting to create a :class:`Requirement` with a string that
@@ -106,6 +112,75 @@ class Requirement:
             self.marker = Marker.__new__(Marker)
             self.marker._markers = _normalize_extra_values(parsed.marker)
 
+    def __replace__(
+        self,
+        *,
+        name: str = _UNSET,
+        url: str | None = _UNSET,
+        extras: set[str] = _UNSET,
+        specifier: SpecifierSet = _UNSET,
+        marker: Marker | None = _UNSET,
+    ) -> Self:
+        """Return a new requirement with the specified fields replaced.
+
+        Omitted fields are retained. The result is validated and normalized
+        like a parsed requirement. Mutable fields are copied, preserving
+        specifier prerelease overrides. This also supports :func:`copy.replace`
+        on Python 3.13 and later.
+
+        :raises InvalidRequirement: If the fields cannot represent a requirement
+            without changing their meaning when parsed.
+
+        .. versionadded:: 26.4
+        """
+        name = self.name if name is _UNSET else name
+        url = self.url if url is _UNSET else url
+        extras = self.extras if extras is _UNSET else extras
+        specifier = self.specifier if specifier is _UNSET else specifier
+        marker = self.marker if marker is _UNSET else marker
+
+        if not all(
+            (
+                isinstance(name, str),
+                url is None or isinstance(url, str),
+                isinstance(extras, set),
+                isinstance(specifier, SpecifierSet),
+                marker is None or isinstance(marker, Marker),
+            )
+        ):
+            raise InvalidRequirement("Invalid requirement field types")
+        if any(not isinstance(extra, str) for extra in extras):
+            raise InvalidRequirement("Invalid extra name type")
+
+        # Build a temporary value for serialization without mutating self or
+        # canonicalizing the caller's specifier set in place.
+        candidate = Requirement.__new__(Requirement)
+        candidate.name = name
+        candidate.url = url
+        candidate.extras = set(extras)
+        copied_specs = tuple(
+            Specifier(str(s), prereleases=s._prereleases) for s in specifier
+        )
+        candidate.specifier = SpecifierSet(copied_specs)
+        candidate.marker = marker
+        result = type(self)(str(candidate))
+
+        # Parsing must not reinterpret field contents as other fields, or
+        # discard values such as an empty URL or whitespace in a name.
+        if (
+            result.name != name
+            or result.url != url
+            or result.extras != extras
+            or str(result.specifier) != str(candidate.specifier)
+            or result.marker != (Marker(str(marker)) if marker is not None else None)
+        ):
+            raise InvalidRequirement("Requirement fields change meaning when parsed")
+
+        result.specifier = SpecifierSet(
+            copied_specs, prereleases=specifier._prereleases
+        )
+        return result
+
     def _iter_parts(self, name: str) -> Iterator[str]:
         yield name
 
