+
+class TestRequirementReplace:
+    @pytest.mark.parametrize(
+        ("changes", "expected"),
+        [
+            ({}, 'requests[security]>=2.0; python_version >= "3"'),
+            ({"name": "flask"}, 'flask[security]>=2.0; python_version >= "3"'),
+            ({"extras": {"test"}}, 'requests[test]>=2.0; python_version >= "3"'),
+            (
+                {"specifier": SpecifierSet("<4")},
+                'requests[security]<4; python_version >= "3"',
+            ),
+            ({"marker": None}, "requests[security]>=2.0"),
+            (
+                {"marker": Marker('extra == "Foo_Bar"')},
+                'requests[security]>=2.0; extra == "foo-bar"',
+            ),
+            (
+                {"url": "https://example.com/pkg", "specifier": SpecifierSet()},
+                'requests[security] @ https://example.com/pkg ; python_version >= "3"',
+            ),
+        ],
+    )
+    def test_replace(self, changes: dict[str, object], expected: str) -> None:
+        original = Requirement('requests[security]>=2.0; python_version >= "3"')
+        result = original.__replace__(**changes)  # type: ignore[arg-type]
+        assert str(result) == expected
+        assert result == Requirement(str(result))
+        assert result is not original
+        assert str(original) == 'requests[security]>=2.0; python_version >= "3"'
+        assert result.extras is not original.extras
+        if result.marker is not None:
+            assert result.marker is not original.marker
+
+    @pytest.mark.parametrize(
+        "changes",
+        [
+            {"name": "not a name!"},
+            {"name": "foo[bar]"},
+            {"name": " foo "},
+            {"extras": {"a,b"}},
+            {"extras": {""}},
+            {"url": ""},
+            {"url": "https://example.com ; os_name == 'posix'"},
+            {"url": "https://example.com", "specifier": SpecifierSet(">=1")},
+            {"name": None},
+            {"extras": None},
+            {"extras": {1}},
+            {"url": 1},
+            {"specifier": ">=1"},
+            {"marker": "os_name == 'posix'"},
+        ],
+    )
+    def test_invalid(self, changes: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("foo").__replace__(**changes)  # type: ignore[arg-type]
+
+    def test_arguments(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("foo").__replace__(unknown="bar")  # type: ignore[call-arg]
+        with pytest.raises(TypeError):
+            Requirement("foo").__replace__("bar")  # type: ignore[call-arg]
+
+    @pytest.mark.parametrize("override", [None, False, True])
+    @pytest.mark.parametrize("supplied", [False, True])
+    def test_specifier_copy(self, override: bool | None, supplied: bool) -> None:
+        original = Requirement("foo>=1a1,<3")
+        specifier = SpecifierSet(">=1a1,<3", prereleases=override)
+        for s in specifier:
+            s.prereleases = s.operator == ">="
+        original.specifier = specifier
+        result = (
+            original.__replace__(specifier=specifier)
+            if supplied
+            else original.__replace__()
+        )
+        assert result.specifier is not specifier
+        assert result.specifier._prereleases is override
+        source_specs = {str(s): s for s in specifier}
+        for s in result.specifier:
+            source = source_specs[str(s)]
+            assert s is not source
+            assert s._prereleases is source._prereleases
+            s.prereleases = not source.prereleases
+            assert s.prereleases != source.prereleases
+        result.specifier.prereleases = not override
+        assert specifier._prereleases is override
+
+    def test_subclass(self) -> None:
+        class CustomRequirement(Requirement):
+            def __init__(self, requirement_string: str) -> None:
+                super().__init__(requirement_string)
+                self.initial_name = self.name
+
+        result = CustomRequirement("foo").__replace__(name="bar")
+        assert isinstance(result, CustomRequirement)
+        assert result.initial_name == "bar"
+
+    def test_copy_replace(self) -> None:
+        if not hasattr(copy, "replace"):
+            pytest.skip("copy.replace requires Python 3.13+")
+        result = copy.replace(Requirement("foo>=1"), specifier=SpecifierSet(">=3"))
+        assert result == Requirement("foo>=3")
+
+
+def test_replace_preserves_duplicate_specifier_overrides() -> None:
+    specs = (
+        Specifier(">=1", prereleases=True),
+        Specifier(">=1", prereleases=False),
+    )
+    original = Requirement("foo")
+    original.specifier = SpecifierSet(specs)
+    result = original.__replace__()
+    assert len(original.specifier) == len(result.specifier) == 2
+    for source, cloned in zip(original.specifier, result.specifier, strict=True):
+        assert cloned is not source
+        assert cloned._prereleases is source._prereleases
+
+
+def test_replace_clear_fields() -> None:
+    original = Requirement('foo[bar] @ https://example.com ; os_name == "posix"')
+    result = original.__replace__(url=None, extras=set(), marker=None)
+    assert str(result) == "foo"
+    assert original.url == "https://example.com"
+    assert original.extras == {"bar"}
+    assert original.marker == Marker('os_name == "posix"')
