@@ -1085,3 +1087,126 @@ def test_pickle_requirement_25_0_format_loads() -> None:
     assert str(r.specifier) == ">=2.0"
     assert r.marker is None
     assert r == Requirement("requests>=2.0")
+
+
+@pytest.mark.parametrize(
+    ("changes", "expected"),
+    [
+        ({}, 'requests[security]>=2.0; python_version >= "3"'),
+        ({"name": "flask"}, 'flask[security]>=2.0; python_version >= "3"'),
+        ({"extras": {"tests"}}, 'requests[tests]>=2.0; python_version >= "3"'),
+        ({"extras": set()}, 'requests>=2.0; python_version >= "3"'),
+        (
+            {"specifier": SpecifierSet(">=3.0")},
+            'requests[security]>=3.0; python_version >= "3"',
+        ),
+        ({"marker": None}, "requests[security]>=2.0"),
+        (
+            {"marker": Marker('extra == "Foo_Bar"')},
+            'requests[security]>=2.0; extra == "foo-bar"',
+        ),
+        (
+            {"url": "https://example.org/pkg", "specifier": SpecifierSet()},
+            'requests[security] @ https://example.org/pkg ; python_version >= "3"',
+        ),
+    ],
+)
+def test_replace(changes: dict[str, Any], expected: str) -> None:
+    original = 'requests[security]>=2.0; python_version >= "3"'
+    requirement = Requirement(original)
+    result = requirement.__replace__(**changes)
+    assert result is not requirement
+    assert str(result) == expected
+    assert result == Requirement(str(result))
+    assert str(requirement) == original
+    assert result.extras is not requirement.extras
+    if result.marker is not None:
+        assert result.marker is not requirement.marker
+
+
+@pytest.mark.parametrize(
+    "changes",
+    [
+        {"name": "not a name!"},
+        {"name": "foo[bar]"},
+        {"name": "foo>=1"},
+        {"extras": {"a,b"}},
+        {"extras": {""}},
+        {"url": ""},
+        {"url": 'https://example.org/pkg ; os_name == "posix"'},
+        {"url": "https://example.org/pkg", "specifier": SpecifierSet(">=1")},
+    ],
+)
+def test_replace_invalid(changes: dict[str, Any]) -> None:
+    with pytest.raises(InvalidRequirement):
+        Requirement("foo").__replace__(**changes)
+
+
+def test_replace_arguments() -> None:
+    requirement = Requirement("foo")
+    with pytest.raises(TypeError):
+        requirement.__replace__(unknown="bar")
+    with pytest.raises(TypeError):
+        requirement.__replace__("bar")
+
+
+@pytest.mark.parametrize("set_override", [None, False, True])
+@pytest.mark.parametrize("individual_override", [None, False, True])
+@pytest.mark.parametrize("replace_specifier", [False, True])
+def test_replace_prereleases(
+    set_override: bool | None,
+    individual_override: bool | None,
+    replace_specifier: bool,
+) -> None:
+    requirement = Requirement("foo>=1a1,<3")
+    source = SpecifierSet(">=2a1,<4") if replace_specifier else requirement.specifier
+    source.prereleases = set_override
+    for spec in source:
+        spec.prereleases = individual_override
+    changes = {"specifier": source} if replace_specifier else {}
+    result = requirement.__replace__(**changes)
+    assert result.specifier is not source
+    assert result.specifier._prereleases is set_override
+    originals = {str(s): s for s in source}
+    for spec in result.specifier:
+        assert spec is not originals[str(spec)]
+        assert spec._prereleases is individual_override
+        assert spec.prereleases == originals[str(spec)].prereleases
+        spec.prereleases = not individual_override
+        assert originals[str(spec)]._prereleases is individual_override
+    result.specifier.prereleases = not set_override
+    assert source._prereleases is set_override
+
+
+def test_replace_subclass() -> None:
+    class CustomRequirement(Requirement):
+        def __init__(self, requirement_string: str) -> None:
+            super().__init__(requirement_string)
+            self.initialized_name = self.name
+
+    result = CustomRequirement("foo").__replace__(name="bar")
+    assert isinstance(result, CustomRequirement)
+    assert result.initialized_name == "bar"
+
+
+def test_copy_replace() -> None:
+
+    if not hasattr(copy, "replace"):
+        pytest.skip("copy.replace requires Python 3.13+")
+    result = copy.replace(Requirement("requests>=2.0"), specifier=SpecifierSet(">=3.0"))
+    assert result == Requirement("requests>=3.0")
+
+
+def test_replace_clear_url() -> None:
+    result = Requirement("foo @ https://example.org/pkg").__replace__(url=None)
+    assert str(result) == "foo"
+
+
+def test_replace_preserves_duplicate_specifier_overrides() -> None:
+    source = SpecifierSet(
+        [Specifier(">=1", prereleases=True), Specifier(">=1", prereleases=False)]
+    )
+    result = Requirement("foo").__replace__(specifier=source)
+    assert [s._prereleases for s in source] == [True, False]
+    assert [s._prereleases for s in result.specifier] == [True, False]
+    assert all(a is not b for a, b in zip(source, result.specifier, strict=True))
