 class InvalidRequirement(ValueError):
     """
     Raised when attempting to create a :class:`Requirement` with a string that
@@ -106,6 +111,62 @@ class Requirement:
             self.marker = Marker.__new__(Marker)
             self.marker._markers = _normalize_extra_values(parsed.marker)
 
+    def __replace__(
+        self,
+        *,
+        name: str = _UNSET,
+        url: str | None = _UNSET,
+        extras: set[str] = _UNSET,
+        specifier: SpecifierSet = _UNSET,
+        marker: Marker | None = _UNSET,
+    ) -> Self:
+        """Return a new requirement with the given fields replaced.
+
+        Omitted fields are preserved. Values are validated and normalized as
+        when parsing a requirement string. The result has independent mutable
+        fields, including the specifier set and its individual specifiers, whose
+        prerelease settings are preserved.
+
+        Supports :func:`copy.replace` on Python 3.13 and later, and can be
+        called directly on older Python versions.
+
+        :raises InvalidRequirement: If the fields cannot be represented by a
+            requirement string without changing their meaning.
+        :raises TypeError: If an unknown keyword argument is given.
+
+        .. versionadded:: 26.4
+        """
+        parts = Requirement.__new__(Requirement)
+        parts.name = self.name if name is _UNSET else name
+        parts.url = self.url if url is _UNSET else url
+        parts.extras = self.extras if extras is _UNSET else extras
+        source_specifier = self.specifier if specifier is _UNSET else specifier
+        # String parsing loses explicit prerelease overrides. Copy before
+        # formatting, which may deduplicate the set's internal specifiers.
+        copied_specifier = SpecifierSet(
+            (Specifier(str(s), prereleases=s._prereleases) for s in source_specifier),
+            prereleases=source_specifier._prereleases,
+        )
+        parts.specifier = SpecifierSet(copied_specifier)
+        parts.marker = self.marker if marker is _UNSET else marker
+
+        result = self.__class__(str(parts))
+        # Parsing must not reinterpret a field as another part of the
+        # requirement (for example, a name containing extras or a URL with
+        # a marker). Compare spelling as well as meaning for names and extras.
+        if (
+            result.name != parts.name
+            or result.url != parts.url
+            or result.extras != parts.extras
+            or result.specifier != parts.specifier
+            or result.marker
+            != (Marker(str(parts.marker)) if parts.marker is not None else None)
+        ):
+            raise InvalidRequirement("Replacement fields do not round-trip")
+
+        result.specifier = copied_specifier
+        return result
+
     def _iter_parts(self, name: str) -> Iterator[str]:
         yield name
 
