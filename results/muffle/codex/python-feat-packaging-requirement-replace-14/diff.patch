@@ -124,6 +124,54 @@ class Requirement:
         if self.marker:
             yield f"; {self.marker}"
 
+    def __replace__(self, **changes: object) -> Requirement:
+        """Return a new requirement with the specified fields replaced.
+
+        Accepts the keyword arguments ``name``, ``url``, ``extras``,
+        ``specifier``, and ``marker``, with the same types as the corresponding
+        attributes. The result is validated and normalized by parsing it.
+
+        Supports :func:`copy.replace` on Python 3.13 and later.
+
+        :raises TypeError: If an unknown keyword is supplied.
+        :raises InvalidRequirement: If the resulting fields cannot be represented
+            by a requirement string without changing their meaning.
+        """
+        for field in changes:
+            if field not in Requirement.__slots__:
+                raise TypeError(f"Unexpected field for Requirement: {field!r}")
+
+        # Use a base instance to format the proposed fields before invoking the
+        # subclass constructor, so its initialization runs on validated input.
+        proposed = Requirement.__new__(Requirement)
+        proposed.name = cast("str", changes.get("name", self.name))
+        proposed.url = cast("str | None", changes.get("url", self.url))
+        proposed.extras = cast("set[str]", changes.get("extras", self.extras))
+        proposed.specifier = cast(
+            "SpecifierSet", changes.get("specifier", self.specifier)
+        )
+        proposed.marker = cast("Marker | None", changes.get("marker", self.marker))
+        parsed = Requirement(str(proposed))
+        # Equality deliberately normalizes names and extras. Here their exact
+        # spelling must survive, to reject syntax embedded in a field value.
+        if (
+            parsed.name != proposed.name
+            or parsed.url != proposed.url
+            or parsed.extras != proposed.extras
+            or parsed.specifier != proposed.specifier
+            or parsed.marker != proposed.marker
+        ):
+            raise InvalidRequirement("Replacement fields do not round-trip")
+
+        result = type(self)(str(parsed))
+        # Parsing cannot preserve explicit prerelease overrides. Clone each
+        # specifier as well as the set because both expose mutable settings.
+        result.specifier = SpecifierSet(
+            (Specifier(str(s), prereleases=s._prereleases) for s in proposed.specifier),
+            prereleases=proposed.specifier._prereleases,
+        )
+        return result
+
     def __getstate__(self) -> tuple[str, bool | None]:
