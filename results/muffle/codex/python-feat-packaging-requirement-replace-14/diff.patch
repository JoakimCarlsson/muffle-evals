diff --git a/tests/test_requirements.py b/tests/test_requirements.py
index ad78c2b..50177af 100644
--- a/tests/test_requirements.py
+++ b/tests/test_requirements.py
@@ -4,6 +4,7 @@
 
 from __future__ import annotations
 
+import copy
 import pickle
 
 import pytest
@@ -1085,3 +1086,113 @@ def test_pickle_requirement_25_0_format_loads() -> None:
     assert str(r.specifier) == ">=2.0"
     assert r.marker is None
     assert r == Requirement("requests>=2.0")
+
+
+@pytest.mark.parametrize(
+    "changes",
+    [
+        {},
+        {"name": "flask"},
+        {"extras": {"other", "Foo_Bar"}},
+        {"specifier": SpecifierSet(">=3.0")},
+        {"marker": Marker('extra == "Foo_Bar"')},
+        {"marker": None},
+        {"extras": set(), "specifier": SpecifierSet(), "url": "https://example.com"},
+    ],
+)
+def test_replace(changes: dict[str, object]) -> None:
+    original = Requirement('requests[security]>=2.0; python_version >= "3"')
+    before = str(original)
+    result = original.__replace__(**changes)
+    assert result is not original
+    assert str(original) == before
+    assert result == Requirement(str(result))
+    for field in Requirement.__slots__:
+        assert getattr(result, field) == changes.get(field, getattr(original, field))
+    assert result.extras is not original.extras
+    assert result.marker is not original.marker or result.marker is None
+
+
+def test_replace_url() -> None:
+    original = Requirement("requests @ https://example.com")
+    assert original.__replace__(url=None, specifier=SpecifierSet(">=3")) == Requirement(
+        "requests>=3"
+    )
+    assert original.__replace__(url="https://other.example.com") == Requirement(
+        "requests @ https://other.example.com"
+    )
+
+
+@pytest.mark.parametrize(
+    "changes",
+    [
+        {"name": "not a name!"},
+        {"name": "foo[bar]"},
+        {"name": "foo>=1"},
+        {"name": " foo "},
+        {"extras": {"a,b"}},
+        {"extras": {""}},
+        {"url": ""},
+        {"url": "https://example.com ; os_name == 'posix'"},
+        {"url": "https://example.com", "specifier": SpecifierSet(">=1")},
+    ],
+)
+def test_replace_invalid(changes: dict[str, object]) -> None:
+    with pytest.raises(InvalidRequirement):
+        Requirement("foo").__replace__(**changes)
+
+
+def test_replace_arguments() -> None:
+    with pytest.raises(TypeError):
+        Requirement("foo").__replace__(unknown="value")
+    with pytest.raises(TypeError):
+        Requirement("foo").__replace__("bar")  # type: ignore[call-arg]
+
+
+@pytest.mark.parametrize("override", [None, False, True])
+@pytest.mark.parametrize("individual_override", [None, False, True])
+@pytest.mark.parametrize("replace_specifier", [False, True])
+def test_replace_prereleases(
+    override: bool | None,
+    individual_override: bool | None,
+    replace_specifier: bool,
+) -> None:
+    original = Requirement("foo>=1,!=2")
+    specifier = SpecifierSet(">=3,!=4") if replace_specifier else original.specifier
+    specifier.prereleases = override
+    for item in specifier:
+        item.prereleases = individual_override
+    result = (
+        original.__replace__(specifier=specifier)
+        if replace_specifier
+        else original.__replace__()
+    )
+    assert result.specifier is not specifier
+    assert result.specifier._prereleases is override
+    source_items = {str(item): item for item in specifier}
+    for item in result.specifier:
+        assert item is not source_items[str(item)]
+        assert item._prereleases is individual_override
+        item.prereleases = not individual_override
+        assert source_items[str(item)]._prereleases is individual_override
+    result.specifier.prereleases = not override
+    assert specifier._prereleases is override
+
+
+def test_replace_subclass() -> None:
+    class CustomRequirement(Requirement):
+        def __init__(self, requirement_string: str) -> None:
+            super().__init__(requirement_string)
+            self.initialized_name = self.name
+
+    result = CustomRequirement("foo").__replace__(name="bar")
+    assert isinstance(result, CustomRequirement)
+    assert result.initialized_name == "bar"
+
+
+def test_copy_replace() -> None:
+    if not hasattr(copy, "replace"):
+        pytest.skip("copy.replace requires Python 3.13+")
+    assert copy.replace(Requirement("requests>=2.0"), name="flask") == Requirement(
+        "flask>=2.0"
+    )
