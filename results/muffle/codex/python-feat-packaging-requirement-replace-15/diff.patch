@@ -8,11 +8,22 @@ from typing import TYPE_CHECKING
 from ._parser import parse_requirement as _parse_requirement
 from ._tokenizer import ParserSyntaxError
 from .markers import Marker, _normalize_extra_values
-from .specifiers import InvalidSpecifier, SpecifierSet
+from .specifiers import InvalidSpecifier, Specifier, SpecifierSet
 from .utils import canonicalize_name
 
 if TYPE_CHECKING:
     from collections.abc import Iterator
+    from typing import TypedDict
+
+    from typing_extensions import Self, Unpack
+
+    class _RequirementChanges(TypedDict, total=False):
+        name: str
+        url: str | None
+        extras: set[str]
+        specifier: SpecifierSet
+        marker: Marker | None
+
 
 __all__ = [
     "InvalidRequirement",
@@ -106,6 +117,63 @@ class Requirement:
             self.marker = Marker.__new__(Marker)
             self.marker._markers = _normalize_extra_values(parsed.marker)
 
+    def __replace__(self, **changes: Unpack[_RequirementChanges]) -> Self:
+        """Return a new requirement with the given fields replaced.
+
+        Accepts ``name``, ``url``, ``extras``, ``specifier`` and ``marker`` as
+        keyword arguments. The result is validated and normalized as when parsing
+        a requirement string. Invalid or ambiguous field values raise
+        :class:`InvalidRequirement`; unknown keywords raise :class:`TypeError`.
+
+        Specifier prerelease overrides are preserved, with independent copies
+        of the specifier set and its individual specifiers.
+        """
+        fields = ("name", "url", "extras", "specifier", "marker")
+        for field in changes:
+            if field not in fields:
+                raise TypeError(f"Unexpected keyword argument {field!r}")
+
+        candidate = Requirement.__new__(Requirement)
+        for field in fields:
+            setattr(candidate, field, changes.get(field, getattr(self, field)))
+
+        # Use the dynamically assigned values here to validate untyped callers too.
+        values: dict[str, object] = {
+            field: getattr(candidate, field) for field in fields
+        }
+        extras = values["extras"]
+        if not (
+            isinstance(values["name"], str)
+            and (values["url"] is None or isinstance(values["url"], str))
+            and isinstance(extras, set)
+            and all(isinstance(extra, str) for extra in extras)
+            and isinstance(values["specifier"], SpecifierSet)
+            and (values["marker"] is None or isinstance(values["marker"], Marker))
+        ):
+            raise InvalidRequirement("Invalid requirement field value")
+
+        result = type(self)(str(candidate))
+        # Parsing must not reinterpret one field as part of another, or silently
+        # drop values such as an empty URL or an extra containing a comma.
+        if (
+            result.name != candidate.name
+            or result.url != candidate.url
+            or result.extras != candidate.extras
+            or str(result.specifier) != str(candidate.specifier)
+            or result.marker
+            != (Marker(str(candidate.marker)) if candidate.marker is not None else None)
+        ):
+            raise InvalidRequirement("Requirement fields do not round-trip")
+
+        result.specifier = SpecifierSet(
+            (
+                Specifier(str(spec), prereleases=spec._prereleases)
+                for spec in candidate.specifier
+            ),
+            prereleases=candidate.specifier._prereleases,
+        )
+        return result
+
     def _iter_parts(self, name: str) -> Iterator[str]:
         yield name
 
diff --git a/tests/test_requirements.py b/tests/test_requirements.py
index ad78c2b..68ec1a9 100644
--- a/tests/test_requirements.py
+++ b/tests/test_requirements.py
@@ -4,6 +4,7 @@
 
 from __future__ import annotations
 
+import copy
 import pickle
 
 import pytest
@@ -1085,3 +1086,100 @@ def test_pickle_requirement_25_0_format_loads() -> None:
     assert str(r.specifier) == ">=2.0"
     assert r.marker is None
     assert r == Requirement("requests>=2.0")
+
+
+class TestRequirementReplace:
+    def test_fields(self) -> None:
+        original = Requirement('requests[security]>=2; python_version >= "3"')
+        result = original.__replace__(name="flask")
+        assert str(result) == 'flask[security]>=2; python_version >= "3"'
+        assert original.name == "requests"
+        assert result.extras is not original.extras
+        assert result.marker is not original.marker
+        assert original.__replace__() == original
+        assert original.__replace__() is not original
+        assert str(original.__replace__(extras=set(), marker=None)) == "requests>=2"
+        assert str(original.__replace__(specifier=SpecifierSet(">=3"))) == (
+            'requests[security]>=3; python_version >= "3"'
+        )
+        assert str(
+            original.__replace__(url="https://example.com", specifier=SpecifierSet())
+        ) == ('requests[security] @ https://example.com ; python_version >= "3"')
+        assert Requirement("demo @ https://example.com").__replace__(
+            url=None
+        ) == Requirement("demo")
+
+    def test_marker_normalization(self) -> None:
+        result = Requirement("demo").__replace__(marker=Marker('extra == "Foo_Bar"'))
+        assert str(result.marker) == 'extra == "foo-bar"'
+        assert result == Requirement(str(result))
+
+    @pytest.mark.parametrize(
+        "changes",
+        [
+            {"name": "not a name!"},
+            {"name": "foo[bar]"},
+            {"name": "foo>=2"},
+            {"extras": {"a,b"}},
+            {"extras": {""}},
+            {"url": ""},
+            {"url": 'https://example.com ; os_name == "posix"'},
+            {"url": "https://example.com"},
+            {"name": None},
+            {"specifier": ">=3"},
+            {"marker": "invalid"},
+            {"extras": ["a"]},
+        ],
+    )
+    def test_invalid_fields(self, changes: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("demo>=1").__replace__(**changes)  # type: ignore[arg-type]
+
+    def test_arguments(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("demo").__replace__(unknown="x")  # type: ignore[call-arg]
+        with pytest.raises(TypeError):
+            Requirement("demo").__replace__("x")  # type: ignore[call-arg]
+
+    @pytest.mark.parametrize("override", [None, True, False])
+    @pytest.mark.parametrize("replace_specifier", [False, True])
+    def test_specifier_independence(
+        self, override: bool | None, replace_specifier: bool
+    ) -> None:
+        original = Requirement("demo>=1a1,<3")
+        source = SpecifierSet(">=2a1,<4") if replace_specifier else original.specifier
+        source.prereleases = override
+        for spec in source:
+            spec.prereleases = spec.operator == ">="
+        result = (
+            original.__replace__(specifier=source)
+            if replace_specifier
+            else original.__replace__()
+        )
+        assert result.specifier is not source
+        assert result.specifier._prereleases is override
+        before = {str(spec): spec for spec in source}
+        for spec in result.specifier:
+            assert spec is not before[str(spec)]
+            assert spec._prereleases is before[str(spec)]._prereleases
+            spec.prereleases = not spec.prereleases
+            assert spec.prereleases != before[str(spec)].prereleases
+        result.specifier.prereleases = not override
+        assert source._prereleases is override
+
+    def test_subclass(self) -> None:
+        class CustomRequirement(Requirement):
+            def __init__(self, requirement_string: str) -> None:
+                super().__init__(requirement_string)
+                self.initialized_name = self.name
+
+        result = CustomRequirement("demo").__replace__(name="other")
+        assert isinstance(result, CustomRequirement)
+        assert result.initialized_name == "other"
+
+    def test_copy_replace(self) -> None:
+        if not hasattr(copy, "replace"):
+            pytest.skip("copy.replace requires Python 3.13+")
+        assert copy.replace(Requirement("demo>=1"), name="other") == Requirement(
+            "other>=1"
+        )
