+class TestRequirementReplace:
+    def test_fields(self) -> None:
+        original = Requirement('requests[security]>=2; python_version >= "3"')
+        replacement = original.__replace__(
+            name="flask",
+            extras={"tests"},
+            specifier=SpecifierSet(),
+            url="https://example.com/flask.whl",
+            marker=None,
+        )
+        assert replacement == Requirement(
+            "flask[tests] @ https://example.com/flask.whl"
+        )
+        assert str(original) == 'requests[security]>=2; python_version >= "3"'
+        assert original.__replace__(name="flask") == Requirement(
+            'flask[security]>=2; python_version >= "3"'
+        )
+
+    def test_no_changes(self) -> None:
+        original = Requirement('requests[security]>=2; python_version >= "3"')
+        replacement = original.__replace__()
+        assert replacement == original
+        assert replacement is not original
+        assert replacement.extras is not original.extras
+        assert replacement.marker is not original.marker
+
+    def test_normalization(self) -> None:
+        marker = Marker('extra == "Foo_Bar"')
+        replacement = Requirement("foo").__replace__(marker=marker)
+        assert str(replacement.marker) == 'extra == "foo-bar"'
+        assert replacement == Requirement(str(replacement))
+
+    @pytest.mark.parametrize(
+        "changes",
+        [
+            {"name": "not a name!"},
+            {"name": "foo[bar]"},
+            {"name": " foo "},
+            {"extras": {"a,b"}},
+            {"extras": {""}},
+            {"url": ""},
+            {"url": 'https://example.com ; python_version >= "3"'},
+            {"name": None},
+            {"specifier": None},
+            {"extras": {1}},
+        ],
+    )
+    def test_invalid_fields(self, changes: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("foo").__replace__(**changes)  # type: ignore[arg-type]
+
+    def test_url_and_specifier_conflict(self) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("foo>=1").__replace__(url="https://example.com")
+
+    def test_arguments(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("foo").__replace__(unknown="bar")  # type: ignore[call-arg]
+        with pytest.raises(TypeError):
+            Requirement("foo").__replace__("bar")  # type: ignore[call-arg]
+
+    @pytest.mark.parametrize("override", [None, False, True])
+    @pytest.mark.parametrize("replace_specifier", [False, True])
+    def test_prereleases(self, override: bool | None, replace_specifier: bool) -> None:
+        original = Requirement("foo>=1a1,<3,!=2")
+        specifiers = SpecifierSet(">=1a1,<3,!=2", prereleases=override)
+        for spec, value in zip(specifiers, (None, False, True), strict=True):
+            spec.prereleases = value
+        original.specifier = specifiers
+        if replace_specifier:
+            replacement = Requirement("foo").__replace__(specifier=specifiers)
+        else:
+            replacement = original.__replace__()
+        assert replacement.specifier is not specifiers
+        assert replacement.specifier._prereleases is override
+        for source, copied in zip(specifiers, replacement.specifier, strict=True):
+            assert source == copied
+            assert source is not copied
+            assert source._prereleases is copied._prereleases
+            copied.prereleases = not source.prereleases
+            assert source.prereleases != copied.prereleases
+
+    def test_subclass(self) -> None:
+        class CustomRequirement(Requirement):
+            def __init__(self, requirement_string: str) -> None:
+                super().__init__(requirement_string)
+                self.initialized_with = requirement_string
+
+        replacement = CustomRequirement("foo").__replace__(name="bar")
+        assert isinstance(replacement, CustomRequirement)
+        assert replacement.initialized_with == "bar"
+
+    @pytest.mark.skipif(not hasattr(copy, "replace"), reason="Python 3.13+")
+    def test_copy_replace(self) -> None:
+        assert copy.replace(Requirement("foo>=1"), specifier=SpecifierSet(">=2")) == (  # type: ignore[attr-defined]
+            Requirement("foo>=2")
+        )
