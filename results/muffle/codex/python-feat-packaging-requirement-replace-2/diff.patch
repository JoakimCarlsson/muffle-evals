 class InvalidRequirement(ValueError):
     """
     Raised when attempting to create a :class:`Requirement` with a string that
@@ -106,6 +112,71 @@ class Requirement:
             self.marker = Marker.__new__(Marker)
             self.marker._markers = _normalize_extra_values(parsed.marker)
 
+    def __replace__(
+        self,
+        *,
+        name: str = _UNSET,
+        url: str | None = _UNSET,
+        extras: set[str] = _UNSET,
+        specifier: SpecifierSet = _UNSET,
+        marker: Marker | None = _UNSET,
+    ) -> Self:
+        """Return a new requirement with the specified fields replaced.
+
+        Omitted fields are retained. The result is parsed and normalized as a
+        requirement, and mutable specifiers are copied, including their
+        prerelease settings. Subclass constructors are called with the new
+        requirement string.
+
+        Supports :func:`copy.replace` on Python 3.13 and later, and can be
+        called directly on earlier Python versions.
+
+        :raises InvalidRequirement: If the fields cannot be represented by a
+            requirement string without changing their meaning.
+
+        .. versionadded:: 26.4
+        """
+        candidate = Requirement.__new__(Requirement)
+        candidate.name = self.name if name is _UNSET else name
+        candidate.url = self.url if url is _UNSET else url
+        candidate.extras = self.extras if extras is _UNSET else extras
+        candidate.specifier = self.specifier if specifier is _UNSET else specifier
+        candidate.marker = self.marker if marker is _UNSET else marker
+
+        for field, expected_type in (
+            ("name", str),
+            ("url", (str, type(None))),
+            ("extras", set),
+            ("specifier", SpecifierSet),
+            ("marker", (Marker, type(None))),
+        ):
+            if not isinstance(getattr(candidate, field), expected_type):
+                raise InvalidRequirement(
+                    f"Invalid type for requirement field {field!r}"
+                )
+        if not all(isinstance(extra, str) for extra in candidate.extras):
+            raise InvalidRequirement("Extras must be strings")
+
+        result = self.__class__(str(candidate))
+        # Compare individual fields, rather than Requirement equality, which
+        # canonicalizes names and extras and could hide changes during parsing.
+        for field in ("name", "url", "extras", "specifier", "marker"):
+            if getattr(result, field) != getattr(candidate, field):
+                raise InvalidRequirement(
+                    f"The {field!r} field cannot be represented without changes"
+                )
+
+        # Parsing cannot preserve explicit prerelease overrides. Rebuild each
+        # specifier so neither the set nor its mutable members are shared.
+        result.specifier = SpecifierSet(
+            (
+                Specifier(str(s), prereleases=s._prereleases)
+                for s in candidate.specifier
+            ),
+            prereleases=candidate.specifier._prereleases,
+        )
+        return result
+
     def _iter_parts(self, name: str) -> Iterator[str]:
         yield name
 
