 class InvalidRequirement(ValueError):
     """
     Raised when attempting to create a :class:`Requirement` with a string that
@@ -106,6 +111,71 @@ class Requirement:
             self.marker = Marker.__new__(Marker)
             self.marker._markers = _normalize_extra_values(parsed.marker)
 
+    def __replace__(
+        self,
+        *,
+        name: str = _UNSET,
+        url: str | None = _UNSET,
+        extras: set[str] = _UNSET,
+        specifier: SpecifierSet = _UNSET,
+        marker: Marker | None = _UNSET,
+    ) -> Self:
+        """Return a new requirement with the given fields replaced.
+
+        Omitted fields are retained. The result is validated and normalized
+        by parsing its string representation. Mutable fields are copied,
+        including specifier prerelease overrides.
+
+        Supports :func:`copy.replace` on Python 3.13 and later, and can be
+        called directly on older Python versions.
+
+        :raises InvalidRequirement: If the fields cannot be represented as
+            a requirement without changing their meaning.
+
+        .. versionadded:: 26.4
+        """
+        candidate = Requirement.__new__(Requirement)
+        candidate.name = self.name if name is _UNSET else name
+        candidate.url = self.url if url is _UNSET else url
+        candidate.extras = self.extras if extras is _UNSET else extras
+        candidate.specifier = self.specifier if specifier is _UNSET else specifier
+        candidate.marker = self.marker if marker is _UNSET else marker
+
+        field_types = (
+            (candidate.name, str),
+            (candidate.url, (str, type(None))),
+            (candidate.extras, set),
+            (candidate.specifier, SpecifierSet),
+            (candidate.marker, (Marker, type(None))),
+        )
+        for value, expected_type in field_types:
+            if not isinstance(value, expected_type):
+                raise InvalidRequirement("Invalid requirement field types")
+        if not all(isinstance(extra, str) for extra in candidate.extras):
+            raise InvalidRequirement("Invalid requirement extras")
+
+        # Reconstruct each specifier to avoid sharing mutable objects. Using
+        # the explicit override preserves None as well as True and False.
+        candidate.specifier = SpecifierSet(
+            [
+                Specifier(str(spec), prereleases=spec._prereleases)
+                for spec in candidate.specifier
+            ],
+            prereleases=candidate.specifier._prereleases,
+        )
+        parsed = type(self)(str(candidate))
+        # A syntactically valid string can still reinterpret a field, e.g.
+        # name="foo[bar]" or extras={"a,b"}. Reject such changes.
+        if (
+            parsed.name != candidate.name
+            or parsed.url != candidate.url
+            or parsed.extras != candidate.extras
+            or str(parsed.specifier) != str(candidate.specifier)
+        ):
+            raise InvalidRequirement("Requirement fields do not round-trip")
+        parsed.specifier = candidate.specifier
+        return parsed
+
     def _iter_parts(self, name: str) -> Iterator[str]:
         yield name
 
