+
+
+class TestRequirementReplace:
+    def test_fields(self) -> None:
+        original = Requirement('requests[security]>=2; python_version >= "3"')
+        result = original.__replace__(name="flask")
+        assert str(result) == 'flask[security]>=2; python_version >= "3"'
+        assert original.name == "requests"
+        assert result == Requirement(str(result))
+        clone = original.__replace__()
+        assert clone == original
+        assert clone is not original
+        assert clone.extras is not original.extras
+        assert clone.marker is not original.marker
+
+    def test_replace_all(self) -> None:
+        original = Requirement("requests>=2")
+        result = original.__replace__(
+            name="flask",
+            extras={"test"},
+            url="https://example.com/flask.whl",
+            specifier=SpecifierSet(),
+            marker=Marker('extra == "Foo_Bar"'),
+        )
+        assert str(result) == (
+            'flask[test] @ https://example.com/flask.whl ; extra == "foo-bar"'
+        )
+        assert result.__replace__(url=None, marker=None, extras=set()) == Requirement(
+            "flask"
+        )
+        assert original == Requirement("requests>=2")
+
+    @pytest.mark.parametrize(
+        "changes",
+        [
+            {"name": "not a name!"},
+            {"name": "foo[bar]"},
+            {"name": "foo>=1"},
+            {"name": " foo "},
+            {"extras": {"a,b"}},
+            {"extras": {"bad extra"}},
+            {"url": ""},
+            {"url": 'https://example.com ; os_name == "posix"'},
+            {"url": "https://example.com"},  # Cannot coexist with a specifier.
+            {"name": None},
+            {"extras": "test"},
+            {"specifier": ">=1"},
+            {"marker": "os_name == 'posix'"},
+        ],
+    )
+    def test_invalid(self, changes: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("requests>=2").__replace__(**changes)  # type: ignore[arg-type]
+
+    def test_arguments(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("foo").__replace__(unknown="bar")  # type: ignore[call-arg]
+        with pytest.raises(TypeError):
+            Requirement("foo").__replace__("bar")  # type: ignore[call-arg]
+
+    @pytest.mark.parametrize("override", [None, True, False])
+    @pytest.mark.parametrize("replace_specifier", [True, False])
+    def test_prereleases(self, override: bool | None, replace_specifier: bool) -> None:
+        original = Requirement("foo>=1a1,<3,!=2")
+        specifiers = SpecifierSet(">=1a1,<3,!=2", prereleases=override)
+        for spec, setting in zip(specifiers, [None, True, False], strict=True):
+            spec.prereleases = setting
+        if replace_specifier:
+            result = original.__replace__(specifier=specifiers)
+        else:
+            original.specifier = specifiers
+            result = original.__replace__()
+        assert result.specifier is not specifiers
+        assert result.specifier._prereleases is override
+        source = {str(spec): spec for spec in specifiers}
+        for spec in result.specifier:
+            assert spec is not source[str(spec)]
+            assert spec._prereleases is source[str(spec)]._prereleases
+            spec.prereleases = not spec.prereleases
+            assert spec._prereleases is not source[str(spec)]._prereleases
+
+    def test_subclass(self) -> None:
+        class CustomRequirement(Requirement):
+            def __init__(self, requirement_string: str) -> None:
+                super().__init__(requirement_string)
+                self.initialized_name = self.name
+
+        result = CustomRequirement("foo").__replace__(name="bar")
+        assert isinstance(result, CustomRequirement)
+        assert result.initialized_name == "bar"
+
+    def test_copy_replace(self) -> None:
+        if not hasattr(copy, "replace"):
+            pytest.skip("copy.replace requires Python 3.13+")
+        result = copy.replace(Requirement("requests>=2"), specifier=SpecifierSet(">=3"))
+        assert result == Requirement("requests>=3")
