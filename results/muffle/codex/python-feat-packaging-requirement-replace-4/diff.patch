+
+
+class TestRequirementReplace:
+    @pytest.mark.parametrize(
+        ("field", "value", "expected"),
+        [
+            ("name", "flask", 'flask[security]>=2; python_version >= "3"'),
+            ("extras", {"tests"}, 'requests[tests]>=2; python_version >= "3"'),
+            (
+                "specifier",
+                SpecifierSet(">=3"),
+                'requests[security]>=3; python_version >= "3"',
+            ),
+            ("marker", None, "requests[security]>=2"),
+            (
+                "marker",
+                Marker('extra == "Foo_Bar"'),
+                'requests[security]>=2; extra == "foo-bar"',
+            ),
+        ],
+    )
+    def test_replace(self, field: str, value: object, expected: str) -> None:
+        original = Requirement('requests[security]>=2; python_version >= "3"')
+        result = original.__replace__(**{field: value})  # type: ignore[arg-type]
+        assert str(result) == expected
+        assert result == Requirement(str(result))
+        assert str(original) == 'requests[security]>=2; python_version >= "3"'
+
+    def test_url(self) -> None:
+        original = Requirement("requests>=2")
+        result = original.__replace__(
+            url="https://example.com/pkg", specifier=SpecifierSet()
+        )
+        assert str(result) == "requests @ https://example.com/pkg"
+        assert str(result.__replace__(url=None)) == "requests"
+
+    def test_copy(self) -> None:
+        original = Requirement('requests[security]>=2; python_version >= "3"')
+        result = original.__replace__()
+        assert result == original
+        assert result is not original
+        assert result.extras is not original.extras
+        assert result.marker is not original.marker
+
+    @pytest.mark.parametrize("explicit", [True, False, None])
+    @pytest.mark.parametrize("replace_specifier", [True, False])
+    def test_specifier_copy(
+        self, explicit: bool | None, replace_specifier: bool
+    ) -> None:
+        original = Requirement("requests>=2,<4,!=3")
+        specifier = original.specifier
+        specifier.prereleases = explicit
+        for item, override in zip(specifier, [True, False, None], strict=True):
+            item.prereleases = override
+        before = {str(item): item for item in specifier}
+        result = (
+            original.__replace__(specifier=specifier)
+            if replace_specifier
+            else original.__replace__()
+        )
+        assert result.specifier is not specifier
+        assert result.specifier._prereleases is explicit
+        for item in result.specifier:
+            source = before[str(item)]
+            assert item is not source
+            assert item._prereleases is source._prereleases
+            item.prereleases = not source.prereleases
+            assert item.prereleases != source.prereleases
+
+    @pytest.mark.parametrize(
+        "changes",
+        [
+            {"name": "not a name!"},
+            {"name": "foo[bar]"},
+            {"name": "foo "},
+            {"extras": {"a,b"}},
+            {"extras": {""}},
+            {"url": ""},
+            {"url": "https://example.com"},
+            {
+                "url": 'https://example.com ; os_name == "posix"',
+                "specifier": SpecifierSet(),
+            },
+            {"name": None},
+            {"specifier": ">=3"},
+            {"extras": {1}},
+            {"marker": "invalid"},
+        ],
+    )
+    def test_invalid(self, changes: dict[str, object]) -> None:
+        with pytest.raises(InvalidRequirement):
+            Requirement("requests>=2").__replace__(**changes)  # type: ignore[arg-type]
+
+    def test_unknown_keyword(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("requests").__replace__(unknown="value")  # type: ignore[call-arg]
+
+    def test_positional(self) -> None:
+        with pytest.raises(TypeError):
+            Requirement("requests").__replace__("flask")  # type: ignore[call-arg]
+
+    def test_subclass(self) -> None:
+        class CustomRequirement(Requirement):
+            def __init__(self, requirement_string: str) -> None:
+                super().__init__(requirement_string)
+                self.initialized_name = self.name
+
+        result = CustomRequirement("requests").__replace__(name="flask")
+        assert isinstance(result, CustomRequirement)
+        assert result.initialized_name == "flask"
+
+    def test_copy_replace(self) -> None:
+        if not hasattr(copy, "replace"):
+            pytest.skip("copy.replace requires Python 3.13+")
+        assert copy.replace(
+            Requirement("requests>=2"), specifier=SpecifierSet(">=3")
+        ) == Requirement("requests>=3")
