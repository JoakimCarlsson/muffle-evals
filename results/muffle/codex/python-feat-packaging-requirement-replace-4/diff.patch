 class InvalidRequirement(ValueError):
     """
     Raised when attempting to create a :class:`Requirement` with a string that
@@ -106,6 +112,65 @@ class Requirement:
             self.marker = Marker.__new__(Marker)
             self.marker._markers = _normalize_extra_values(parsed.marker)
 
+    def __replace__(
+        self,
+        *,
+        name: str = _UNSET,
+        url: str | None = _UNSET,
+        extras: set[str] = _UNSET,
+        specifier: SpecifierSet = _UNSET,
+        marker: Marker | None = _UNSET,
+    ) -> Self:
+        """Return a new requirement with the given fields replaced.
+
+        Unspecified fields are retained. Values are validated and normalized
+        as when parsing a requirement string. The specifier set and its
+        individual specifiers are copied, preserving prerelease overrides.
+
+        Supports :func:`copy.replace` on Python 3.13 and later.
+
+        :raises InvalidRequirement: If the fields cannot be represented by a
+            requirement string without changing their meaning.
+
+        .. versionadded:: 26.4
+        """
+        candidate = Requirement.__new__(Requirement)
+        candidate.name = self.name if name is _UNSET else name
+        candidate.url = self.url if url is _UNSET else url
+        candidate.extras = self.extras if extras is _UNSET else extras
+        candidate.marker = self.marker if marker is _UNSET else marker
+        source_specifier = self.specifier if specifier is _UNSET else specifier
+        fields: tuple[tuple[object, type | tuple[type, ...]], ...] = (
+            (candidate.name, str),
+            (candidate.extras, set),
+            (source_specifier, SpecifierSet),
+            (candidate.url, (str, type(None))),
+            (candidate.marker, (Marker, type(None))),
+        )
+        if any(not isinstance(value, expected) for value, expected in fields):
+            raise InvalidRequirement("Invalid replacement field value")
+        if not all(isinstance(extra, str) for extra in candidate.extras):
+            raise InvalidRequirement("Invalid replacement extra value")
+
+        # Stringifying a SpecifierSet may canonicalize its internal collection;
+        # work on a copy so even that cannot affect the caller's objects.
+        candidate.specifier = deepcopy(source_specifier)
+        requirement_string = str(candidate)
+        parsed = Requirement(requirement_string)
+        # Parsing must not let text in one field introduce or alter another
+        # field (for example, a name of "foo[bar]" or an extra of "a,b").
+        if (
+            parsed.name != candidate.name
+            or parsed.url != candidate.url
+            or parsed.extras != candidate.extras
+            or parsed.specifier != candidate.specifier
+        ):
+            raise InvalidRequirement("Replacement fields do not round-trip")
+
+        result = self.__class__(requirement_string)
+        result.specifier = candidate.specifier
+        return result
+
     def _iter_parts(self, name: str) -> Iterator[str]:
         yield name
 
