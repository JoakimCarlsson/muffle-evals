+@pytest.mark.parametrize("sibling", ["c.d = 2\n", "c = 2\n", ""])
+def test_replace_dotted_key_with_aot(sibling: str) -> None:
+    doc = parse("a.b = 1\n" + sibling + "[other]\ny = 3\n")
+    aot = tomlkit.aot()
+    table = tomlkit.table()
+    table["x"] = 9
+    aot.append(table)
+    doc["a"] = aot
+
+    expected: dict[str, Any] = {"a": [{"x": 9}], "other": {"y": 3}}
+    if sibling:
+        expected["c"] = {"d": 2} if sibling.startswith("c.d") else 2
+    assert doc == expected
+    assert parse(tomlkit.dumps(doc)) == expected
+    assert "[[a]]\n" in tomlkit.dumps(doc)
+
+
 def test_replace_value_with_table_keeps_following_dotted_sibling() -> None:
     # A plain value turning into a table must likewise clear the inline region
     # (including dotted keys) before emitting its header.
