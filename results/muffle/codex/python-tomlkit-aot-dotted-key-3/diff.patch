+@pytest.mark.parametrize("prefix", ["", "[parent]\n"])
+@pytest.mark.parametrize("sibling", ["c.d = 2\n", "c = 2\n"])
+def test_replace_dotted_key_with_aot_keeps_following_sibling(
+    prefix: str, sibling: str
+) -> None:
+    doc = parse(prefix + "a.b = 1\n" + sibling)
+    container = doc["parent"] if prefix else doc
+    aot = tomlkit.aot()
+    table = tomlkit.table()
+    table["x"] = 9
+    aot.append(table)
+    container["a"] = aot
+
+    expected = {"c": {"d": 2} if "c.d" in sibling else 2, "a": [{"x": 9}]}
+    assert parse(tomlkit.dumps(doc)) == ({"parent": expected} if prefix else expected)
+    header = "[[parent.a]]" if prefix else "[[a]]"
+    assert tomlkit.dumps(doc).index(sibling) < tomlkit.dumps(doc).index(header)
+
+
 def test_replace_value_with_table_keeps_following_dotted_sibling() -> None:
