     assert parse(doc.as_string()) == {"c": {"d": 2}, "a": {"x": 9}}
 
 
+@pytest.mark.parametrize(
+    "content",
+    [
+        "a.b = 1\nc.d = 2\n",
+        "a.b = 1\nc = 2\n",
+        "a.b = 1\nc.d = 2\n\n[other]\ny = 3\n",
+    ],
+)
+def test_replace_dotted_key_with_aot_keeps_following_sibling(content: str) -> None:
+    doc = parse(content)
+    expected = doc.unwrap()
+    expected["a"] = [{"x": 9}]
+    aot = tomlkit.aot()
+    table = tomlkit.table()
+    table["x"] = 9
+    aot.append(table)
+
+    doc["a"] = aot
+
+    assert doc.unwrap() == expected
+    assert parse(tomlkit.dumps(doc)).unwrap() == expected
+
+
 def test_replace_value_with_table_keeps_following_dotted_sibling() -> None:
