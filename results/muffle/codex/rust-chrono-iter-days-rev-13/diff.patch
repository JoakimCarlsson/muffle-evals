@@ -730,20 +730,68 @@ fn test_date_parse_from_str() {
 
 #[test]
 fn test_day_iterator_limit() {
-    assert_eq!(NaiveDate::from_ymd_opt(MAX_YEAR, 12, 29).unwrap().iter_days().take(4).count(), 2);
-    assert_eq!(
-        NaiveDate::from_ymd_opt(MIN_YEAR, 1, 3).unwrap().iter_days().rev().take(4).count(),
-        2
-    );
+    let start = NaiveDate::from_ymd_opt(MAX_YEAR, 12, 29).unwrap();
+    assert_eq!(start.iter_days().count(), 2);
+    assert_eq!(start.iter_days().next_back(), NaiveDate::MAX.pred_opt());
+    assert_eq!(NaiveDate::MAX.iter_days().next(), None);
+    assert_eq!(NaiveDate::MAX.iter_days().next_back(), None);
 }
 
 #[test]
 fn test_week_iterator_limit() {
-    assert_eq!(NaiveDate::from_ymd_opt(MAX_YEAR, 12, 12).unwrap().iter_weeks().take(4).count(), 2);
-    assert_eq!(
-        NaiveDate::from_ymd_opt(MIN_YEAR, 1, 15).unwrap().iter_weeks().rev().take(4).count(),
-        2
-    );
+    let start = NaiveDate::from_ymd_opt(MAX_YEAR, 12, 12).unwrap();
+    assert_eq!(start.iter_weeks().count(), 2);
+    assert_eq!(start.iter_weeks().next_back(), start.checked_add_days(Days::new(7)));
+    for offset in 0..7 {
+        let start = NaiveDate::MAX.checked_sub_days(Days::new(offset)).unwrap();
+        assert_eq!(start.iter_weeks().next(), None);
+        assert_eq!(start.iter_weeks().next_back(), None);
+    }
+}
+
+#[test]
+fn test_date_iterators_double_ended() {
+    fn check(iter: impl DoubleEndedIterator<Item = NaiveDate> + ExactSizeIterator + Clone) {
+        let expected: Vec<_> = iter.clone().collect();
+        assert_eq!(iter.len(), expected.len());
+        assert_eq!(
+            iter.clone().rev().collect::<Vec<_>>(),
+            expected.iter().rev().copied().collect::<Vec<_>>()
+        );
+
+        let mut mixed = iter.clone();
+        let (mut front, mut back) = (0, expected.len());
+        while front < back {
+            assert_eq!(mixed.len(), back - front);
+            assert_eq!(mixed.next(), Some(expected[front]));
+            front += 1;
+            if front < back {
+                back -= 1;
+                assert_eq!(mixed.next_back(), Some(expected[back]));
+            }
+        }
+        assert_eq!(mixed.size_hint(), (0, Some(0)));
+        assert_eq!(mixed.next(), None);
+        assert_eq!(mixed.next_back(), None);
+
+        for n in [0, 1, expected.len(), usize::MAX] {
+            let mut skipped = iter.clone();
+            let expected_back = expected.len().checked_sub(n).and_then(|len| len.checked_sub(1));
+            assert_eq!(skipped.nth_back(n), expected_back.map(|i| expected[i]));
+            assert_eq!(skipped.len(), expected_back.unwrap_or(0));
+        }
+    }
+
+    let start = NaiveDate::from_ymd_opt(2025, 10, 10).unwrap();
+    check(start.iter_days().take(7));
+    check(start.iter_weeks().take(7));
+    for offset in 0..30 {
+        let start = NaiveDate::MAX.checked_sub_days(Days::new(offset)).unwrap();
+        check(start.iter_days());
+        check(start.iter_weeks());
+    }
+    check(NaiveDate::MIN.iter_days().take(7));
+    check(NaiveDate::MIN.iter_weeks().take(7));
 }
 
 #[test]
