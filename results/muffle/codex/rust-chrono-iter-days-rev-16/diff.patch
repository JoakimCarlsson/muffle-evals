@@ -729,21 +729,82 @@ fn test_date_parse_from_str() {
 }
 
 #[test]
-fn test_day_iterator_limit() {
-    assert_eq!(NaiveDate::from_ymd_opt(MAX_YEAR, 12, 29).unwrap().iter_days().take(4).count(), 2);
-    assert_eq!(
-        NaiveDate::from_ymd_opt(MIN_YEAR, 1, 3).unwrap().iter_days().rev().take(4).count(),
-        2
-    );
+fn test_date_iterators_reverse() {
+    fn check(iter: impl DoubleEndedIterator<Item = NaiveDate> + ExactSizeIterator + Clone) {
+        let mut expected: Vec<_> = iter.clone().take(7).collect();
+        expected.reverse();
+        let reversed: Vec<_> = iter.take(7).rev().collect();
+        assert_eq!(expected, reversed);
+    }
+    let start = NaiveDate::from_ymd_opt(2025, 10, 10).unwrap();
+    check(start.iter_days());
+    check(start.iter_weeks());
 }
 
 #[test]
-fn test_week_iterator_limit() {
-    assert_eq!(NaiveDate::from_ymd_opt(MAX_YEAR, 12, 12).unwrap().iter_weeks().take(4).count(), 2);
-    assert_eq!(
-        NaiveDate::from_ymd_opt(MIN_YEAR, 1, 15).unwrap().iter_weeks().rev().take(4).count(),
-        2
-    );
+fn test_date_iterator_limits() {
+    fn check(
+        mut iter: impl DoubleEndedIterator<Item = NaiveDate> + ExactSizeIterator,
+        expected: &[NaiveDate],
+    ) {
+        assert_eq!(iter.len(), expected.len());
+        for (index, date) in expected.iter().enumerate() {
+            assert_eq!(iter.next(), Some(*date));
+            assert_eq!(iter.len(), expected.len() - index - 1);
+        }
+        assert_eq!(iter.next(), None);
+        assert_eq!(iter.next_back(), None);
+        assert_eq!(iter.next(), None);
+    }
+    for step in [1, 7] {
+        for offset in 0..=22 {
+            let start = NaiveDate::MAX.checked_sub_days(Days::new(offset)).unwrap();
+            let expected: Vec<_> = (0..offset / step)
+                .map(|i| start.checked_add_days(Days::new(i * step)).unwrap())
+                .collect();
+            if step == 1 {
+                check(start.iter_days(), &expected);
+                let mut reversed = expected.clone();
+                reversed.reverse();
+                check(start.iter_days().rev(), &reversed);
+            } else {
+                check(start.iter_weeks(), &expected);
+                let mut reversed = expected.clone();
+                reversed.reverse();
+                check(start.iter_weeks().rev(), &reversed);
+            }
+        }
+    }
+}
+
+#[test]
+fn test_date_iterators_mixed_ends() {
+    fn check(
+        mut iter: impl DoubleEndedIterator<Item = NaiveDate> + ExactSizeIterator,
+        step: u64,
+        mut front: NaiveDate,
+    ) {
+        let len = iter.len();
+        let mut back = front.checked_add_days(Days::new((len as u64 - 1) * step)).unwrap();
+        for remaining in (0..len).rev() {
+            if remaining % 2 == 0 {
+                assert_eq!(iter.next(), Some(front));
+                front = front.checked_add_days(Days::new(step)).unwrap();
+            } else {
+                assert_eq!(iter.next_back(), Some(back));
+                back = back.checked_sub_days(Days::new(step)).unwrap();
+            }
+            assert_eq!(iter.len(), remaining);
+        }
+        assert_eq!(iter.next(), None);
+        assert_eq!(iter.next_back(), None);
+    }
+    check(NaiveDate::MIN.iter_days().take(8), 1, NaiveDate::MIN);
+    check(NaiveDate::MIN.iter_weeks().take(8), 7, NaiveDate::MIN);
+    let start = NaiveDate::MAX.checked_sub_days(Days::new(8)).unwrap();
+    check(start.iter_days(), 1, start);
+    let start = NaiveDate::MAX.checked_sub_days(Days::new(56)).unwrap();
+    check(start.iter_weeks(), 7, start);
 }
 
 #[test]
