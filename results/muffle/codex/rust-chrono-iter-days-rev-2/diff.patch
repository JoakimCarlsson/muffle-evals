diff --git a/src/naive/date/tests.rs b/src/naive/date/tests.rs
index 0b47ca4..9a2ea8c 100644
--- a/src/naive/date/tests.rs
+++ b/src/naive/date/tests.rs
@@ -730,20 +730,71 @@ fn test_date_parse_from_str() {
 
 #[test]
 fn test_day_iterator_limit() {
-    assert_eq!(NaiveDate::from_ymd_opt(MAX_YEAR, 12, 29).unwrap().iter_days().take(4).count(), 2);
-    assert_eq!(
-        NaiveDate::from_ymd_opt(MIN_YEAR, 1, 3).unwrap().iter_days().rev().take(4).count(),
-        2
-    );
+    let start = NaiveDate::from_ymd_opt(MAX_YEAR, 12, 29).unwrap();
+    assert_eq!(start.iter_days().count(), 3);
+    assert_eq!(start.iter_days().next_back(), Some(NaiveDate::MAX));
+    check_date_iterator(start.iter_days(), 3);
+    check_date_iterator(NaiveDate::MAX.iter_days(), 1);
+    assert_eq!(NaiveDate::MIN.iter_days().next(), Some(NaiveDate::MIN));
 }
 
 #[test]
 fn test_week_iterator_limit() {
-    assert_eq!(NaiveDate::from_ymd_opt(MAX_YEAR, 12, 12).unwrap().iter_weeks().take(4).count(), 2);
-    assert_eq!(
-        NaiveDate::from_ymd_opt(MIN_YEAR, 1, 15).unwrap().iter_weeks().rev().take(4).count(),
-        2
-    );
+    // Exercise every possible weekday alignment with MAX.
+    for days in 0..21 {
+        let start = NaiveDate::MAX.checked_sub_days(Days::new(days)).unwrap();
+        let mut iter = start.iter_weeks();
+        let last = iter.next_back().unwrap();
+        assert_eq!(last.weekday(), start.weekday());
+        assert!(NaiveDate::MAX.signed_duration_since(last).num_days() < 7);
+        check_date_iterator(start.iter_weeks(), days as usize / 7 + 1);
+    }
+    assert_eq!(NaiveDate::MIN.iter_weeks().next(), Some(NaiveDate::MIN));
+}
+
+// Check that both ends consume the same range, including when they meet.
+fn check_date_iterator<I>(iter: I, len: usize)
+where
+    I: DoubleEndedIterator<Item = NaiveDate> + ExactSizeIterator + Clone,
+{
+    let expected: Vec<_> = iter.clone().collect();
+    assert_eq!(expected.len(), len);
+    let mut reversed = expected.clone();
+    reversed.reverse();
+    assert_eq!(iter.clone().rev().collect::<Vec<_>>(), reversed);
+
+    for front_count in 0..=len {
+        let mut mixed = iter.clone();
+        for (index, date) in expected.iter().take(front_count).enumerate() {
+            assert_eq!(mixed.len(), len - index);
+            assert_eq!(mixed.next(), Some(*date));
+        }
+        for date in expected[front_count..].iter().rev() {
+            let remaining = mixed.len();
+            assert_eq!(mixed.size_hint(), (remaining, Some(remaining)));
+            assert_eq!(mixed.next_back(), Some(*date));
+            assert_eq!(mixed.len(), remaining - 1);
+        }
+        assert_eq!(mixed.size_hint(), (0, Some(0)));
+        assert_eq!(mixed.next(), None);
+        assert_eq!(mixed.next_back(), None);
+        assert_eq!(mixed.next(), None);
+        assert_eq!(mixed.next_back(), None);
+    }
+}
+
+#[test]
+fn test_date_iterator_reverse_window() {
+    let start = NaiveDate::from_ymd_opt(2025, 10, 10).unwrap();
+    check_date_iterator(start.iter_days().take(7), 7);
+    check_date_iterator(start.iter_weeks().take(7), 7);
+
+    let mut days = start.iter_days();
+    assert_eq!(days.len(), NaiveDate::MAX.signed_duration_since(start).num_days() as usize + 1);
+    assert_eq!(days.next_back(), Some(NaiveDate::MAX));
+    assert_eq!(days.next(), Some(start));
+    assert_eq!(days.next_back(), NaiveDate::MAX.pred_opt());
+    assert_eq!(days.next(), start.succ_opt());
 }
 
 #[test]
