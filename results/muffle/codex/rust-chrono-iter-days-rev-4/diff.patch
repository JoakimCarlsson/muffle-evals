@@ -730,20 +730,60 @@ fn test_date_parse_from_str() {
 
 #[test]
 fn test_day_iterator_limit() {
-    assert_eq!(NaiveDate::from_ymd_opt(MAX_YEAR, 12, 29).unwrap().iter_days().take(4).count(), 2);
-    assert_eq!(
-        NaiveDate::from_ymd_opt(MIN_YEAR, 1, 3).unwrap().iter_days().rev().take(4).count(),
-        2
-    );
+    let start = NaiveDate::MAX - Days::new(2);
+    let mut iter = start.iter_days();
+    assert_eq!(iter.len(), 2);
+    assert_eq!(iter.next_back(), Some(NaiveDate::MAX - Days::new(1)));
+    assert_eq!(iter.len(), 1);
+    assert_eq!(iter.next(), Some(start));
+    assert_eq!(iter.len(), 0);
+    assert_eq!(iter.next_back(), None);
+    assert_eq!(iter.next(), None);
+    assert_eq!(NaiveDate::MAX.iter_days().next_back(), None);
 }
 
 #[test]
 fn test_week_iterator_limit() {
-    assert_eq!(NaiveDate::from_ymd_opt(MAX_YEAR, 12, 12).unwrap().iter_weeks().take(4).count(), 2);
-    assert_eq!(
-        NaiveDate::from_ymd_opt(MIN_YEAR, 1, 15).unwrap().iter_weeks().rev().take(4).count(),
-        2
-    );
+    // Exercise every possible remainder at the upper limit.
+    for remainder in 0..7 {
+        let start = NaiveDate::MAX - Days::new(14 + remainder);
+        let mut iter = start.iter_weeks();
+        assert_eq!(iter.len(), 2);
+        assert_eq!(iter.next_back(), Some(start + Days::new(7)));
+        assert_eq!(iter.len(), 1);
+        assert_eq!(iter.next(), Some(start));
+        assert_eq!(iter.len(), 0);
+        assert_eq!(iter.next(), None);
+        assert_eq!(iter.next_back(), None);
+        assert_eq!((NaiveDate::MAX - Days::new(remainder)).iter_weeks().next_back(), None);
+    }
+}
+
+#[test]
+fn test_date_iterator_reverse_windows() {
+    for start in [
+        NaiveDate::MIN,
+        NaiveDate::from_ymd_opt(2025, 10, 10).unwrap(),
+        NaiveDate::MAX - Days::new(50),
+    ] {
+        for count in 0..10 {
+            let days = start.iter_days().take(count);
+            assert!(
+                days.clone().rev().eq((0..days.len()).rev().map(|i| start + Days::new(i as u64)))
+            );
+            let weeks = start.iter_weeks().take(count);
+            assert!(
+                weeks
+                    .clone()
+                    .rev()
+                    .eq((0..weeks.len()).rev().map(|i| start + Days::new(i as u64 * 7)))
+            );
+        }
+        let mut days = start.iter_days();
+        assert_eq!(days.next(), Some(start));
+        assert_eq!(days.next_back(), Some(NaiveDate::MAX - Days::new(1)));
+        assert_eq!(days.next(), Some(start + Days::new(1)));
+    }
 }
 
 #[test]
