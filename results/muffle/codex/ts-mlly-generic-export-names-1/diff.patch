+function _isGenericCall(code: string, start: number): boolean {
+  let depth = 0;
+  let quote = "";
+  for (let i = start; i < code.length; i++) {
+    const char = code[i];
+    if (quote) {
+      if (char === "\\") {
+        i++;
+      } else if (char === quote) {
+        quote = "";
+      }
+      continue;
+    }
+    if (char === '"' || char === "'" || char === "`") {
