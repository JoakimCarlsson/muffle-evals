+`
+    expect(YAML.parse(src, { mapAsMap: true })).toEqual(
+      new Map([
+        [['Detroit Tigers', 'Chicago cubs'], ['2001-07-23']],
+        [
+          ['New York Yankees', 'Atlanta Braves'],
+          ['2001-07-02', '2001-08-12', '2001-08-14']
+        ]
+      ])
+    )
+  })
+})
