+class TestScan(unittest.TestCase):
+    EXPR = r"""
+        start: expr+
+        expr: "(" (LET | expr) ")"
+        LET: /[a-z]/
+        %ignore " "
+    """
+
+    def test_ranges(self):
+        for lexer in ('contextual', 'basic'):
+            p = Lark(self.EXPR, parser='lalr', lexer=lexer)
+            self.assertEqual([m.range for m in p.scan('(a)(b) || (c)(d(e)')], [(0, 6), (10, 13), (15, 18)])
+            pb = Lark(self.EXPR, parser='lalr', lexer=lexer, use_bytes=True)
+            self.assertEqual([m.range for m in pb.scan(b'(a) (b)')], [(0, 7)])
+            self.assertEqual([m.range for m in p.scan(TextSlice('(a)(b)(c)', 3, 6))], [(3, 6)])
+        m = next(iter(Lark('start: expr\nexpr: "a"', parser='lalr').scan('a')))
+        self.assertEqual(m, ScanMatch((0, 1), Tree('start', [Tree('expr', [])])))
+
+    def test_matches_parse(self):
+        g = 'start: "a" ["b"] "c"\n%ignore " "'
+        for opts in ({}, {'keep_all_tokens': True}, {'maybe_placeholders': False}, {'propagate_positions': True}):
+            p = Lark(g, parser='lalr', **opts)
+            m, = p.scan('xx\nac  ')
+            self.assertEqual(m.range, (3, 5))
+            self.assertEqual(m.value, p.parse('ac'))
+        m, = p.scan('xx\n a c')
+        self.assertEqual((m.value.meta.line, m.value.meta.column, m.value.meta.end_column), (2, 2, 5))
+
+    def test_nullable_and_empty(self):
+        p = Lark('start: "a"*', parser='lalr')
+        self.assertEqual([m.range for m in p.scan('baab a')], [(1, 3), (5, 6)])
+        self.assertEqual(list(Lark('start: "a"?', parser='lalr').scan('bb')), [])
+
+    def test_ignore_hiding_start(self):
+        p = Lark('start: "ab" "c"\n%ignore /ab\\s/\n%ignore " "', parser='lalr')
+        self.assertEqual([m.range for m in p.scan('xab c ab c')], [(1, 5), (6, 10)])
+
+    def test_basic_keywords(self):
+        p = Lark('start: "if" NAME\nNAME: /[a-z]+/\n%ignore " "', parser='lalr', lexer='basic')
+        m, = p.scan('zz if foo')
+        self.assertEqual((m.range, m.value.children), ((3, 9), ['foo']))
+
+    def test_start(self):
+        p = Lark('start: "a"\nother: "b"', parser='lalr', start=['start', 'other'])
+        self.assertRaises(ConfigurationError, p.scan, 'a')
+        self.assertEqual([m.range for m in p.scan('abb', start='other')], [(1, 2), (2, 3)])
+
+    def test_configuration_errors(self):
+        self.assertRaises(ConfigurationError, Lark('start: "a"', parser='earley').scan, 'a')
+
+        class PostLex:
+            always_accept = ()
+
+            def process(self, stream):
+                return stream
+        p = Lark('start: "a"', parser='lalr', postlex=PostLex())
+        with self.assertRaisesRegex(ConfigurationError, 'postlex'):
+            p.scan('a')
+
+        class CustomLexer(Lexer):
+            def __init__(self, conf):
+                pass
+
+            def lex(self, text):
+                return iter(())
+        self.assertRaises(ConfigurationError, Lark('start: "a"', parser='lalr', lexer=CustomLexer).scan, 'a')
+
+    def test_callbacks(self):
+        def cb(t):
+            if t.value == 'b':
+                raise ValueError
+            return t
+        p = Lark('start: W+\nW: /[a-z]/\n%ignore " "', parser='lalr', lexer_callbacks={'W': cb})
+        self.assertEqual([m.range for m in p.scan('a b c')], [(0, 1), (4, 5)])
+
+        def lose_positions(t):
+            return Token(t.type, t.value)
+        p = Lark('start: W+\nW: /[a-z]+/\n%ignore " "', parser='lalr', lexer_callbacks={'W': lose_positions})
+        for text in ('a b', 'a'):
+            with self.assertRaisesRegex(LexError, 'did not preserve token positions'):
+                list(p.scan(text))
+
+        def config_error(t):
+            raise ConfigurationError('x')
+        p = Lark('start: W+\nW: /[a-z]+/', parser='lalr', lexer_callbacks={'W': config_error})
+        self.assertRaises(ConfigurationError, list, p.scan('a'))
+
+    def test_transformer_not_copied(self):
+        class NoCopy:
+            def __deepcopy__(self, memo):
+                raise RuntimeError
+        calls = []
+
+        class T(Transformer):
+            def start(self, children):
+                calls.append(children)
+                return NoCopy()
+        p = Lark('start: "a"+', parser='lalr', transformer=T())
+        m, = p.scan('xaa')
+        self.assertIsInstance(m.value, NoCopy)
+        self.assertEqual(len(calls), 1)
+
+    def test_token_copy_keeps_end(self):
+        t = Token('A', 'x', 1, 2, 3, 4, 5, 6)
+        for c in (deepcopy(t), pickle.loads(pickle.dumps(t))):
+            self.assertEqual((c.start_pos, c.end_line, c.end_column, c.end_pos), (1, 4, 5, 6))
+
