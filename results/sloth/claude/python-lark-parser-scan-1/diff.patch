+    def _scan_lexer(self, start: str) -> BasicLexer:
+        """The lexer for the first token of a match: same terminals as the lexer would accept there, minus %ignore"""
+        if start not in self._scan_lexers:
+            conf = copy(self.lexer_conf)
+            table = self.parser._parse_table
+            accepted = table.states[table.start_states[start]]
+            contextual = self.lexer_conf.lexer_type == 'contextual'
+            conf.terminals = [t for t in conf.terminals
+                              if t.name not in conf.ignore and (not contextual or t.name in accepted)]
+            conf.ignore = ()
+            conf.skip_validation = True
+            self._scan_lexers[start] = create_basic_lexer(conf, self.parser, None, self.options)
+        return self._scan_lexers[start]
+
+    def _scan_candidate(self, text: TextSlice, line_ctr: LineCounter, parse_conf: ParseConf, first_lexer: BasicLexer) -> list:
+        """The tokens of the longest prefix of text, from line_ctr's position, that is accepted by the parser"""
+        lex_state = LexerState(text, copy(line_ctr))
+        state = ParserState(parse_conf, None)   # type: ignore[arg-type]
+        end_of_input = Token('$END', '')
+        tokens: list = []
+        accepted = 0
+
+        def stream():
+            yield first_lexer.next_token(lex_state, state)
+            yield from self.lexer.lex(lex_state, state)
+
+        try:
+            for token in stream():
+                if token.start_pos is None or token.end_pos is None:
+                    raise LexError("Lexer callback for %s returned a token that did not preserve token positions "
+                                   "(use Token.update() instead of creating a new Token)" % token.type)
+                state.feed_token(token)
+                tokens.append(token)
+                if '$END' in parse_conf.states[state.position]:
+                    try:
+                        state.copy(deepcopy_values=False).feed_token(end_of_input, True)
+                    except UnexpectedInput:
+                        continue
+                    accepted = len(tokens)
+        except UnexpectedInput:
+            pass
+        except ValueError as e:
+            if isinstance(e, ConfigurationError):
+                raise
+        return tokens[:accepted]
+
+    def _scan_matches(self, text: TextSlice, start: str):
+        parse_conf = ParseConf(self.parser._parse_table, _SearchCallbacks(), start)
+        first_lexer = self._scan_lexer(start)
+        line_ctr = LineCounter(b'\n' if isinstance(text.text, bytes) else '\n')
+        line_ctr.feed(text.text[:text.start])
+        pos = text.start
+        while pos < text.end:
+            if first_lexer.match(text, pos) is None:
+                pos += 1
+                continue
+            line_ctr.feed(text.text[line_ctr.char_pos:pos])
+            tokens = self._scan_candidate(text, line_ctr, parse_conf, first_lexer)
+            if not tokens:
+                pos += 1
+                continue
+            pos = tokens[-1].end_pos
+            yield ScanMatch((tokens[0].start_pos, pos), self.parser.parser.parse(_TokenStream(tokens), start))
+
+    def scan(self, text: TextOrSlice, start=None):
+        """Find the non-overlapping matches of the grammar inside text (LALR only). See Lark.scan()"""
+        if self.lexer_conf.postlex is not None:
+            raise ConfigurationError("scan() doesn't support postlex")
+        if isinstance(self.lexer_conf.lexer_type, type):
+            raise ConfigurationError("scan() doesn't support custom lexers")
+        return self._scan_matches(TextSlice.cast_from(text), self._verify_start(start))
+
 
