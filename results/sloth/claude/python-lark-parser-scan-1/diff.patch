+    def scan(self, text: TextOrSlice, start: Optional[str]=None) -> 'Iterator[ScanMatch[_Return_T]]':
+        """Find the matches of the grammar inside text, like a regexp search. Only works when parser='lalr'.
+
+        Each match is the longest prefix that parses, from the earliest position where one starts.
+        Matches never overlap, are never empty, and never start or end with an ignored terminal.
+        Text that doesn't parse is skipped.
+
+        Parameters:
+            text (TextOrSlice): Text to scan, as `str`, `bytes` or `TextSlice`.
+                For a TextSlice, only the slice is scanned, but positions are relative to the whole text.
+            start (str, optional): Required if Lark was given multiple possible start symbols (using the start option).
+
+        Returns:
+            An iterator of ``ScanMatch(range=(start, end), value=...)``, where value is what ``parse()``
+            returns for the matched text.
+
+        :raises ConfigurationError: (when called) If the parser is not lalr, or a postlex or a custom lexer is used.
+        """
+        if self.options.parser != 'lalr':
+            raise ConfigurationError("scan() only works with parser='lalr'")
+        return self.parser.scan(text, start)
