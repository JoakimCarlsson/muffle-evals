+    def scan(self, text, start=None):
+        """Validate scanning configuration before returning the match iterator."""
+        if self.parser_conf.parser_type != 'lalr':
+            raise ConfigurationError("scan() requires parser='lalr'")
+        if self.lexer_conf.postlex is not None:
+            raise ConfigurationError("scan() does not support postlex")
+        if self.lexer_conf.lexer_type not in ('basic', 'contextual'):
+            raise ConfigurationError("scan() does not support custom lexers")
+        return self._scan(TextSlice.cast_from(text), self._verify_start(start))
+
+    def _scan(self, text, start):
+        """Find accepting prefixes without evaluating speculative parser values."""
+        callback_errors = []
+
+        def checked_callback(callback):
+            """Keep callback failures distinct from lexer search failures."""
+            def call(token):
+                """Call the user's callback without losing its exception."""
+                try:
+                    return callback(token)
+                except Exception as error:
+                    callback_errors.append(error)
+                    raise
+            return call
+
+        lexer_conf = copy(self.lexer_conf)
+        lexer_conf.callbacks = {name: checked_callback(callback)
+                                for name, callback in lexer_conf.callbacks.items()}
+        create_lexer = create_contextual_lexer if lexer_conf.lexer_type == 'contextual' else create_basic_lexer
+        lexer = create_lexer(lexer_conf, self.parser, None, self.options)
+        initial = self.parser.parse_interactive(LexerThread(lexer, None), start)
+        first_lexer = copy(lexer.lexers[initial.parser_state.position]
+                           if isinstance(lexer, ContextualLexer) else lexer)
+        first_lexer.terminals = [t for t in first_lexer.terminals if t.name not in first_lexer.ignore_types]
+        first_lexer.ignore_types = frozenset()
+        first_lexer._scanner = None
+        pos = text.start
+        while pos < text.end:
+            cursor = self.parser.parse_interactive(
+                LexerThread.from_text(lexer, TextSlice(text.text, pos, text.end)), start)
+            conf = copy(cursor.parser_state.parse_conf)
+            conf.callbacks = {}
+            cursor.parser_state.parse_conf = conf
+            tokens = []
+            accepted = 0
+            stream = cursor.lexer_thread.lex(cursor.parser_state)
+            while True:
+                callback_errors.clear()
+                try:
+                    token = (next(stream) if tokens else
+                             first_lexer.next_token(cursor.lexer_thread.state, cursor.parser_state))
+                except (StopIteration, EOFError, UnexpectedInput, ValueError):
+                    if callback_errors:
+                        error = callback_errors[-1]
+                        if not isinstance(error, ValueError) or isinstance(error, ConfigurationError):
+                            raise
+                    break
+                if any(getattr(token, name) is None for name in
+                       ('start_pos', 'line', 'column', 'end_pos', 'end_line', 'end_column')):
+                    raise LexError("Lexer callback did not preserve token positions")
+                if not tokens and token.start_pos != pos:
+                    break
+                try:
+                    cursor.feed_token(token)
+                except UnexpectedInput:
+                    break
+                tokens.append(token)
+                probe = cursor.copy(deepcopy_values=False)
+                try:
+                    probe.feed_eof(token)
+                except UnexpectedInput:
+                    pass
+                else:
+                    accepted = len(tokens)
+            if accepted:
+                result = self.parse_interactive(None, start)
+                for token in tokens[:accepted]:
+                    result.feed_token(token)
+                end = tokens[accepted - 1].end_pos
+                yield ScanMatch((pos, end), result.feed_eof(tokens[accepted - 1]))
+                pos = end
+            else:
+                pos += 1
