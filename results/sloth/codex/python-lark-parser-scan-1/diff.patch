+class TestScan(unittest.TestCase):
+    def test_longest_and_adjacent(self):
+        """Scan earliest complete prefixes, recovering inside incomplete expressions."""
+        from lark import ScanMatch
+        grammar = 'start: expr+\nexpr: "(" /[a-z]/ ")"'
+        text = '(a)(b) || (c)(d(e)'
+        for lexer in ('basic', 'contextual'):
+            p = Lark(grammar, parser='lalr', lexer=lexer)
+            self.assertEqual(list(p.scan(text)), [
+                ScanMatch((a, b), p.parse(text[a:b]))
+                for a, b in [(0, 6), (10, 13), (15, 18)]])
+            p = Lark('start: "a" "b"', parser='lalr', lexer=lexer)
+            self.assertEqual([m.range for m in p.scan('abab')], [(0, 2), (2, 4)])
+
+    def test_nullable(self):
+        """Nullable grammars never yield empty matches or loop."""
+        for grammar, expected in [('start: "a"*', [(1, 3)]), ('start:', [])]:
+            p = Lark(grammar, parser='lalr')
+            self.assertEqual([m.range for m in p.scan('xaa!')], expected)
+            self.assertEqual(list(p.scan('')), [])
+
+    def test_ignored_and_folded_keywords(self):
+        """Ignore spans cannot conceal starts, including embedded keywords."""
+        for lexer in ('basic', 'contextual'):
+            p = Lark('start: "if" | NAME "!"\nNAME: /[a-z]+/\n%ignore /[^\\n]+/',
+                     parser='lalr', lexer=lexer, keep_all_tokens=True)
+            matches = list(p.scan('xx if yy'))
+            self.assertEqual([m.range for m in matches], [(3, 5)])
+            self.assertEqual(matches[0].value.children[0].type, 'IF')
+            p = Lark('start: "a"+\n%ignore " "', parser='lalr', lexer=lexer)
+            self.assertEqual([m.range for m in p.scan('  a a  ! a ')], [(2, 5), (9, 10)])
+
+    def test_slices_bytes_and_options(self):
