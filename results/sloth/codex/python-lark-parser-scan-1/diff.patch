+    def test_callbacks_and_transformer(self):
+        """Returned values use only accepted tokens without copying transformed values."""
+        class Value:
+            """A transformer value which cannot be deep-copied."""
+            def __deepcopy__(self, memo):
+                """Reject copying."""
+                raise AssertionError('no copies')
+
+        class Transform(Transformer):
+            """Collect token values in non-copyable objects."""
+            def part(self, children):
+                """Build a non-copyable child."""
+                value = Value()
+                value.text = str(children[0])
+                return value
+
+            def start(self, children):
+                """Expose accepted children."""
+                return [v.text for v in children]
+
+        def callback(t):
+            """Reject x and replace accepted token values."""
+            if t == 'x':
+                raise ValueError('invalid')
+            return t.update(value=t.upper())
+
+        p = Lark('start: part+\npart: LETTER\nLETTER: /[a-z]/', parser='lalr',
+                 transformer=Transform(), lexer_callbacks={'LETTER': callback})
+        matches = list(p.scan('abxcd'))
+        self.assertEqual([(m.range, m.value) for m in matches],
+                         [((0, 2), ['A', 'B']), ((3, 5), ['C', 'D'])])
+
+    def test_callback_errors(self):
+        """Callback errors propagate except token rejection via ValueError."""
+        from lark.exceptions import ConfigurationError
+        for exception in (RuntimeError, ConfigurationError, EOFError):
+            def callback(t):
+                """Raise the selected error."""
+                raise exception('callback')
+            p = Lark('start: A\nA: "a"', parser='lalr', lexer_callbacks={'A': callback})
+            with self.assertRaises(exception):
+                list(p.scan('a'))
+        class InvalidTransform(Transformer):
+            """Reject matched values with a transformer exception."""
+            def start(self, children):
+                """Propagate ValueError from a transformer."""
+                raise ValueError('transformer')
+
+        p = Lark('start: "a"', parser='lalr', transformer=InvalidTransform())
